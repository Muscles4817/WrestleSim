@*
    Contracts and offers: every deal the promotion has, what is running out, who is bidding for
    whom, and the offers the player has lodged. The market that used to share this screen is the
    talent table's "The market" view now; this one is about the deals themselves.

    The number a guaranteed deal leads with is what it costs against what they would ask
    today: a wrestler who has got hotter since signing is a bargain until the deal runs out
    (doc 11 §7.1), and that gap is the whole value of having signed them.
*@
@inherits StateComponent

@if (State.Career is not { } career)
{
    <div class="empty">No career open.</div>
}
else
{
    var today = career.CurrentDate;
    var expiring = career.ExpiringWithin(TalentMarket.ExpiryWarningDays).Where(c => c.IsGuaranteed).ToList();
    var theirBids = career.Contracts.Where(c => c.IsGuaranteed)
        .Select(c => (Contract: c, Wrestler: career.FindWrestler(c.WrestlerId)))
        .Where(x => x.Wrestler is not null && career.BestRivalBid(x.Wrestler!) is not null).ToList();
    var myBids = career.Bids.Where(b => b.Bidder == Career.PlayerId).ToList();

    @if (offering is not null)
    {
        <OfferPanel Wrestler="offering" OnClose="() => offering = null" />
    }

    <section class="kpis">
        <div class="kpi">
            <span class="kpi__key">@(career.CanSign ? "Under contract" : "Regulars")</span>
            <span class="kpi__val">@career.Contracts.Count</span>
            <span class="kpi__sub">@(career.CanSign ? $"{Money.Format(career.DailyPayroll)} a day in guarantees" : "Paid by the night when booked")</span>
        </div>
        <div class="kpi">
            <span class="kpi__key">Running out</span>
            <span class="kpi__val @(expiring.Count > 0 ? "gold" : "")">@expiring.Count</span>
            <span class="kpi__sub">within @TalentMarket.ExpiryWarningDays days</span>
        </div>
        <div class="kpi">
            <span class="kpi__key">Rivals bidding for yours</span>
            <span class="kpi__val @(theirBids.Count > 0 ? "grade--poor" : "")">@theirBids.Count</span>
            <span class="kpi__sub">match a bid or lose them at expiry</span>
        </div>
        <div class="kpi">
            <span class="kpi__key">Your lodged offers</span>
            <span class="kpi__val">@myBids.Count</span>
            <span class="kpi__sub">for people signed elsewhere</span>
        </div>
    </section>

    @if (!career.CanSign)
    {
        <div class="notice notice--advice">
            Below television nobody is signed. Your regulars are the people you book most, paid by the night;
            anybody else who is free can be booked at their price. Guaranteed contracts come with television.
        </div>
    }

    <div class="layout mt">
        <div class="layout__main">
            @if (theirBids.Count > 0 || expiring.Count > 0)
            {
                <section class="panel">
                    <div class="panel__title">Needs an answer</div>
                    @foreach (var (c, w) in theirBids)
                    {
                        var who = w!;
                        var bid = career.BestRivalBid(who)!;
                        <div class="need">
                            <span class="need__kind need__kind--urgent">Bid</span>
                            <span class="need__text">@(career.Rival(bid.Bidder)?.Name ?? "A rival") has offered <button class="namelink" @onclick="() => State.OpenProfile(who)">@who.RingName</button> @Money.Format(bid.Annual) a year. Their deal with you ends @c.End!.Value.ToString("d MMM").</span>
                            <button class="btn btn--sm btn--primary need__act" @onclick="() => offering = who">Match it</button>
                        </div>
                    }
                    @foreach (var c in expiring.Where(c => theirBids.All(b => b.Contract != c)))
                    {
                        if (career.FindWrestler(c.WrestlerId) is not { } w) continue;
                        var who = w;
                        <div class="need">
                            <span class="need__kind need__kind--do">Expiring</span>
                            <span class="need__text"><button class="namelink" @onclick="() => State.OpenProfile(who)">@w.RingName</button>'s deal ends @c.End!.Value.ToString("d MMM"). They would ask @Money.Format(career.GuaranteeAsk(w, 3)) a year on three.</span>
                            <button class="btn btn--sm need__act" @onclick="() => offering = who">Re-sign</button>
                        </div>
                    }
                </section>
            }

            <section class="panel">
                <div class="panel__title">Your deals</div>
                @{ var deals = career.Contracts.Select(c => (Contract: c, Wrestler: career.FindWrestler(c.WrestlerId)))
                       .Where(x => x.Wrestler is not null)
                       .OrderBy(x => x.Contract.End ?? DateOnly.MaxValue).ThenByDescending(x => x.Wrestler!.EffectiveOverness).ToList(); }
                @if (deals.Count == 0)
                {
                    <div class="small muted">Nobody yet. Find people in <button class="namelink gold" @onclick="() => State.GoTalent(TalentView.Market)">the market</button>.</div>
                }
                else
                {
                    <div class="table-wrap">
                        <table class="data">
                            <thead>
                                <tr>
                                    <th>Wrestler</th>
                                    <th class="num">Popularity</th>
                                    <th>Deal</th>
                                    @if (career.CanSign) { <th class="num col-wide">Would ask today</th> }
                                    <th><span class="sr-only">Action</span></th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var (c, w) in deals)
                                {
                                    var who = w!;
                                    <tr>
                                        <td><button class="namecell" @onclick="() => State.OpenProfile(who)"><strong>@who.RingName</strong></button></td>
                                        <td class="num @who.CardPosition.Tone()">@who.OvernessDisplay</td>
                                        <td class="small">
                                            @if (c.IsGuaranteed)
                                            {
                                                <text>@Money.Format(c.AnnualGuarantee) a year until @c.End!.Value.ToString("d MMM yyyy")</text>
                                                @if (c.DaysTolled > 0) { <div class="muted">extended @c.DaysTolled days for injury</div> }
                                            }
                                            else
                                            {
                                                <text>Regular, @Money.Format(career.PerDateAsk(who)) a night when booked</text>
                                            }
                                        </td>
                                        @if (career.CanSign)
                                        {
                                            var now = c.IsGuaranteed ? TalentMarket.WorthToday(who, c, career.WageFactor) : 0m;
                                            <td class="num small col-wide @(now > c.AnnualGuarantee ? "grade--great" : now < c.AnnualGuarantee ? "grade--poor" : "")">
                                                @(c.IsGuaranteed ? Money.Format(now) : "—")
                                            </td>
                                        }
                                        <td class="nowrap">
                                            @if (c.IsGuaranteed)
                                            {
                                                var payout = Math.Round(c.DailyCost * Math.Min(TalentMarket.ReleasePayoutDays, c.DaysLeft(today) ?? 0));
                                                <button class="btn btn--sm" @onclick="() => offering = who">Re-sign</button>
                                                <button class="btn btn--sm btn--ghost" @onclick="() => State.ReleaseAsync(who)">Release (@Money.Format(payout))</button>
                                            }
                                            else
                                            {
                                                <button class="btn btn--sm btn--ghost" @onclick="() => State.ReleaseAsync(who)">Drop</button>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                    @if (career.CanSign)
                    {
                        <div class="small muted mt">"Would ask today" in green means they have got hotter since signing: a bargain while the deal lasts. Releasing pays out @TalentMarket.ReleasePayoutDays days and starts a non-compete.</div>
                    }
                }
            </section>
        </div>

        <aside class="layout__side">
            <section class="panel">
                <div class="panel__title">Your lodged offers</div>
                @if (myBids.Count == 0)
                {
                    <div class="small muted">None. You can offer for somebody signed elsewhere in the last @TalentMarket.ExpiryWarningDays days of their deal.</div>
                }
                @foreach (var bid in myBids)
                {
                    if (career.FindWrestler(bid.WrestlerId) is not { } w) continue;
                    var who = w;
                    var holder = career.SignedTo(w);
                    <div class="kv">
                        <span><button class="namelink" @onclick="() => State.OpenProfile(who)">@w.RingName</button><div class="small muted">@(holder is null ? "" : $"decides when {holder.Name}'s deal ends, {holder.ContractOf(w)?.End:d MMM}")</div></span>
                        <span class="tabnum">@Money.Format(bid.Annual) × @bid.Years</span>
                    </div>
                }
            </section>

            <section class="panel">
                <div class="panel__title">Lately</div>
                @if (career.ContractLog.Count == 0)
                {
                    <div class="small muted">Nothing yet.</div>
                }
                @foreach (var e in career.ContractLog.AsEnumerable().Reverse().Take(12))
                {
                    var who = career.FindWrestler(e.WrestlerId);
                    <div class="newsline">
                        <span>@e.Date.ToString("d MMM")</span>
                        <span>
                            @if (who is not null)
                            {
                                <button class="namelink" style="font-weight: 600" @onclick="() => State.OpenProfile(who)">@who.RingName</button>
                            }
                            else { @e.WrestlerId }
                            @(" " + e.What)
                        </span>
                    </div>
                }
            </section>
        </aside>
    </div>
}

@code {
    private Wrestler? offering;
}
