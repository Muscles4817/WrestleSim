@using WrestlingSim.Models.World
@inherits StateComponent
@inject ViewScroll Scroll

@if (State.Career is not { } career)
{
    <div class="empty"><div class="empty__mark"><Icon Name="star" /></div>No career loaded.</div>
}
else
{
    var active = career.ShowDefinitions.Where(d => d.Active).ToList();
    var month = career.Shows.Where(sh => !sh.HasRun && sh.Date >= career.CurrentDate && sh.Date < career.CurrentDate.AddDays(30)).ToList();
    var next = career.Shows.Where(sh => !sh.HasRun && sh.Date >= career.CurrentDate).OrderBy(sh => sh.Date).FirstOrDefault();

    <section class="kpis">
        <div class="kpi">
            <span class="kpi__key">Standing shows</span>
            <span class="kpi__val">@active.Count</span>
            <span class="kpi__sub">@(career.ShowDefinitions.Count - active.Count) retired</span>
        </div>
        <div class="kpi">
            <span class="kpi__key">The next 30 days</span>
            <span class="kpi__val">@month.Count</span>
            <span class="kpi__sub">@month.Sum(sh => sh.RuntimeMinutes).ToString("N0") minutes to fill</span>
        </div>
        <div class="kpi">
            <span class="kpi__key">Next show</span>
            <span class="kpi__val">@(next?.Date.ToString("d MMM") ?? "—")</span>
            <span class="kpi__sub">@(next?.Name ?? "Nothing scheduled")</span>
        </div>
        @{ var unbooked = career.Shows.Count(sh => !sh.HasRun && sh.Date >= career.CurrentDate && sh.Date < career.CurrentDate.AddDays(14) && sh.Card.Count == 0); }
        <div class="kpi">
            <span class="kpi__key">Not booked yet</span>
            <span class="kpi__val @(unbooked > 0 ? "gold" : "")">@unbooked</span>
            <span class="kpi__sub">in the next two weeks</span>
        </div>
    </section>

    <div class="layout">
        <div class="layout__main">
            @if (adding is { } draft)
            {
                <section class="panel" id="new-show">
                    <div class="panel__title">A new show <span class="spacer"></span><span class="small muted">nothing is added until you save it</span></div>
                    <ShowDefinitionEditor Definition="draft" Promotion="career.Promotion" OnChanged="StateHasChanged" />
                    @if (ClashOf(career, draft) is { } clash)
                    {
                        <div class="notice notice--warn mt">Lands on the same night as <strong>@clash.Name</strong>. Two of your shows on one night split the same roster and the same crowd.</div>
                    }
                    <div class="row mt">
                        <span class="small muted">Saving puts its dates on the calendar from today.</span>
                        <span class="spacer"></span>
                        <button class="btn btn--sm btn--ghost" @onclick="() => adding = null">Cancel</button>
                        <button class="btn btn--sm btn--primary" @onclick="SaveNew">Add it</button>
                    </div>
                </section>
            }

            <section class="panel">
                <div class="panel__title">Standing shows <span class="spacer"></span><span class="small muted">each one fills the calendar forward from today</span></div>

                @if (career.ShowDefinitions.Count == 0)
                {
                    <div class="empty">
                        <div class="empty__mark"><Icon Name="clock" /></div>
                        No standing shows. Add one and it will fill the calendar forward from today.
                    </div>
                }
                else
                {
                    <div class="table-wrap">
                        <table class="data">
                            <thead>
                                <tr>
                                    <th>Show</th>
                                    <th class="col-wide">When</th>
                                    <th class="num col-wide">Length</th>
                                    @if (career.Brands.Active) { <th class="col-wide">Brand</th> }
                                    <th class="col-wide">Next</th>
                                    <th class="num col-wide">On the calendar</th>
                                    <th class="col-wide"><span class="sr-only">Actions</span></th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var definition in career.ShowDefinitions)
                                {
                                    var upcoming = career.Shows.Where(sh => sh.DefinitionId == definition.Id && !sh.HasRun && sh.Date >= career.CurrentDate)
                                                               .OrderBy(sh => sh.Date).ToList();
                                    <tr class="@(definition.Active ? "" : "is-muted")">
                                        <td>
                                            <strong>@(string.IsNullOrWhiteSpace(definition.Name) ? "Untitled show" : definition.Name)</strong>
                                            <div class="small">
                                                <span class="badge @(definition.Type == ShowType.PremiumEvent ? "badge--gold" : "badge--cyan")">@Label(definition.Type)</span>
                                                @if (!definition.Active) { <span class="badge badge--muted">Retired</span> }
                                                <span class="muted only-narrow"> · @definition.RecurrenceLabel</span>
                                            </div>
                                            <div class="only-narrow-block mt">
                                                @if (upcoming.FirstOrDefault() is { } soon)
                                                {
                                                    <div class="small">Next: <button class="namelink" @onclick="() => State.OpenShow(soon)">@soon.Date.ToString("ddd d MMM")</button></div>
                                                }
                                                @if (career.Brands.Active)
                                                {
                                                    <select class="input input--sm mt" aria-label="Brand for @definition.Name"
                                                            value="@(definition.BrandId ?? "")"
                                                            @onchange="e => State.SetShowBrandAsync(definition, string.IsNullOrEmpty(e.Value?.ToString()) ? null : e.Value!.ToString())">
                                                        @foreach (var brand in career.Brands.Brands) { <option value="@brand.Id">@brand.Name</option> }
                                                        <option value="">Both brands</option>
                                                    </select>
                                                }
                                                <div class="mt">@Actions(definition)</div>
                                            </div>
                                        </td>
                                        <td class="small col-wide">
                                            @definition.RecurrenceLabel
                                            @if (!string.IsNullOrWhiteSpace(definition.Venue)) { <div class="muted">@definition.Venue</div> }
                                        </td>
                                        <td class="num small col-wide nowrap">@(definition.RuntimeMinutes ?? career.Promotion.DefaultRuntimeFor(definition.Type)) min</td>
                                        @if (career.Brands.Active)
                                        {
                                            @* A brand needs its own television to be a brand at all — doc 22 §1.
                                               Leaving a date company-wide is the inter-brand event of §3.4. *@
                                            <td class="col-wide">
                                                <select class="input input--sm" aria-label="Brand for @definition.Name"
                                                        value="@(definition.BrandId ?? "")"
                                                        @onchange="e => State.SetShowBrandAsync(definition, string.IsNullOrEmpty(e.Value?.ToString()) ? null : e.Value!.ToString())">
                                                    @foreach (var brand in career.Brands.Brands)
                                                    {
                                                        <option value="@brand.Id">@brand.Name</option>
                                                    }
                                                    <option value="">Both brands</option>
                                                </select>
                                            </td>
                                        }
                                        <td class="small nowrap col-wide">
                                            @if (upcoming.FirstOrDefault() is { } first)
                                            {
                                                <button class="namelink" @onclick="() => State.OpenShow(first)">@first.Date.ToString("ddd d MMM")</button>
                                            }
                                            else { <span class="muted">—</span> }
                                        </td>
                                        <td class="num small col-wide">@upcoming.Count</td>
                                        <td class="nowrap col-wide">@Actions(definition)</td>
                                    </tr>
                                    @if (confirmingDelete == definition.Id)
                                    {
                                        <tr>
                                            <td colspan="7">
                                                <div class="notice notice--warn">
                                                    Delete <strong>@definition.Name</strong>? Future dates that are not booked yet
                                                    come off the calendar. Shows you have already booked or run stay.
                                                    <span class="spacer"></span>
                                                    <button class="btn btn--sm btn--danger" @onclick="() => Delete(definition)">Delete</button>
                                                    <button class="btn btn--sm btn--ghost" @onclick="() => confirmingDelete = null">Cancel</button>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                    @if (editing == definition.Id)
                                    {
                                        <tr>
                                            <td colspan="7">
                                                <ShowDefinitionEditor Definition="definition" Promotion="career.Promotion" OnChanged="StateHasChanged" />
                                                @if (ClashOf(career, definition) is { } clash)
                                                {
                                                    <div class="notice notice--warn mt">Lands on the same night as <strong>@clash.Name</strong>.</div>
                                                }
                                                <div class="row mt">
                                                    <span class="small muted">Saving moves every future date that has not been booked yet.</span>
                                                    <span class="spacer"></span>
                                                    <button class="btn btn--sm btn--ghost" @onclick="CancelEdit">Cancel</button>
                                                    <button class="btn btn--sm btn--primary" @onclick="() => Save(definition)">Save changes</button>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                    <div class="small muted mt">Retire stops new dates being added and keeps the ones already on the calendar. Delete takes off every future date that is not booked yet.</div>
                }
            </section>
        </div>

        <aside class="layout__side">
            <section class="panel">
                <div class="panel__title">Add a show</div>
                @if (!career.Promotion.HasTelevision)
                {
                    <p class="small muted">@career.Promotion.TierLabel has no television: reach Established and a weekly slot becomes available.</p>
                }
                @foreach (var type in career.Promotion.AvailableShowTypes)
                {
                    <div class="kv">
                        <span>
                            <strong style="color: var(--ink)">@Label(type)</strong>
                            <div class="small muted">@Explain(type)</div>
                        </span>
                        <button class="btn btn--sm" @onclick="() => Add(career, type)">Add</button>
                    </div>
                }
            </section>
        </aside>
    </div>
}

@code {
    private string? editing;
    private string? confirmingDelete;

    private static int Upcoming(Career career, ShowDefinition definition) =>
        career.Shows.Count(s => s.DefinitionId == definition.Id && !s.HasRun && s.Date >= career.CurrentDate);

    /// <summary>A show being set up, not yet on the career (UX review, 15 Nov: adding saved at once, on a Monday that was already taken).</summary>
    private ShowDefinition? adding;

    private void Add(Career career, ShowType type)
    {
        adding = new ShowDefinition
        {
            Name       = Label(type),
            Type       = type,
            Recurrence = type == ShowType.PremiumEvent ? RecurrenceKind.Monthly : RecurrenceKind.Weekly,
            Day        = type == ShowType.PremiumEvent ? DayOfWeek.Sunday : FreeDay(career),
            Ordinal    = WeekOrdinal.Last
        };
        if (type == ShowType.PremiumEvent)
            foreach (var ordinal in new[] { WeekOrdinal.Last, WeekOrdinal.Second, WeekOrdinal.Third, WeekOrdinal.First })
            {
                adding.Ordinal = ordinal;
                if (ClashOf(career, adding) is null) break;
            }
        CancelEdit();
        // The panel opens at the top of the page; on a phone the Add buttons are far below it.
        _ = Scroll.IntoViewAsync("new-show");
    }

    private async Task SaveNew()
    {
        if (adding is not { } d) return;
        adding = null;
        await State.AddShowDefinitionAsync(d);
    }

    /// <summary>A weekday no weekly show already runs on.</summary>
    private static DayOfWeek FreeDay(Career career)
    {
        var taken = career.ShowDefinitions.Where(d => d.Active && d.Recurrence == RecurrenceKind.Weekly).Select(d => d.Day).ToHashSet();
        foreach (var day in new[] { DayOfWeek.Monday, DayOfWeek.Tuesday, DayOfWeek.Wednesday, DayOfWeek.Thursday,
                                    DayOfWeek.Friday, DayOfWeek.Saturday, DayOfWeek.Sunday })
            if (!taken.Contains(day)) return day;
        return DayOfWeek.Monday;
    }

    private RenderFragment Actions(ShowDefinition definition) => @<span class="actions">
        <button class="btn btn--sm" @onclick="() => StartEdit(definition)">Edit</button>
        @if (definition.Active)
        {
            <button class="btn btn--sm btn--ghost" title="Stops new dates being added; dates already on the calendar stay"
                    @onclick="() => State.RetireShowDefinitionAsync(definition)">Retire</button>
        }
        else
        {
            <button class="btn btn--sm btn--ghost" @onclick="() => State.ReviveShowDefinitionAsync(definition)">Reinstate</button>
        }
        <button class="btn btn--sm btn--danger" @onclick="() => confirmingDelete = definition.Id">Delete</button>
    </span>;

    /// <summary>
    /// What the show was before Edit, put back by Cancel. The editor writes into the live show
    /// as it is changed, so Cancel used to keep every change — and the next re-sync then put the
    /// show on both its old night and its new one (found by UX review, 15 Nov).
    /// </summary>
    private ShowDefinition? before;

    private void StartEdit(ShowDefinition definition)
    {
        if (editing == definition.Id) { CancelEdit(); return; }
        CancelEdit();
        before = definition.Clone();
        editing = definition.Id;
        adding = null;
    }

    private void CancelEdit()
    {
        if (before is { } was && State.Career?.ShowDefinitions.FirstOrDefault(d => d.Id == was.Id) is { } live)
        {
            live.Name = was.Name; live.Type = was.Type; live.Recurrence = was.Recurrence; live.Day = was.Day;
            live.Ordinal = was.Ordinal; live.Venue = was.Venue; live.RuntimeMinutes = was.RuntimeMinutes;
            live.BrandId = was.BrandId; live.Active = was.Active;
        }
        before = null;
        editing = null;
    }

    private async Task Save(ShowDefinition definition)
    {
        editing = null;
        before = null;
        await State.ResyncShowDefinitionAsync(definition);
    }

    /// <summary>Another of the player's standing shows on the same night as this one, if any.</summary>
    private static ShowDefinition? ClashOf(Career career, ShowDefinition d)
    {
        var from = career.CurrentDate;
        var mine = d.OccurrencesBetween(from, from.AddDays(90)).ToHashSet();
        return career.ShowDefinitions.FirstOrDefault(o => o.Id != d.Id && o.Active
            && o.OccurrencesBetween(from, from.AddDays(90)).Any(mine.Contains));
    }

    private async Task Delete(ShowDefinition definition)
    {
        confirmingDelete = null;
        await State.DeleteShowDefinitionAsync(definition);
    }

    private static string Explain(ShowType type) => type switch
    {
        ShowType.Television   => "The weekly episode: rights money, and where the audience meets your roster.",
        ShowType.PremiumEvent => "The big night. Scarcity is what makes it big — one a month at most.",
        ShowType.HouseShow    => "Untelevised. The gate pays, and a run of towns keeps people sharp.",
        _                     => ""
    };

    private static string Label(ShowType type) => type switch
    {
        ShowType.Television   => "Television",
        ShowType.PremiumEvent => "Premium Event",
        ShowType.HouseShow    => "House Show",
        _                     => type.ToString()
    };
}
