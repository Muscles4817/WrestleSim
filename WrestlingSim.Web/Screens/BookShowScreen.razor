@using WrestlingSim.Models.World
@using SegmentModel = WrestlingSim.Models.Segment.Segment
@inherits StateComponent

@if (State.ActiveShow is not { } show || State.Career is not { } career)
{
    <div class="empty">
        <div class="empty__mark">▦</div>
        No show open. Pick a date on the calendar.
    </div>
    <div class="wizard-bar">
        <button class="btn btn--ghost" @onclick="() => State.Go(Screen.Calendar)">← Calendar</button>
    </div>
}
else if (show.HasRun)
{
    @* ── Result ──────────────────────────────────────────────────────────── *@
    var result = show.Result!;

    <div class="screen__head">
        <div class="screen__eyebrow">
            @show.TypeLabel · @show.Date.ToString("dddd d MMMM yyyy")
            @if (!string.IsNullOrWhiteSpace(show.Venue)) { <text> · @show.Venue</text> }
        </div>
        <h1 class="screen__title">@show.Name</h1>
    </div>

    <div class="score-hero">
        <div>
            <div class="score-hero__label">Overall</div>
            <div class="score-hero__main">@result.OverallRating.ToString("F1") <span class="muted">/ 100</span></div>
        </div>
        <div>
            <div class="score-hero__label">Runtime</div>
            <div class="score-hero__main">@result.BookedMinutes<span class="muted"> / @result.BudgetMinutes min</span></div>
        </div>
        <div>
            <div class="score-hero__label">Final crowd</div>
            <div class="score-hero__main">@result.FinalCrowdMood.ToString("F1") <span class="muted">/ 10</span></div>
        </div>
    </div>

    @if (result.OverrunPenalty > 0)
    {
        <div class="notice notice--error mt">
            <strong>The show ran long.</strong> Overall score cut by
            @((result.OverrunPenalty * 100).ToString("F0"))%.
        </div>
    }

    @* The bill for the night's crossovers, presented after the rating they bought.
       docs/wrestling-reference/22-brand-splits.md §4.1. *@
    @if (result.Brand is { } brandReport)
    {
        <div class="panel">
            <div class="panel__title">
                @brandReport.BrandName
                <span class="spacer"></span>
                <span class="small muted">
                    Split integrity @brandReport.IntegrityBefore.ToString("F1")
                    → @brandReport.IntegrityAfter.ToString("F1")
                </span>
            </div>

            @if (brandReport.Crossovers.Count == 0)
            {
                <div class="notice notice--info">
                    Kept to its own roster. Worth
                    +@((brandReport.ExclusivityBonus * 100).ToString("F1"))% on the night, and it
                    is worth that only for as long as the split means something.
                </div>
            }
            else
            {
                <div class="notice notice--warn">
                    <strong>
                        @brandReport.Crossovers.Count crossover@(brandReport.Crossovers.Count == 1 ? "" : "s")
                        — split integrity down
                        @((brandReport.IntegrityBefore - brandReport.IntegrityAfter).ToString("F1")),
                        ceiling now @brandReport.Ceiling.ToString("F1").
                    </strong>
                    <ul>
                        @foreach (var crossover in brandReport.Crossovers)
                        {
                            <li>
                                @crossover.Wrestler (@crossover.HomeBrand) —
                                worth +@((crossover.Attraction * 100).ToString("F0"))% on the items they
                                worked, cost @crossover.Cost.ToString("F1") integrity, of which
                                @((crossover.Cost * BrandIntegrity.PermanentShare).ToString("F1")) does not come back.
                            </li>
                        }
                    </ul>
                </div>
            }

            @if (brandReport.StarMakingFactor < 0.995)
            {
                <div class="notice notice--warn">
                    Winners on this show kept
                    @((brandReport.StarMakingFactor * 100).ToString("F0"))% of the standing they earned.
                    A brand that does not mean anything cannot make anybody.
                </div>
            }
        </div>
    }

    <div class="panel">
        <div class="panel__title">Card</div>
        @foreach (var item in result.Items)
        {
            <div class="editor-row">
                <div class="editor-row__n">@(result.Items.IndexOf(item) + 1)</div>
                <div>
                    <div class="editor-row__name">@item.Label</div>
                    <div class="editor-row__sub">@item.Kind · @item.DurationMinutes min</div>
                    @foreach (var note in item.Notes)
                    {
                        <div class="editor-row__sub">@note</div>
                    }
                </div>
                <div class="editor-row__tools">
                    @if (item.StarRating is { } stars)
                    {
                        <Stars Rating="@stars" ShowNumber="false" />
                    }
                    <strong class="tabnum gold">@item.Score.ToString("F1")</strong>
                </div>
            </div>
        }
    </div>

    @* Status movement, feud movement and play-by-play exist only for a show run this
       session — a reloaded save keeps the result summary, not the beat-by-beat detail. *@
    @if (result.TitleUpdates.Count > 0)
    {
        <TitleChanges Updates="@result.TitleUpdates" />
    }

    @if (result.StatusChanges.Count > 0)
    {
        <StatusChanges Changes="@result.StatusChanges" />
    }

    @if (result.FeudUpdates.Count > 0)
    {
        <FeudUpdates Updates="@result.FeudUpdates" />
    }

    @foreach (var item in result.Items.Where(i => i.MatchResult is not null))
    {
        <div class="panel">
            <div class="panel__title">@item.Label — play by play</div>
            <PlayByPlay Result="item.MatchResult!" />
        </div>
    }

    <div class="wizard-bar">
        <button class="btn btn--ghost" @onclick="() => State.Go(Screen.Dashboard)">← Dashboard</button>
        <span class="wizard-bar__spacer"></span>
        <button class="btn btn--primary" @onclick="() => State.Go(Screen.Calendar)">Calendar →</button>
    </div>
}
else if (mode == Mode.AddMatch)
{
    <div class="screen__head">
        <div class="screen__eyebrow">Adding to @show.Name</div>
        <h1 class="screen__title">Add a Match</h1>
    </div>
    <MatchBuilder OnDone="AddMatch" OnCancel="@(() => mode = Mode.Card)" ConfirmLabel="Add to card +" />
}
else if (mode == Mode.AddSegment)
{
    <div class="screen__head">
        <div class="screen__eyebrow">Adding to @show.Name</div>
        <h1 class="screen__title">Add a Segment</h1>
    </div>
    <SegmentBuilder OnDone="AddSegment" OnCancel="@(() => mode = Mode.Card)" ConfirmLabel="Add to card +" />
}
else
{
    @* ── Card sheet ──────────────────────────────────────────────────────── *@
    <div class="screen__head">
        <div class="screen__eyebrow">
            @if (career.Brands.Active)
            {
                <span class="badge @(career.BrandOfShow(show) is null ? "badge--muted" : "badge--face")">
                    @(career.BrandOfShow(show)?.Name ?? "Both brands")
                </span>
                <text>&#32;</text>
            }
            @show.TypeLabel · @show.Date.ToString("dddd d MMMM yyyy")
            @if (career.DaysUntil(show) > 0)
            {
                <text> · in @career.DaysUntil(show) day@(career.DaysUntil(show) == 1 ? "" : "s")</text>
            }
        </div>
        <h1 class="screen__title">@show.Name</h1>
        <p class="screen__lede">
            Position and pacing both count: the opener is weighted ×1.2, the main event ×1.5,
            and two of the same kind back to back take a fatigue penalty.
        </p>
    </div>

    <div class="panel">
        <div class="panel__title">Details</div>
        <div class="fields">
            <div class="field">
                <span class="field__label">Show name</span>
                <input class="input" @bind="show.Name" @bind:after="Persist" maxlength="60" />
            </div>
            <div class="field">
                <span class="field__label">Venue</span>
                <input class="input" @bind="show.Venue" @bind:after="Persist" maxlength="60"
                       placeholder="Unknown Arena" />
            </div>
            <div class="field">
                <span class="field__label">Runtime budget (minutes)</span>
                <input class="input" type="number" min="20" max="480"
                       @bind="show.RuntimeMinutes" @bind:after="Persist" />
            </div>

            @if (career.Brands.Active)
            {
                @* Per date rather than per series: moving one night to the other brand is a
                   thing a promotion does, and it should not move the whole show with it. *@
                <div class="field">
                    <span class="field__label">Whose show this is</span>
                    <select class="input" value="@(show.BrandId ?? "")"
                            @onchange="e => SetBrand(show, e.Value?.ToString())">
                        @foreach (var brand in career.Brands.Brands)
                        {
                            <option value="@brand.Id">@brand.Name</option>
                        }
                        <option value="">Both brands — nobody crosses over</option>
                    </select>
                </div>
            }
        </div>
    </div>

    <div class="panel">
        <div class="panel__title">
            Running order
            <span class="spacer"></span>
            <span class="small muted">
                @show.Card.Count of about @career.Promotion.TypicalCardSizeFor(show.Type) expected
            </span>
        </div>

        @if (show.Card.Count == 0)
        {
            <div class="empty">
                <div class="empty__mark">▦</div>
                Nothing booked yet. Add a match or a segment below.
            </div>
        }

        @foreach (var item in show.Card)
        {
            var i = show.Card.IndexOf(item);
            var fatigued = i > 0 && show.Card[i - 1].Kind == item.Kind;

            <div class="editor-row @(fatigued ? "is-flagged" : "")">
                <div class="editor-row__n">@(i + 1)</div>
                <div>
                    <div class="editor-row__name">@item.Name</div>
                    <div class="editor-row__sub">
                        @item.Kind · @item.DurationMinutes min
                        @if (item is BookedMatch { Plan.TitleAtStake: { } belt })
                        {
                            <text> · @belt.Name</text>
                        }
                        @if (i == 0) { <text> · opener ×1.2</text> }
                        @if (i == show.Card.Count - 1 && show.Card.Count > 1) { <text> · main event ×1.5</text> }
                        @if (fatigued) { <text> · fatigue ×0.85</text> }
                    </div>
                </div>
                <div class="editor-row__tools">
                    <button class="btn btn--icon btn--ghost" disabled="@(i == 0)"
                            title="Move up" @onclick="() => Move(i, -1)">↑</button>
                    <button class="btn btn--icon btn--ghost" disabled="@(i == show.Card.Count - 1)"
                            title="Move down" @onclick="() => Move(i, 1)">↓</button>
                    <button class="btn btn--icon btn--danger" title="Remove"
                            @onclick="() => Remove(item)">✕</button>
                </div>
            </div>
        }

        <div class="mt">
            <Meter Label="Runtime" Value="@show.BookedMinutes" Max="@show.RuntimeMinutes"
                   ValueText="@RuntimeText(show)"
                   Variant="@(show.IsOverrunning ? "heel" : "gold")" />
        </div>

        @if (show.IsOverrunning)
        {
            <div class="notice notice--warn mt">
                The card runs @(show.BookedMinutes - show.RuntimeMinutes) minutes long.
                Running it costs up to 35% of the overall score.
            </div>
        }

        @if (Crossovers(career, show) is { Count: > 0 } crossing)
        {
            <div class="notice notice--warn mt">
                <strong>
                    @crossing.Count crossover@(crossing.Count == 1 ? "" : "s") on this card —
                    @CrossoverCost(career, show).ToString("F1") split integrity if you run it.
                </strong>
                @string.Join(", ", crossing.Select(c => $"{c.Wrestler.RingName} ({c.Home.Name})")).
                Each of these is worth something tonight.
                @((BrandIntegrity.PermanentShare * 100).ToString("F0"))% of the cost never comes back.
            </div>
        }

        <div class="row mt">
            <button class="btn" @onclick="() => mode = Mode.AddMatch">+ Add a match</button>
            <button class="btn" @onclick="() => mode = Mode.AddSegment">+ Add a segment</button>
            <span class="spacer"></span>
            <button class="btn btn--primary" disabled="@(show.Card.Count == 0)" @onclick="() => Run(show)">
                Run the show ★
            </button>
        </div>

        @if (show.Card.Count > 0 && career.DaysUntil(show) > 0)
        {
            <div class="notice notice--info mt">
                This show is @career.DaysUntil(show) day@(career.DaysUntil(show) == 1 ? "" : "s") away.
                Running it now advances the clock to @show.Date.ToString("d MMM").
            </div>
        }
    </div>

    <div class="wizard-bar">
        <button class="btn btn--ghost" @onclick="() => State.Go(Screen.Calendar)">← Calendar</button>
        <span class="wizard-bar__spacer"></span>
        <button class="btn btn--sm btn--ghost" @onclick="() => State.Go(Screen.Dashboard)">Dashboard</button>
    </div>
}

@code {
    private enum Mode { Card, AddMatch, AddSegment }

    private Mode mode = Mode.Card;

    private async Task SetBrand(ScheduledShow show, string? brandId)
    {
        show.BrandId = string.IsNullOrWhiteSpace(brandId) ? null : brandId;
        await Persist();
    }

    /// <summary>Everyone booked on this card who does not belong on this show.</summary>
    private static List<Crossover> Crossovers(Career career, ScheduledShow show) =>
        BrandIntegrity.Detect(show.Card, career.Brands, career.BrandOfShow(show)).ToList();

    private static double CrossoverCost(Career career, ScheduledShow show) =>
        Crossovers(career, show).Sum(c => c.Cost);

    private static string RuntimeText(ScheduledShow show) => show.IsOverrunning
        ? $"{show.BookedMinutes} / {show.RuntimeMinutes} min — over by {show.BookedMinutes - show.RuntimeMinutes}"
        : $"{show.BookedMinutes} / {show.RuntimeMinutes} min — {show.RemainingMinutes} left";

    private async Task AddMatch(BookedMatch match)
    {
        State.ActiveShow?.Card.Add(match);
        mode = Mode.Card;
        await Persist();
    }

    private async Task AddSegment(SegmentModel segment)
    {
        State.ActiveShow?.Card.Add(segment);
        mode = Mode.Card;
        await Persist();
    }

    private async Task Remove(ICardItem item)
    {
        State.ActiveShow?.Card.Remove(item);
        await Persist();
    }

    private async Task Move(int index, int direction)
    {
        var card = State.ActiveShow?.Card;
        if (card == null) return;

        int to = index + direction;
        if (to < 0 || to >= card.Count) return;

        (card[index], card[to]) = (card[to], card[index]);
        await Persist();
    }

    private Task Run(ScheduledShow show) => State.RunShowAsync(show);

    /// <summary>Every edit to a card is written straight to the save — there is no "unsaved card".</summary>
    private Task Persist() => State.SaveAsync();
}
