@using WrestlingSim.Enums
@using WrestlingSim.Models.World
@inherits StateComponent

@if (State.Career is not { } career)
{
    <div class="empty"><div class="empty__mark"><Icon Name="star" /></div>No career loaded.</div>
}
else
{
    var marks = Marks(career);

    <div class="layout">
    <div class="layout__main">
    <div class="panel">
        <div class="calhead">
            <button class="btn btn--sm" aria-label="Previous month" @onclick="() => Shift(-1)">← @MonthStart.AddMonths(-1).ToString("MMM")</button>
            <div class="calhead__mid">
                <span class="calhead__month">@MonthStart.ToString("MMMM yyyy")</span>
                <button class="btn btn--sm btn--ghost" @onclick="ToToday">Today</button>
            </div>
            <button class="btn btn--sm" aria-label="Next month" @onclick="() => Shift(1)">@MonthStart.AddMonths(1).ToString("MMM") →</button>
        </div>

        <div class="cal mt">
            @foreach (var label in DayLabels)
            {
                <div class="cal__dow">@label</div>
            }

            @foreach (var day in GridDays)
            {
                var shows = career.On(day).ToList();
                var isToday = day == career.CurrentDate;
                var otherMonth = day.Month != MonthStart.Month;
                var past = day < career.CurrentDate;

                <button class="cal__day @(isToday ? "is-today" : "") @(otherMonth ? "is-outside" : "") @(past ? "is-past" : "") @(selected == day ? "is-selected" : "")"
                        @onclick="() => Select(day)">
                    <span class="cal__num">@day.Day</span>
                    @foreach (var show in shows)
                    {
                        <span class="cal__show @(show.HasRun ? "is-run" : show.IsBooked ? "is-booked" : "")"
                              title="@show.Name">
                            @show.Name
                        </span>
                    }
                    @if (marks.TryGetValue(day, out var dayMarks))
                    {
                        @foreach (var m in dayMarks.Take(2))
                        {
                            <span class="cal__show @(m.Deadline ? "is-deadline" : "is-rival")" title="@m.Text">@m.Short</span>
                        }
                        @if (dayMarks.Count > 2)
                        {
                            <span class="cal__show is-rival">+@(dayMarks.Count - 2) more</span>
                        }
                    }
                </button>
            }
        </div>
        <div class="legend">
            <span><i style="background: var(--gold)"></i>Your shows</span>
            <span><i style="background: var(--cyan)"></i>Rival shows</span>
            <span><i style="background: var(--heel)"></i>Deadlines</span>
        </div>
    </div>
    </div>

    <aside class="layout__side">
    @* ── The selected day ────────────────────────────────────────────────── *@
    @if (selected is { } day2)
    {
        var shows = career.On(day2).ToList();

        <div class="panel">
            <div class="panel__title">
                @day2.ToString("dddd d MMMM yyyy")
                <span class="spacer"></span>
                @if (day2 < career.CurrentDate)
                {
                    <span class="badge badge--muted">In the past</span>
                }
            </div>

            @if (shows.Count == 0)
            {
                <div class="empty">
                    <div class="empty__mark"><Icon Name="clock" /></div>
                    Nothing on this date.
                </div>
            }
            else
            {
                @foreach (var show in shows)
                {
                    <div class="editor-row">
                        <div class="editor-row__n">@(show.HasRun ? "★" : show.IsBooked ? "▦" : "·")</div>
                        <div>
                            <div class="editor-row__name">@show.Name</div>
                            <div class="editor-row__sub">
                                @show.TypeLabel · @show.RuntimeMinutes min budget
                                @if (show.HasRun)
                                {
                                    <text> · rated </text><span class="tabnum @Grades.OfScore(show.Result!.OverallRating).Tone()">@show.Result!.OverallRating.ToString("F1")</span>
                                }
                                else if (show.IsBooked)
                                {
                                    <text> · @show.Card.Count item@(show.Card.Count == 1 ? "" : "s") booked</text>
                                }
                                else
                                {
                                    <text> · nothing booked</text>
                                }
                            </div>
                        </div>
                        <div class="editor-row__tools">
                            <button class="btn btn--sm btn--primary" @onclick="() => State.OpenShow(show)">
                                @(show.HasRun ? "Review" : show.IsBooked ? "Open" : "Book")
                            </button>
                            @if (!show.HasRun)
                            {
                                <button class="btn btn--icon btn--danger" title="Take off the calendar"
                                        @onclick="() => State.CancelShowAsync(show)"><Icon Name="close" /></button>
                            }
                        </div>
                    </div>
                }
            }

            @* Scheduling is only forward-looking — you cannot add a show to a date that has passed. *@
            @if (day2 >= career.CurrentDate)
            {
                <div class="mt">
                    <div class="fields">
                        <div class="field">
                            <span class="field__label">Show name</span>
                            <input class="input" @bind="newName" @bind:event="oninput" maxlength="60"
                                   placeholder="@DefaultName(career)" />
                        </div>
                        <div class="field">
                            <span class="field__label">Type</span>
                            <select class="input" @bind="newType">
                                @foreach (var type in career.Promotion.AvailableShowTypes)
                                {
                                    <option value="@type">@Label(type)</option>
                                }
                            </select>
                        </div>
                        <div class="field">
                            <span class="field__label">Venue</span>
                            <input class="input" @bind="newVenue" maxlength="60" placeholder="Unknown Arena" />
                        </div>
                    </div>

                    <div class="row mt">
                        <span class="small muted">
                            @career.Promotion.DefaultRuntimeFor(newType) min budget ·
                            about @career.Promotion.TypicalCardSizeFor(newType) items ·
                            @career.Promotion.TypicalAttendanceFor(newType).ToString("N0") seats — the card decides how many sell
                        </span>
                        <span class="spacer"></span>
                        <button class="btn btn--primary" @onclick="() => Schedule(career, day2)">
                            + Put a show on this date
                        </button>
                    </div>
                </div>
            }
        </div>
    }

    <div class="panel">
        <div class="panel__title">Coming up</div>
        @{ var upcoming = career.Upcoming.Take(5).ToList(); }
        @if (upcoming.Count == 0)
        {
            <div class="small muted">Nothing scheduled. Pick a date to put a show on it.</div>
        }
        @foreach (var show in upcoming)
        {
            var s = show;
            <div class="kv">
                <span>
                    <strong>@show.Name</strong>
                    <div class="small muted">@show.Date.ToString("ddd d MMM") · @(show.IsBooked ? $"{show.BookedMinutes} of {show.RuntimeMinutes} min booked" : "nothing booked")</div>
                </span>
                <span><button class="btn btn--sm @(show.IsBooked ? "" : "btn--primary")" @onclick="() => State.OpenShow(s)">@(show.IsBooked ? "Open" : "Book")</button></span>
            </div>
        }
    </div>
    </aside>
    </div>
}

@code {
    private static readonly string[] DayLabels = ["Mon", "Tue", "Wed", "Thu", "Fri", "Sat", "Sun"];

    private DateOnly? month;
    private DateOnly? selected;

    private string newName = "";
    private string newVenue = "";
    private ShowType newType = ShowType.Television;

    protected override void OnInitialized()
    {
        var career = State.Career;
        if (career == null) return;

        month = new DateOnly(career.CurrentDate.Year, career.CurrentDate.Month, 1);
        selected = career.NextShow?.Date ?? career.CurrentDate;

        // Default to a type this promotion can actually run.
        newType = career.Promotion.AvailableShowTypes.First();
    }

    private DateOnly MonthStart => month ?? DateOnly.FromDateTime(DateTime.Today);

    private sealed record Mark(string Short, string Text, bool Deadline);

    /// <summary>
    /// What else is on each day of the visible grid: rival shows (the ones they have run, and
    /// the ones their schedule says are coming) and the dates something runs out.
    /// </summary>
    private Dictionary<DateOnly, List<Mark>> Marks(Career career)
    {
        var first = GridDays.First();
        var last = GridDays.Last();
        var marks = new Dictionary<DateOnly, List<Mark>>();
        void Add(DateOnly day, Mark m)
        {
            if (day < first || day > last) return;
            if (!marks.TryGetValue(day, out var list)) marks[day] = list = [];
            list.Add(m);
        }

        foreach (var rival in career.Rivals.Where(r => r.IsActive || r.Folded >= first))
        {
            foreach (var night in rival.Nights)
                Add(night.Date, new(rival.Name, $"{rival.Name}: {night.Headline}", false));
            if (!rival.IsActive) continue;
            int interval = Math.Max(1, rival.Promotion.TypicalShowIntervalDays);
            for (var d = rival.NextShow; d <= last; d = d.AddDays(interval))
                Add(d, new(rival.Name, $"{rival.Name} runs a show", false));
        }

        foreach (var c in career.Contracts.Where(c => c.IsGuaranteed && c.End is not null))
            if (career.FindWrestler(c.WrestlerId) is { } w)
                Add(c.End!.Value, new($"{w.RingName}'s deal ends", $"{w.RingName}'s contract runs out", true));

        foreach (var bid in career.Bids.Where(b => b.Bidder == Career.PlayerId))
            if (career.FindWrestler(bid.WrestlerId) is { } w && career.SignedTo(w)?.ContractOf(w)?.End is { } end)
                Add(end, new($"{w.RingName} decides", $"{w.RingName} chooses between your offer and their current deal", true));

        if (career.Television is { } deal)
            Add(deal.End, new("TV deal renews", "Your television deal renews", true));

        return marks;
    }

    /// <summary>
    /// Six weeks from the Monday on or before the 1st — a fixed grid, so the layout does
    /// not jump between months.
    /// </summary>
    private IEnumerable<DateOnly> GridDays
    {
        get
        {
            var first = MonthStart;
            int back = ((int)first.DayOfWeek + 6) % 7;   // Monday-first
            var start = first.AddDays(-back);

            for (int i = 0; i < 42; i++) yield return start.AddDays(i);
        }
    }

    private void Shift(int months)
    {
        month = MonthStart.AddMonths(months);
        selected = null;
    }

    private void ToToday()
    {
        var career = State.Career;
        if (career == null) return;

        month = new DateOnly(career.CurrentDate.Year, career.CurrentDate.Month, 1);
        selected = career.CurrentDate;
    }

    private void Select(DateOnly day)
    {
        selected = day;

        // Clicking into a neighbouring month's day should bring that month into view.
        if (day.Month != MonthStart.Month) month = new DateOnly(day.Year, day.Month, 1);
    }

    private async Task Schedule(Career career, DateOnly date)
    {
        string name = string.IsNullOrWhiteSpace(newName) ? DefaultName(career) : newName.Trim();
        await State.ScheduleShowAsync(name, date, newType, newVenue.Trim());

        newName = "";
        newVenue = "";
    }

    private string DefaultName(Career career) => newType switch
    {
        ShowType.Television   => $"{career.Promotion.Name} Weekly",
        ShowType.PremiumEvent => $"{career.Promotion.Name} Special",
        _                     => $"{career.Promotion.Name} Live"
    };

    private static string Label(ShowType type) => type switch
    {
        ShowType.Television   => "Television",
        ShowType.PremiumEvent => "Premium Event",
        ShowType.HouseShow    => "House Show",
        _                     => type.ToString()
    };
}
