@*
    World: every other promotion, what each wants and what it last did, and what competition
    is doing to the player's prices and crowds. A row opens that promotion's page.

    Regions are not a filter because the game has none yet (docs/living-world-plan.md).
*@
@inherits StateComponent

@if (State.Career is not { } career)
{
    <div class="empty">No career open.</div>
}
else
{
    var employers = World.CredibleEmployers(career);

    <section class="kpis">
        <div class="kpi">
            <span class="kpi__key">Wrestlers' prices</span>
            <span class="kpi__val">@Shown.Factor(career.WageFactor)</span>
            <span class="kpi__sub">@RivalLabels.WageReading(career.WageFactor)</span>
        </div>
        <div class="kpi">
            <span class="kpi__key">Interest in wrestling</span>
            <span class="kpi__val">@Shown.Factor(career.Interest)</span>
            <span class="kpi__sub">@RivalLabels.InterestReading(career.Interest)</span>
        </div>
        <div class="kpi">
            <span class="kpi__key">Promotions running</span>
            <span class="kpi__val">@(career.Rivals.Count(r => r.IsActive) + 1)</span>
            <span class="kpi__sub">@employers at national level or above, yours included</span>
        </div>
    </section>

    <div class="layout">
        <div class="layout__main">
            <div class="panel">
                <div class="table-wrap">
                    <table class="data">
                        <thead>
                            <tr>
                                <th>Promotion</th>
                                <th>Level</th>
                                <th class="num">Roster</th>
                                <th class="num col-wide">Reputation</th>
                                <th class="num col-wide">Last house</th>
                                <th class="num col-wide">Cash</th>
                                <th class="col-wide">Lately</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var rival in career.Rivals.OrderByDescending(r => r.IsActive).ThenByDescending(r => r.Promotion.Tier).ThenBy(r => r.Name))
                            {
                                var r = rival;
                                var last = rival.Nights.LastOrDefault();
                                <tr class="@(rival.IsActive ? "" : "muted")">
                                    <td>
                                        <button class="namecell" @onclick="() => State.OpenRival(r)">
                                            <strong>@rival.Name</strong>
                                            <span class="small muted">@RivalLabels.Motive(rival.Motive)</span>
                                        </button>
                                    </td>
                                    <td class="small">@rival.Promotion.TierLabel</td>
                                    <td class="num">@rival.Contracts.Count</td>
                                    <td class="num col-wide">@rival.Books.Reputation.ToString("F0")</td>
                                    <td class="num col-wide">@(last is null || last.Capacity == 0 ? "—" : Money.Percent(last.Attendance / (double)last.Capacity))</td>
                                    <td class="num col-wide @Money.Tone(rival.Books.Cash)">@Money.Format(rival.Books.Cash)</td>
                                    <td class="small col-wide">@RivalLabels.Doing(career, rival)</td>
                                </tr>
                            }
                            <tr class="is-mine">
                                <td><strong>@career.Promotion.Name</strong><div class="small muted">You</div></td>
                                <td class="small">@career.Promotion.TierLabel</td>
                                <td class="num">@career.Contracts.Count</td>
                                <td class="num col-wide">@career.Books.Reputation.ToString("F0")</td>
                                <td class="num col-wide">@(career.Completed.OrderByDescending(s => s.Date).FirstOrDefault()?.Result?.Finances is { } f ? Money.Percent(f.Fill) : "—")</td>
                                <td class="num col-wide @Money.Tone(career.Books.Cash)">@Money.Format(career.Books.Cash)</td>
                                <td class="small col-wide"></td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <aside class="layout__side">
            <section class="panel">
                <div class="panel__title">
                    News
                    <span class="spacer"></span>
                    <button class="btn btn--sm btn--ghost" @onclick="() => State.Go(Screen.News)">All</button>
                </div>
                @if (career.News.Count == 0)
                {
                    <div class="small muted">Nothing yet. The industry moves on the clock.</div>
                }
                @foreach (var n in career.News.AsEnumerable().Reverse().Take(10))
                {
                    <div class="newsline @(n.AboutYou ? "is-you" : "")"><span>@n.Date.ToString("d MMM")</span><span>@n.Text</span></div>
                }
            </section>
        </aside>
    </div>
}
