@*
    Search + division filter for any roster picker.

    A thirty-name list is a wall on a phone. Both the match builder and the segment
    builder need the same narrowing controls, so they live here rather than being
    duplicated with slightly different behaviour in each.
*@

@if (HomeBrand is { } brand)
{
    @* The crossover is deliberately one click away and deliberately labelled. Doc 22 §4.1:
       the decision has to be easy and defensible, or the mechanic is not the one the
       reference describes. *@
    <div class="chips">
        <button class="chip @(IncludeCrossover ? "" : "is-active")"
                @onclick="() => SetCrossover(false)">@brand.Name only</button>
        <button class="chip @(IncludeCrossover ? "is-active" : "")"
                @onclick="() => SetCrossover(true)">All brands — crossover</button>
    </div>
}

<div class="searchbar">
    <input class="input" type="search" placeholder="@Placeholder"
           value="@Query" @oninput="OnQuery" />
    <div class="chips">
        <button class="chip @(Division is null ? "is-active" : "")"
                @onclick="() => SetDivision(null)">All</button>
        <button class="chip @(Division == WrestlingSim.Enums.Division.Womens ? "is-active" : "")"
                @onclick="() => SetDivision(WrestlingSim.Enums.Division.Womens)">Women</button>
        <button class="chip @(Division == WrestlingSim.Enums.Division.Mens ? "is-active" : "")"
                @onclick="() => SetDivision(WrestlingSim.Enums.Division.Mens)">Men</button>
    </div>
</div>

@code {
    [Parameter] public string Query { get; set; } = "";
    [Parameter] public EventCallback<string> QueryChanged { get; set; }

    [Parameter] public Division? Division { get; set; }
    [Parameter] public EventCallback<Division?> DivisionChanged { get; set; }

    [Parameter] public string Placeholder { get; set; } = "Search the roster…";

    /// <summary>The brand running the show being booked, or null when brands do not apply.</summary>
    [Parameter] public Brand? HomeBrand { get; set; }

    /// <summary>Whether the other brands' rosters are on offer.</summary>
    [Parameter] public bool IncludeCrossover { get; set; }
    [Parameter] public EventCallback<bool> IncludeCrossoverChanged { get; set; }

    private Task SetCrossover(bool value) => IncludeCrossoverChanged.InvokeAsync(value);

    private Task OnQuery(ChangeEventArgs e) =>
        QueryChanged.InvokeAsync(e.Value?.ToString() ?? "");

    private Task SetDivision(Division? d) => DivisionChanged.InvokeAsync(d);
}
