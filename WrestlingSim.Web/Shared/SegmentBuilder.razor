@inject GameState State
@inject ViewScroll Scroll

<div class="steps">
    @foreach (var (index, label) in StepLabels)
    {
        <div class="step @(step == index ? "is-current" : step > index ? "is-done" : "")">
            <span class="step__n">@if (step > index) { <Icon Name="check" /> } else { @(index + 1) }</span>
            <span>@label</span>
        </div>
    }
    @* On a phone the pills collapse to bare numerals, so this line carries where you are.
       Without it — which is how this shipped for a round — the change made two of the three
       step bars strictly worse than before it. *@
    <div class="steps__where small muted">
        @(step + 1) of @StepLabels.Length · @StepLabels[step].Label
    </div>
</div>

@* ── 1. Template ──────────────────────────────────────────────────────── *@
@if (step == 0)
{
    <div class="panel">
        <div class="panel__title">Segment type</div>

        @foreach (var category in SegmentTemplateLibrary.Categories)
        {
            <div class="group-label">@category</div>
            <div class="picks">
                @foreach (var t in SegmentTemplateLibrary.ByCategory(category))
                {
                    var blocked = t.MinParticipants > State.Roster.Count;
                    <button class="pick @(template == t ? "is-selected" : "")"
                            disabled="@blocked" @onclick="() => PickTemplate(t)">
                        <span class="pick__body">
                            <span class="pick__name">@t.Name</span>
                            <span class="pick__desc">@t.Description</span>
                            @if (!string.IsNullOrWhiteSpace(t.BookerTip))
                            {
                                <span class="pick__desc gold">ⓘ @t.BookerTip</span>
                            }
                            @if (t.HistoryTags.Count > 0)
                            {
                                <span class="badge-row" style="margin-top:6px">
                                    @foreach (var tag in t.HistoryTags)
                                    {
                                        <span class="badge badge--cyan">@tag.Label()</span>
                                    }
                                </span>
                            }
                        </span>
                        <span class="pick__meta">
                            @t.MinParticipants@(t.AllowsExtraParticipants ? "+" : "")&nbsp;people<br />@t.Location
                        </span>
                    </button>
                }
            </div>
        }

        <div class="group-label">Custom</div>
        <div class="picks">
            <button class="pick @(isCustom ? "is-selected" : "")" @onclick="PickCustom">
                <span class="pick__body">
                    <span class="pick__name">Build from scratch</span>
                    <span class="pick__desc">Choose the format, the setting and every action yourself.</span>
                </span>
            </button>
        </div>
    </div>
}

@* ── 2. Cast ──────────────────────────────────────────────────────────── *@
@if (step == 1)
{
    @if (isCustom)
    {
        <div class="panel">
            <div class="panel__title">Format</div>
            <div class="fields">
                <div class="field">
                    <span class="field__label">Name</span>
                    <input class="input" @bind="customName" placeholder="Untitled segment" />
                </div>
                <div class="field">
                    <span class="field__label">Type</span>
                    <select class="select" @bind="customType">
                        @foreach (var v in Enum.GetValues<SegmentType>())
                        {
                            <option value="@v">@v</option>
                        }
                    </select>
                </div>
                <div class="field">
                    <span class="field__label">Location</span>
                    <select class="select" @bind="customLocation">
                        @foreach (var v in Enum.GetValues<SegmentLocation>())
                        {
                            <option value="@v">@v (@Shown.Factor(LocationMultiplier(v)))</option>
                        }
                    </select>
                </div>
            </div>
        </div>

        <div class="panel">
            <div class="panel__title">Cast <span class="spacer"></span><span class="small muted">@cast.Count selected</span></div>
            <CastFilter Query="@castQuery" QueryChanged="@(v => castQuery = v)"
                        Division="@castDivision" DivisionChanged="@(v => castDivision = v)"
                        HomeBrand="@State.BookingBrand"
                        IncludeCrossover="@includeCrossover" IncludeCrossoverChanged="@(v => includeCrossover = v)" />
            <div class="picks picks--2">
                @foreach (var row in RankedRoster())
                {
                    var w = row.Wrestler;
                    <button class="pick @(cast.Contains(w) ? "is-selected" : "")" @onclick="() => ToggleCast(w)">
                        <span class="pick__body">
                            <span class="pick__name">
                                @w.RingName
                                @if (w.Gimmick is { } g)
                                {
                                    <span class="badge badge--sm @g.NaturalAlignment.Badge()">@g.NaturalAlignment.Label()</span>
                                }
                                @* A price, not a villain — this was the heel colour, which now
                                   means the wrestler is one. *@
                                @if (State.IsCrossover(w))
                                {
                                    <span class="badge badge--sm badge--cost">crossover −@Shown.Whole(BrandIntegrity.CostOf(w))</span>
                                }
                            </span>
                            <span class="pick__desc">@w.CharismaLabel · @w.CardPosition.Label()</span>
                            @* The ranking's own reason, but only where it says something worth
                               a line. A promo cares about charisma, which is the line above;
                               a live story or a worn-out pairing is the thing that changes
                               which promo you book at all. *@
                            @if (BookingSuggestions.Tone(row.Band) is { Length: > 0 } tone)
                            {
                                <span class="pick__desc @tone">@row.Reason</span>
                            }
                        </span>
                    </button>
                }
            </div>
        </div>
    }
    else if (template is not null)
    {
        <div class="panel">
            <div class="panel__title">Cast — @template.Name</div>

            <CastFilter Query="@castQuery" QueryChanged="@(v => castQuery = v)"
                        Division="@castDivision" DivisionChanged="@(v => castDivision = v)"
                        HomeBrand="@State.BookingBrand"
                        IncludeCrossover="@includeCrossover" IncludeCrossoverChanged="@(v => includeCrossover = v)" />

            @for (int r = 0; r < template.ParticipantRoles.Count; r++)
            {
                var roleIndex = r;
                var role = template.ParticipantRoles[roleIndex];
                <div class="field mt">
                    <span class="field__label">@role</span>
                    <div class="picks picks--2">
                        @foreach (var row in RankedRoster().Where(x => IsAvailableFor(x.Wrestler, roleIndex)))
                        {
                            var w = row.Wrestler;
                            <button class="pick @(RoleAt(roleIndex) == w ? "is-selected" : "")"
                                    @onclick="() => AssignRole(roleIndex, w)">
                                <span class="pick__body">
                                    <span class="pick__name">
                                        @w.RingName
                                        @if (w.Gimmick is { } g)
                                        {
                                            <span class="badge badge--sm @g.NaturalAlignment.Badge()">@g.NaturalAlignment.Label()</span>
                                        }
                                        @if (State.IsCrossover(w))
                                        {
                                            <span class="badge badge--sm badge--cost">crossover</span>
                                        }
                                    </span>
                                    <span class="pick__desc">@w.CharismaLabel · @w.CardPosition.Label()</span>
                                </span>
                            </button>
                        }
                    </div>
                </div>
            }

            @if (template.AllowsExtraParticipants)
            {
                <div class="field mt">
                    <span class="field__label">@template.ExtraParticipantRole (optional)</span>
                    <div class="picks picks--2">
                        @foreach (var row in RankedRoster().Where(x => !cast.Take(template.ParticipantRoles.Count).Contains(x.Wrestler)).Take(80))
                        {
                            var w = row.Wrestler;
                            <button class="pick @(extras.Contains(w) ? "is-selected" : "")" @onclick="() => ToggleExtra(w)">
                                <span class="pick__body"><span class="pick__name">@w.RingName</span></span>
                            </button>
                        }
                    </div>
                </div>
            }

            @if (template.UsesDialogue)
            {
                <div class="field mt">
                    <span class="field__label">Dialogue</span>
                    <input class="input" @bind="dialogue" placeholder="Leave blank for a default line" />
                </div>
            }
        </div>
    }
}

@* ── 3. Action editor ─────────────────────────────────────────────────── *@
@if (step == 2 && segment is not null)
{
    <div class="panel">
        <div class="panel__title">
            @segment.Name
            <span class="spacer"></span>
            <span class="small muted">~@segment.DurationMinutes min</span>
        </div>

        <div class="row small">
            <span class="badge">@segment.Type</span>
            <span class="badge">@segment.Location @Shown.Factor(LocationMultiplier(segment.Location))</span>
        </div>

        @* The three things a promo asks (docs/gimmick-plan.md Part 3). No form is safer or
           better by rule: what each gets depends on the writers and on these people, and the
           read below says which. *@
        <div class="mt">
            <div class="small muted">How much is written</div>
            <div class="row">
                @foreach (var form in Enum.GetValues<PromoForm>())
                {
                    var f = form;
                    <button class="chip @(segment.Form == f ? "is-active" : "")" @onclick="() => segment.Form = f">@Promos.Name(f)</button>
                }
            </div>
            <div class="small muted mt">What it asks of them physically</div>
            <div class="row">
                <button class="chip @(segment.Staging is null ? "is-active" : "")" @onclick="() => segment.Staging = null">as the segment goes (@Promos.Name(Promos.StagingOf(new SegmentModel("", segment.Type, segment.Location, true))))</button>
                @foreach (var staging in Enum.GetValues<PromoStaging>())
                {
                    var st = staging;
                    <button class="chip @(segment.Staging == st ? "is-active" : "")" @onclick="() => segment.Staging = st">@Promos.Name(st)</button>
                }
            </div>
            <div class="small muted mt">What it should make the crowd feel</div>
            <div class="row">
                <button class="chip @(segment.Register is null ? "is-active" : "")" @onclick="() => segment.Register = null">each in their own note</button>
                @foreach (var register in Enum.GetValues<PromoRegister>())
                {
                    var rg = register;
                    <button class="chip @(segment.Register == rg ? "is-active" : "")" @onclick="() => segment.Register = rg">@Promos.Name(rg)</button>
                }
            </div>
        </div>

        @if (Speakers.Count > 0)
        {
            <div class="notice notice--info mt">
                @foreach (var w in Speakers)
                {
                    var register = Promos.RegisterFor(segment, w);
                    var reading = Promos.Read(w, segment.Form, Promos.StagingOf(segment), register, Promos.Writing(Creative));
                    <div>@Promos.Expect(w, segment.Form, Promos.StagingOf(segment), register, reading)</div>
                    @if (State.Career?.NotedForm(w, register) is { } noted && noted != segment.Form)
                    {
                        <div class="small muted">
                            Your note on @w.RingName says @Promos.Name(noted) for this.
                            <button class="btn btn--sm btn--ghost" @onclick="() => segment.Form = noted">Use it</button>
                        </div>
                    }
                }
                @if (segment.Form != PromoForm.Free)
                {
                    <div class="small muted">Written by @Promos.CreativeWords(Creative).ToLowerInvariant() (level @Creative).</div>
                }
            </div>
        }

        @* A turn, or a tease toward one (docs/gimmick-plan.md Part 5). The alignment is the
           booker's to change; what it is worth — the crowd, the moment, the build, how
           often — is forecast here before it is booked. *@
        <div class="mt">
            <div class="small muted">Turn somebody</div>
            <div class="row">
                <select class="input input--sm" value="@(segment.Turn?.Who.Id ?? "")" @onchange="e => SetMove(e.Value?.ToString(), turn: true)">
                    <option value="">nobody</option>
                    @foreach (var w in segment.Participants) { <option value="@w.Id">@w.RingName</option> }
                </select>
                @if (segment.Turn is { } turn)
                {
                    <select class="input input--sm" value="@turn.To" @onchange="e => segment.Turn = turn with { To = Enum.Parse<Alignment>(e.Value!.ToString()!) }">
                        @foreach (var a in Enum.GetValues<Alignment>().Where(a => a != turn.Who.Gimmick?.NaturalAlignment)) { <option value="@a">to @Turns.Label(a)</option> }
                    </select>
                }
            </div>
            @if (segment.Turn is { } booked && booked.Who.Gimmick?.NaturalAlignment != booked.To)
            {
                var forecast = Turns.Forecast(booked.Who, booked.To, Kind, Today);
                <div class="notice notice--info mt">
                    <strong>@booked.Who.RingName turning @Turns.Label(booked.To): @Turns.Words(forecast.Payoff).</strong>
                    @foreach (var why in forecast.Because) { <div class="small">@why</div> }
                </div>
            }
            <div class="small muted mt">Or tease one — something the other side would do</div>
            <div class="row">
                <select class="input input--sm" value="@(segment.Tease?.Who.Id ?? "")" @onchange="e => SetMove(e.Value?.ToString(), turn: false)">
                    <option value="">nobody</option>
                    @foreach (var w in segment.Participants) { <option value="@w.Id">@w.RingName</option> }
                </select>
                @if (segment.Tease is { } tease)
                {
                    <span class="small">toward @Turns.Label(tease.To)</span>
                }
            </div>
            @if (segment.Tease is { } te && Turns.AnticipationWords(te.Who) is { } building)
            {
                <div class="small muted">@building</div>
            }
        </div>

        <div class="row mt small">
            <span class="muted">Cast:</span>
            @foreach (var w in segment.Participants)
            {
                <span class="badge">@w.RingName</span>
            }
        </div>

        @if (segment.HistoryTags.Count > 0)
        {
            <div class="row mt small">
                <span class="muted">Marks the feud with:</span>
                @foreach (var tag in segment.HistoryTags)
                {
                    <span class="badge badge--cyan">@tag.Label()</span>
                }
            </div>
        }
    </div>

    <div class="panel">
        <div class="panel__title">Run sheet <span class="spacer"></span><span class="small muted">@segment.Actions.Count actions</span></div>

        @if (segment.Actions.Count == 0)
        {
            <div class="empty">Nothing happens yet — add an action below.</div>
        }

        @foreach (var action in segment.Actions)
        {
            var i = segment.Actions.IndexOf(action);
            <div class="editor-row">
                <div class="editor-row__n">@(i + 1)</div>
                <div>
                    <div class="editor-row__name">@(string.IsNullOrWhiteSpace(action.Label) ? action.ActionType.ToString() : action.Label)</div>
                    <div class="editor-row__sub">
                        @action.ActionType
                        @if (action.HeatImpact > 0)
                        {
                            <text> · +@action.HeatImpact.ToString("0.#") heat</text>
                        }
                    </div>
                    @if (action.ActionType is SegmentActionType.Talk or SegmentActionType.Interrupt)
                    {
                        <input class="input" style="margin-top:6px;font-size:13px"
                               value="@action.Dialogue"
                               @onchange="e => SetDialogue(action, e.Value?.ToString())"
                               placeholder="Dialogue (optional)" />
                    }
                </div>
                <div class="editor-row__tools">
                    <select class="inline-select" value="@action.Performer?.RealName"
                            @onchange="e => SetPerformer(action, e.Value?.ToString())">
                        @foreach (var w in segment.Participants)
                        {
                            <option value="@w.RealName">@w.RingName</option>
                        }
                    </select>

                    @if (action.RequiresTarget)
                    {
                        <select class="inline-select" value="@action.Target?.RealName"
                                @onchange="e => SetTarget(action, e.Value?.ToString())">
                            <option value="">— target —</option>
                            @foreach (var w in segment.Participants.Where(x => x != action.Performer))
                            {
                                <option value="@w.RealName">@w.RingName</option>
                            }
                        </select>
                    }

                    <button class="btn btn--icon btn--ghost" disabled="@(i == 0)"
                            title="Move up" @onclick="() => MoveAction(i, -1)"><Icon Name="up" /></button>
                    <button class="btn btn--icon btn--ghost" disabled="@(i == segment.Actions.Count - 1)"
                            title="Move down" @onclick="() => MoveAction(i, 1)"><Icon Name="down" /></button>
                    <button class="btn btn--icon btn--danger" title="Remove"
                            @onclick="() => segment.Actions.Remove(action)"><Icon Name="close" /></button>
                </div>
            </div>
        }

        <div class="row mt">
            <button class="btn" @onclick="() => showAddAction = !showAddAction">
                @(showAddAction ? "Close action library" : "+ Add an action")
            </button>
        </div>

        @if (showAddAction)
        {
            <div class="panel panel--flat mt">
                @foreach (var category in SegmentActionLibrary.Categories)
                {
                    <div class="group-label">@category</div>
                    <div class="picks">
                        @foreach (var t in SegmentActionLibrary.ByCategory(category))
                        {
                            var blocked = t.RequiresTarget && segment.Participants.Count < 2;
                            <button class="pick" disabled="@blocked" @onclick="() => AddAction(t)">
                                <span class="pick__body">
                                    <span class="pick__name">
                                        @t.Name
                                        @if (blocked) { <span class="badge badge--heel">needs two people</span> }
                                    </span>
                                    <span class="pick__desc">@t.Description</span>
                                    @if (!string.IsNullOrWhiteSpace(t.BookerTip))
                                    {
                                        <span class="pick__desc gold">ⓘ @t.BookerTip</span>
                                    }
                                </span>
                                <span class="pick__meta">
                                    impact @t.BaseImpact.ToString("0.#")<br />heat @t.Heat.ToString("0.#")
                                </span>
                            </button>
                        }
                    </div>
                }
            </div>
        }
    </div>

    @if (errors.Count > 0)
    {
        <div class="notice notice--error">
            <strong>This segment will not run:</strong>
            <ul>@foreach (var e in errors) { <li>@e</li> }</ul>
        </div>
    }
}

@* ── Wizard controls ──────────────────────────────────────────────────── *@
<div class="wizard-bar wizard-bar--sticky">
    <button class="btn btn--ghost" @onclick="Back">@(step == 0 ? "← Cancel" : "← Back")</button>
    <span class="wizard-bar__spacer"></span>
    @if (step < 2)
    {
        <button class="btn btn--primary" disabled="@(!CanAdvance)" @onclick="Next">Next →</button>
    }
    else
    {
        <button class="btn btn--primary" @onclick="Finish">@ConfirmLabel</button>
    }
</div>

@code {
    [Parameter, EditorRequired] public EventCallback<SegmentModel> OnDone { get; set; }
    [Parameter] public EventCallback OnCancel { get; set; }
    [Parameter] public string ConfirmLabel { get; set; } = "Run the segment ★";

    private static readonly (int Index, string Label)[] StepLabels =
    [
        (0, "Type"), (1, "Cast"), (2, "Actions")
    ];

    private int step;
    private SegmentTemplate? template;
    private bool isCustom;

    private readonly List<Wrestler> cast = new();

    private string castQuery = "";
    private Division? castDivision;

    /// <summary>Whether the other brands' rosters are on offer. Off by default on a brand show.</summary>
    private bool includeCrossover;

    /// <summary>Roster narrowed by the search box, division chips and brand, most over first.</summary>
    /// <summary>
    /// The cast list, ranked the way the match builder ranks a corner.
    ///
    /// This was `OrderByDescending(Overness)` — the same thing every roster list in the app
    /// used to do, and the reason `BookingSuggestions` exists. A promo is *about* a story, so
    /// offering names by popularity on the screen where a story is being told is the worst
    /// place in the game to do it: the person the segment should be with is whoever the cast
    /// already has heat with, and the game knows exactly who that is.
    ///
    /// `against` is whoever is already in the segment. Not literally opposed — a cast can be
    /// allies — but it is the same question the ranking answers either way: who has something
    /// going on with these people.
    /// </summary>
    private IReadOnlyList<BookingSuggestions.Suggestion> RankedRoster() =>
        BookingSuggestions.Rank(
            State.Bookable
                 .Where(w => includeCrossover || !State.IsCrossover(w))
                 .Where(w => castDivision is null || w.Division == castDivision)
                 .Where(w => string.IsNullOrWhiteSpace(castQuery)
                          || (w.RingName?.Contains(castQuery, StringComparison.OrdinalIgnoreCase) ?? false)
                          || (w.RealName?.Contains(castQuery, StringComparison.OrdinalIgnoreCase) ?? false)),
            cast, State.FeudBook,
            // No "already booked" marker, deliberately. In the match picker that band sinks a
            // name to the bottom of the list and tapping it *swaps* two slots, so moving it is
            // harmless. A segment cast is a toggle list: marking a chosen name would drop it
            // to the foot of seventy rows the instant it was picked, and taking somebody back
            // out would mean scrolling to find them. `is-selected` already carries the state,
            // and it carries it where the name is.
            _ => null,
            State.StandingPartnerOf, State.RecentlyBooked,
            State.Career?.CurrentDate);
    private readonly List<Wrestler> extras = new();
    private string dialogue = "";

    private string customName = "";
    private SegmentType customType = SegmentType.Promo;
    private SegmentLocation customLocation = SegmentLocation.Ring;

    private SegmentModel? segment;
    private bool showAddAction;
    private List<string> errors = new();

    private bool CanAdvance => step switch
    {
        0 => template is not null || isCustom,
        1 => isCustom
                ? cast.Count > 0
                : template is not null && Enumerable.Range(0, template.ParticipantRoles.Count).All(i => RoleAt(i) is not null),
        _ => true
    };

    // ── Navigation ───────────────────────────────────────────────────────

    private async Task Next()
    {
        if (step == 1) BuildSegment();
        step++;
        await Scroll.ToTopAsync();
    }

    private async Task Back()
    {
        if (step == 0)
        {
            await OnCancel.InvokeAsync();
            return;
        }
        step--;
        await Scroll.ToTopAsync();
    }

    private void PickTemplate(SegmentTemplate t)
    {
        template = t;
        isCustom = false;
        cast.Clear();
        extras.Clear();
    }

    private void PickCustom()
    {
        isCustom = true;
        template = null;
        cast.Clear();
        extras.Clear();
    }

    // ── Casting ──────────────────────────────────────────────────────────

    private Wrestler? RoleAt(int index) => index < cast.Count ? cast[index] : null;

    private bool IsAvailableFor(Wrestler w, int roleIndex)
    {
        for (int i = 0; i < cast.Count; i++)
            if (i != roleIndex && cast[i] == w) return false;
        return !extras.Contains(w);
    }

    private void AssignRole(int index, Wrestler w)
    {
        while (cast.Count <= index) cast.Add(null!);
        cast[index] = w;
    }

    private void ToggleExtra(Wrestler w)
    {
        if (!extras.Remove(w)) extras.Add(w);
    }

    private void ToggleCast(Wrestler w)
    {
        if (!cast.Remove(w)) cast.Add(w);
    }

    private void BuildSegment()
    {
        if (isCustom)
        {
            segment = new SegmentModel(
                string.IsNullOrWhiteSpace(customName) ? $"{customType} Segment" : customName,
                customType, customLocation, isScripted: true);

            foreach (var w in cast) segment.AddParticipant(w);
        }
        else if (template is not null)
        {
            var roster = cast.Take(template.ParticipantRoles.Count).Concat(extras).ToList();
            segment = template.Create(roster, dialogue);
        }
    }

    // ── Action editing ───────────────────────────────────────────────────

    private void AddAction(SegmentActionTemplate t)
    {
        if (segment is null) return;

        var performer = segment.Participants.First();
        Wrestler? target = t.RequiresTarget
            ? segment.Participants.FirstOrDefault(x => x != performer)
            : null;

        segment.AddAction(t.ToAction(performer, target));

        if (t.HistoryTag.HasValue && !segment.HistoryTags.Contains(t.HistoryTag.Value))
            segment.HistoryTags.Add(t.HistoryTag.Value);

        // Deliberately left open — see MatchBuilder.AddBeat.
    }

    private void SetPerformer(SegmentAction action, string? realName)
    {
        var w = segment?.Participants.FirstOrDefault(x => x.RealName == realName);
        if (w is null) return;

        action.Performer = w;
        if (action.Target == w) action.Target = null;
    }

    private void SetTarget(SegmentAction action, string? realName)
    {
        action.Target = segment?.Participants.FirstOrDefault(x => x.RealName == realName);
    }

    private static void SetDialogue(SegmentAction action, string? value) =>
        action.Dialogue = value ?? "";

    private void MoveAction(int index, int direction)
    {
        if (segment is null) return;
        int to = index + direction;
        if (to < 0 || to >= segment.Actions.Count) return;
        (segment.Actions[index], segment.Actions[to]) = (segment.Actions[to], segment.Actions[index]);
    }

    // ── Finish ───────────────────────────────────────────────────────────

    private async Task Finish()
    {
        if (segment is null) return;

        errors = segment.Validate();
        if (errors.Count > 0) return;

        await OnDone.InvokeAsync(segment);
    }

    /// <summary>Mirrors SegmentSimulator.LocationModifier so the UI can show the trade-off.</summary>
    internal static double LocationMultiplier(SegmentLocation location) => location switch
    {
        SegmentLocation.Ring       => 1.00,
        SegmentLocation.Crowd      => 1.10,
        SegmentLocation.ParkingLot => 0.90,
        SegmentLocation.Backstage  => 0.85,
        SegmentLocation.GMOffice   => 0.80,
        _                          => 1.00
    };

    /// <summary>Everybody who talks in this segment, in order.</summary>
    private List<Wrestler> Speakers =>
        segment is null ? [] : segment.Actions
            .Where(a => a.ActionType is SegmentActionType.Talk or SegmentActionType.Interrupt && a.Performer is not null)
            .Select(a => a.Performer).Distinct().ToList();

    /// <summary>The promotion's creative team; exhibition writes at an ordinary level.</summary>
    private int Creative => State.Career is { } c ? Promos.CreativeOf(c.Promotion) : 5;

    /// <summary>The kind of show this segment is for — a turn on a premium event is a bigger moment.</summary>
    [Parameter] public ShowType Kind { get; set; } = ShowType.Television;

    private DateOnly Today => State.Career?.CurrentDate ?? DateOnly.FromDateTime(DateTime.Today);

    /// <summary>Sets who the segment turns or teases; the direction is the other side from where they stand.</summary>
    private void SetMove(string? id, bool turn)
    {
        if (segment is null) return;
        var w = segment.Participants.FirstOrDefault(p => p.Id == id);
        AlignmentMove? move = w is null ? null
            : new AlignmentMove(w, w.Gimmick?.NaturalAlignment == Alignment.Heel ? Alignment.Face : Alignment.Heel);
        if (turn) segment.Turn = move; else segment.Tease = move;
    }
}
