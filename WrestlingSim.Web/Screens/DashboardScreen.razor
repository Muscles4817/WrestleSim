@using WrestlingSim.Enums
@using WrestlingSim.Models.World
@inherits StateComponent

@if (State.Career is not { } career)
{
    <div class="empty"><div class="empty__mark"><Icon Name="star" /></div>No career loaded.</div>
}
else
{
    <div class="screen__head">
        <div class="screen__eyebrow">@career.Promotion.TierLabel</div>
        <h1 class="screen__title">@career.Promotion.Name</h1>
    </div>

    @if (State.SaveMessage is { } message)
    {
        <div class="notice notice--warn">
            @message
            <span class="spacer"></span>
            <button class="btn btn--sm btn--ghost" @onclick="State.ClearMessage">Dismiss</button>
        </div>
    }

    @* ── What needs doing ────────────────────────────────────────────────── *@
    @if (career.Due.FirstOrDefault() is { } due)
    {
        <div class="notice notice--warn">
            <strong>@due.Name is today@(due.Date < career.CurrentDate ? " (overdue)" : "").</strong>
            The clock will not move until you run it or take it off the calendar.
            <span class="spacer"></span>
            <button class="btn btn--sm btn--primary" @onclick="() => State.OpenShow(due)">
                @(due.IsBooked ? "Open the card" : "Book the card")
            </button>
        </div>
    }

    <div class="tiles">
        @* Next show *@
        <div class="tile tile--static">
            <div class="tile__key">NEXT</div>
            @if (career.NextShow is { } next)
            {
                <div class="tile__name">@next.Name</div>
                <div class="tile__desc">
                    @next.TypeLabel · @next.Date.ToString("ddd d MMM")
                    @if (career.DaysUntil(next) > 0)
                    {
                        <text> · in @career.DaysUntil(next) day@(career.DaysUntil(next) == 1 ? "" : "s")</text>
                    }
                    <br />
                    @if (next.IsBooked)
                    {
                        <text>@next.Card.Count item@(next.Card.Count == 1 ? "" : "s") booked · @next.BookedMinutes / @next.RuntimeMinutes min</text>
                    }
                    else
                    {
                        <text>Nothing booked yet.</text>
                    }
                </div>
                <div class="row mt">
                    <button class="btn btn--sm btn--primary" @onclick="() => State.OpenShow(next)">
                        @(next.IsBooked ? "Open the card" : "Book the card")
                    </button>
                </div>
            }
            else
            {
                <div class="tile__name">Nothing scheduled</div>
                <div class="tile__desc">The calendar is empty. Put a show on it.</div>
                <div class="row mt">
                    <button class="btn btn--sm" @onclick="() => State.Go(Screen.Calendar)">Open the calendar</button>
                </div>
            }
        </div>

        @* Time *@
        <div class="tile tile--static">
            <div class="tile__key">TIME</div>
            <div class="tile__name">@career.CurrentDate.ToString("d MMM yyyy")</div>
            <div class="tile__desc">
                @if (career.HasShowDue)
                {
                    <text>A show is due. Time is held until it is dealt with.</text>
                }
                else
                {
                    <text>Advance the clock. Nothing ages until you do.</text>
                }
            </div>
            <div class="row mt">
                <button class="btn btn--sm" disabled="@career.HasShowDue" @onclick="() => State.AdvanceAsync(1)">+1 day</button>
                <button class="btn btn--sm" disabled="@career.HasShowDue" @onclick="() => State.AdvanceAsync(7)">+1 week</button>
                <button class="btn btn--sm btn--primary" disabled="@(career.HasShowDue || career.NextShow is null)"
                        @onclick="State.AdvanceToNextShowAsync">
                    To next show
                </button>
            </div>
        </div>

        @* The books. Cash is what the cards sold; reputation is what the shows were worth, and
           it is what the next card sells on. Cash can go negative — nothing stops a career in
           the red yet, so the tile says so instead. *@
        <div class="tile tile--static">
            <div class="tile__key">BOOKS</div>
            <div class="tile__name tabnum @(career.Books.InTheRed ? "grade--poor" : "")">
                @Money.Format(career.Books.Cash)
            </div>
            <div class="tile__desc">
                @if (career.Books.InTheRed)
                {
                    <strong class="grade--poor">In the red.</strong>
                    <text> Nothing stops a promotion that cannot pay yet — but the cards have to start selling.</text>
                    <br />
                }
                @Money.Signed(career.Books.Cash - career.Books.OpeningCash) since the books opened ·
                the office costs @Money.Format(career.DailyOverhead) a day
                @if (career.DailyPayroll > 0)
                {
                    <text> and the guarantees @Money.Format(career.DailyPayroll)</text>
                }.
                <br />
                Reputation @career.Books.Reputation.ToString("F1") — what the next card sells on.
            </div>
            @if (RecentNights(career).ToList() is { Count: > 0 } nights)
            {
                <div class="mt small">
                    @foreach (var (night, books) in nights)
                    {
                        <div class="row" style="padding:2px 0">
                            <span>@night.Name <span class="muted">· @night.Date.ToString("d MMM")</span></span>
                            <span class="spacer"></span>
                            @if (books.HadCard)
                            {
                                <span class="tabnum muted">@Money.Percent(books.Fill)</span>
                                <span>&nbsp;</span>
                            }
                            <span class="tabnum @Money.Tone(books.Net)">@Money.Signed(books.Net)</span>
                        </div>
                    }
                </div>
            }
        </div>

        @* The split *@
        @if (career.Brands.Active)
        {
            <div class="tile tile--static">
                <div class="tile__key">SPLIT</div>
                <div class="tile__name">
                    @career.Brands.Integrity.ToString("F0") integrity
                    <span class="muted small">/ @career.Brands.Ceiling.ToString("F0") ceiling</span>
                </div>
                <div class="tile__desc">
                    @BrandIntegrity.Phase(career.Brands.Integrity).
                    @career.Brands.CrossoverCount crossover@(career.Brands.CrossoverCount == 1 ? "" : "s") booked.
                    @if (career.Brands.Brands.FirstOrDefault(b => BrandIntegrity.IsSecondary(b, career.Brands)) is { } weak)
                    {
                        <text><br />@weak.Name is rating as the B-show.</text>
                    }
                </div>
                <div class="row mt">
                    <button class="btn btn--sm" @onclick="() => State.Go(Screen.Brands)">Brands</button>
                    @if (Draft.IsDue(career.Brands, career.CurrentDate))
                    {
                        <button class="btn btn--sm btn--primary" @onclick="() => State.Go(Screen.Brands)">
                            Draft due
                        </button>
                    }
                </div>
            </div>
        }

        @* The television deal. The fee is fixed for the term; what the episodes draw decides
           the next one, so the tile leads with what the deal would renew at today — the
           number the booking is actually moving. Doc 08 §3. *@
        @if (career.Television is { } deal)
        {
            var tier = career.Promotion.Tier;
            var multiple = Television.RenewalMultiple(deal, tier);
            var index = Television.AudienceIndex(deal, tier);
            <div class="tile tile--static">
                <div class="tile__key">
                    TV DEAL
                    @if (deal.InRenewalWindow(career.CurrentDate))
                    {
                        <span class="badge badge--gold badge--sm">final year — counts double</span>
                    }
                </div>
                <div class="tile__name tabnum">@Money.Format(deal.FeePerEpisode) <span class="muted small">an episode</span></div>
                <div class="tile__desc">
                    Fixed until @deal.End.ToString("d MMM yyyy") · @deal.DaysLeft(career.CurrentDate) days left.
                    <br />
                    @if (deal.Episodes.Count == 0)
                    {
                        <text>No episodes this term yet. The network is paying for television nobody has made.</text>
                    }
                    else
                    {
                        <text>
                            Averaging @Money.Audience((int)deal.Episodes.Average(e => e.Viewers))
                            over @deal.Episodes.Count episode@(deal.Episodes.Count == 1 ? "" : "s"),
                            against @Money.Audience(Television.BaselineViewers(tier)) for a typical card
                            (@Money.Percent(index) weighted).
                        </text>
                    }
                </div>
                <div class="mt small">
                    If it renewed today:
                    <strong class="tabnum @(multiple >= 1 ? "grade--great" : "grade--poor")">
                        ×@multiple.ToString("0.00") → @Money.Format(Television.RenewedFee(deal.FeePerEpisode, multiple))
                    </strong>
                    @* Only a real swing. A ±10% week-to-week wobble is what television does and
                       costs about 3%; flagging it told the booker something was wrong when
                       nothing was. *@
                    @if (Television.Consistency(deal) < 0.93)
                    {
                        <div class="muted">The audience is swinging — the network pays less for a number it cannot sell against.</div>
                    }
                </div>
                @if (career.LastRenewal is { } last)
                {
                    <div class="mt small muted">
                        Last renewed @last.End.ToString("MMM yyyy") at ×@last.RenewedAt.ToString("0.00"),
                        on @Money.Audience(last.AverageViewers) a week.
                    </div>
                }
            </div>
        }

        @* Roster *@
        <div class="tile tile--static">
            <div class="tile__key">ROSTER</div>
            <div class="tile__name">@career.Contracts.Count @(career.CanSign ? "signed" : "regulars")</div>
            @if (career.CanSign && career.ExpiringWithin(TalentMarket.ExpiryWarningDays).ToList() is { Count: > 0 } expiring)
            {
                <div class="small grade--poor">
                    <Icon Name="warn" /> @expiring.Count deal@(expiring.Count == 1 ? "" : "s") run@(expiring.Count == 1 ? "s" : "") out within @TalentMarket.ExpiryWarningDays days
                </div>
            }
            <div class="tile__desc">
                Top of the card: @string.Join(", ", career.RosterByOverness.Take(3).Select(w => w.RingName))
            </div>
            @if (Movers(career).Any())
            {
                <div class="mt small">
                    @foreach (var w in Movers(career))
                    {
                        <div class="row" style="padding:2px 0">
                            <span>@w.RingName</span>
                            <span class="spacer"></span>
                            <span class="tabnum @w.CardPosition.Tone()">@w.OvernessDisplay</span>
                            <Trend Momentum="w.Momentum" />
                        </div>
                    }
                </div>
            }
            <div class="row mt">
                <button class="btn btn--sm" @onclick="() => State.Go(Screen.Roster)">View roster</button>
                <button class="btn btn--sm" @onclick="() => State.Go(Screen.Contracts)">Contracts</button>
            </div>
        </div>
    </div>

    @* ── Championships ───────────────────────────────────────────────────── *@
    <div class="panel mt-2">
        <div class="panel__title">
            Championships
            <span class="spacer"></span>
            <button class="btn btn--sm btn--ghost" @onclick="() => State.Go(Screen.Titles)">View all</button>
        </div>

        @foreach (var title in career.Titles.ByPrestige)
        {
            <div class="editor-row">
                <div class="editor-row__n"><Icon Name="@(title.IsVacant ? "vacant" : "star")" /></div>
                <div>
                    <div class="editor-row__name">
                        @(title.CurrentReign?.ChampionName ?? "Vacant")
                    </div>
                    <div class="editor-row__sub">
                        @title.Name
                        @if (title.CurrentReign is { } reign)
                        {
                            <text>
                                · @reign.LengthLabel(career.CurrentDate) ·
                                @reign.Defences defence@(reign.Defences == 1 ? "" : "s")
                            </text>
                        }
                    </div>
                </div>
                <div class="editor-row__tools">
                    <strong class="tabnum gold">@title.Prestige.ToString("F0")</strong>
                </div>
            </div>
        }

        @if (career.Titles.Dilution < 1)
        {
            <p class="small muted mt">
                @career.Titles.Active.Count belts are competing for an audience that has room
                for fewer. Each is worth @((100 - career.Titles.Dilution * 100).ToString("F0"))%
                less than it has earned.
            </p>
        }
    </div>

    @* ── Feuds ───────────────────────────────────────────────────────────── *@
    <div class="panel mt-2">
        <div class="panel__title">
            Live feuds
            <span class="spacer"></span>
            @if (State.ActiveFeudCount > 0)
            {
                <button class="btn btn--sm btn--ghost" @onclick="() => State.Go(Screen.Feuds)">View all</button>
            }
        </div>

        @if (State.ActiveFeudCount == 0)
        {
            <div class="empty">
                <div class="empty__mark"><Icon Name="close" /></div>
                Nobody has any history yet. Book a segment on your next show — a betrayal or a
                beatdown generates the most heat — and the rivalry will show up here.
            </div>
        }
        else
        {
            @foreach (var feud in State.FeudBook.All.Take(4))
            {
                <div class="feud">
                    <div class="feud__top">
                        <span class="feud__names">
                            @feud.WrestlerA.RingName <span class="faint">vs</span> @feud.WrestlerB.RingName
                        </span>
                        <span class="badge @FeudUpdates.IntensityBadge(feud.Intensity)">@feud.Intensity</span>
                        <span class="spacer"></span>
                        <span class="small muted">@feud.MatchCount match@(feud.MatchCount == 1 ? "" : "es")</span>
                    </div>
                    <Meter Label="Heat" Value="@feud.Heat" Max="50" ValueText="@($"{feud.Heat:F0} / 50")" />
                </div>
            }
        }
    </div>

    @* ── Recent shows ────────────────────────────────────────────────────── *@
    @if (career.Completed.Any())
    {
        <div class="panel">
            <div class="panel__title">
                Recent shows
                <span class="spacer"></span>
                <button class="btn btn--sm btn--ghost" @onclick="() => State.Go(Screen.Calendar)">Calendar</button>
            </div>

            @foreach (var show in career.Completed.Take(5))
            {
                <div class="editor-row">
                    <div class="editor-row__n">★</div>
                    <div>
                        <div class="editor-row__name">@show.Name</div>
                        <div class="editor-row__sub">
                            @show.TypeLabel · @show.Date.ToString("d MMM yyyy") · @show.Card.Count items
                        </div>
                    </div>
                    <div class="editor-row__tools">
                        <strong class="tabnum @Grades.OfScore(show.Result!.OverallRating).Tone()">@show.Result!.OverallRating.ToString("F1")</strong>
                        <button class="btn btn--sm btn--ghost" @onclick="() => State.OpenShow(show)">Review</button>
                    </div>
                </div>
            }
        </div>
    }

    @* ── Save controls ───────────────────────────────────────────────────── *@
    <div class="wizard-bar">
        <button class="btn btn--ghost" @onclick="State.ExitToLandingAsync">← Save and exit</button>
        <span class="wizard-bar__spacer"></span>
        <button class="btn btn--sm btn--ghost" @onclick="State.ExportAsync">Export save</button>
        <button class="btn btn--sm" @onclick="State.SaveAsync">Save now</button>
    </div>
}

@code {
}

@code {
    /// <summary>The last few nights that kept books, newest first.</summary>
    private static IEnumerable<(ScheduledShow Night, ShowFinances Books)> RecentNights(Career career) =>
        career.Completed
            .Where(s => s.Result?.Finances is not null)
            .OrderByDescending(s => s.Date)
            .Take(4)
            .Select(s => (s, s.Result!.Finances!));

    /// <summary>
    /// The people whose trend has actually moved, hottest and coldest first. Momentum is
    /// invisible unless it is surfaced, and this is the readout a booker acts on.
    /// </summary>
    private static IEnumerable<WrestlingSim.Models.Wrestler> Movers(WrestlingSim.Models.World.Career career) =>
        career.Roster
            .Where(w => Math.Abs(w.Momentum) >= 6)
            .OrderByDescending(w => Math.Abs(w.Momentum))
            .Take(4);
}
