@*
    Who the promotion has, on what terms, and who it could have. docs/wrestling-reference/10,
    11 and 13.

    Two halves of one question. "Yours" is the roster — guarantees at a television tier,
    regulars below it. "The market" is everybody else in the world, still bookable by the night
    at their asking price; at a television tier this is also where you sign them.

    The number this screen leads with on a contract is the one the booker is actually deciding
    on: what the deal costs against what they would ask today. A wrestler who has got hotter
    since signing is a bargain until the deal runs out — doc 11 §7.1 — and that gap is the whole
    value of having signed them.
*@
@inherits StateComponent

@if (State.Career is not { } career)
{
    <div class="empty">No career open.</div>
}
else
{
    var signing = career.CanSign;

    <div class="screen__head">
        <div class="screen__eyebrow">
            @if (signing)
            {
                <text>@career.Contracts.Count signed · payroll @Money.Format(career.DailyPayroll) a day</text>
            }
            else
            {
                <text>@career.Contracts.Count regulars · everybody works by the night</text>
            }
        </div>
        <h1 class="screen__title">Contracts</h1>
    </div>

    @if (!signing)
    {
        <div class="notice notice--advice">
            Below television nobody is signed — doc 11's indie arrangement. Your regulars are who
            you book most; anybody else in the world can be booked for a night at their price.
            Television brings guarantees.
        </div>
    }

    @if (signing && career.ExpiringWithin(TalentMarket.ExpiryWarningDays).ToList() is { Count: > 0 } expiring)
    {
        <div class="notice notice--warn mt">
            <strong>@expiring.Count deal@(expiring.Count == 1 ? "" : "s") run@(expiring.Count == 1 ? "s" : "") out within @TalentMarket.ExpiryWarningDays days.</strong>
            Re-sign them or they go to the market — still bookable by the night, at their price.
            @foreach (var c in expiring)
            {
                var w = career.FindWrestler(c.WrestlerId);
                if (w is null) continue;
                <div>
                    @w.RingName — @c.End!.Value.ToString("d MMM")
                    · asks @Money.Format(career.GuaranteeAsk(w, offerYears)) a year now
                    @if (career.BestRivalBid(w) is { } rivalBid)
                    {
                        <strong class="grade--poor">
                            · @(career.Rival(rivalBid.Bidder)?.Name ?? "A rival") has offered @Money.Format(rivalBid.Annual) — match it or lose them
                        </strong>
                    }
                    <button class="btn btn--sm btn--ghost" @onclick="() => Offer(w)">Re-sign</button>
                </div>
            }
        </div>
    }

    @if (offering is { } who)
    {
        var ask = career.GuaranteeAsk(who, offerYears);
        var competing = career.BestRivalBid(who);
        var holder = career.SignedTo(who);
        <div class="panel mt offer">
            <div class="panel__title">
                Offer — @who.RingName
                <span class="spacer"></span>
                <button class="btn btn--sm btn--ghost" @onclick="() => offering = null">Close</button>
            </div>
            <div class="small muted">
                Over @who.OvernessDisplay · @Money.Format(career.PerDateAsk(who)) a night on the open market.
                A guarantee covers every appearance; book them more than @TalentMarket.DatesInAGuarantee nights a
                year and it is the cheaper way to pay them — and the rate is fixed for the term, however hot they get.
            </div>
            <div class="chips mt">
                @for (int y = TalentMarket.MinTermYears; y <= TalentMarket.MaxTermYears; y++)
                {
                    var years = y;
                    <button class="chip @(offerYears == years ? "is-active" : "")" @onclick="() => SetYears(who, years)">
                        @years yr — @Money.Format(career.GuaranteeAsk(who, years))
                    </button>
                }
            </div>
            <div class="row mt">
                <label class="field">
                    <span class="field__label">A year</span>
                    <input class="input tabnum" type="number" step="1000" min="0" @bind="offerAnnual" />
                </label>
                <span class="spacer"></span>
                <button class="btn btn--primary" @onclick="() => Sign(who)">Offer @Money.Format(offerAnnual) × @offerYears yr</button>
            </div>
            <div class="small muted mt">
                Asking @Money.Format(ask) a year for @offerYears year@(offerYears == 1 ? "" : "s").
                @if (holder is not null)
                {
                    <text>Signed to @holder.Name until @holder.ContractOf(who)!.End!.Value.ToString("d MMM yyyy") — an offer now is lodged, and they choose between it and @(holder.Name)'s when that deal ends.</text>
                }
                else if (competing is not null)
                {
                    <strong class="grade--poor">@(career.Rival(competing.Bidder)?.Name) has offered @Money.Format(competing.Annual) a year. Match it or lose them when the deal ends.</strong>
                }
                else
                {
                    <text>Nobody signs for less — and with no rival bidding, nobody holds out for more.</text>
                }
            </div>
            @if (refusal is not null)
            {
                <div class="notice @(lodged ? "notice--advice" : "notice--error") mt">@refusal</div>
            }
        </div>
    }

    <div class="searchbar mt">
        <input class="input" type="search" placeholder="Search…"
               value="@query" @oninput="e => query = e.Value?.ToString() ?? string.Empty" />
        <div class="chips">
            <button class="chip @(!market ? "is-active" : "")" @onclick="() => market = false">Yours</button>
            <button class="chip @(market ? "is-active" : "")" @onclick="() => market = true">The market</button>
        </div>
    </div>

    <div class="panel">
        @if (!market)
        {
            var rows = career.Contracts
                .Select(c => (Contract: c, Wrestler: career.FindWrestler(c.WrestlerId)))
                .Where(x => x.Wrestler is not null && Matches(x.Wrestler!))
                .Select(x => (x.Contract, Wrestler: x.Wrestler!))
                .OrderByDescending(x => x.Contract.AnnualGuarantee)
                .ThenByDescending(x => x.Wrestler!.EffectiveOverness)
                .ToList();

            @if (rows.Count == 0)
            {
                <div class="empty">Nobody here yet. Sign somebody from the market.</div>
            }
            @foreach (var (c, w) in rows)
            {
                <div class="editor-row">
                    <div class="editor-row__n"><Portrait Wrestler="@w" /></div>
                    <div>
                        <div class="editor-row__name">
                            @w.RingName
                            <span class="tabnum small @w.CardPosition.Tone()">@w.OvernessDisplay</span>
                        </div>
                        <div class="editor-row__sub">
                            @if (c.IsGuaranteed)
                            {
                                var now = TalentMarket.WorthToday(w, c, career.WageFactor);
                                <text>@Money.Format(c.AnnualGuarantee) a year · until @c.End!.Value.ToString("d MMM yyyy")</text>
                                @if (c.DaysTolled > 0) { <text> · extended @c.DaysTolled days for injury</text> }
                                <br />
                                <span class="@(now > c.AnnualGuarantee ? "grade--great" : now < c.AnnualGuarantee ? "grade--poor" : "")">
                                    Would ask @Money.Format(now) today
                                    @(now > c.AnnualGuarantee ? "— a bargain while it lasts" : now < c.AnnualGuarantee ? "— paying over the odds" : "")
                                </span>
                            }
                            else
                            {
                                <text>Regular · @Money.Format(career.PerDateAsk(w)) a night when booked</text>
                            }
                        </div>
                    </div>
                    <div class="editor-row__tools">
                        @if (c.IsGuaranteed)
                        {
                            <button class="btn btn--sm" @onclick="() => Offer(w)">Re-sign</button>
                            var payout = Math.Round(c.DailyCost * Math.Min(TalentMarket.ReleasePayoutDays, c.DaysLeft(career.CurrentDate) ?? 0));
                            <button class="btn btn--sm btn--ghost" title="Pays out @Money.Format(payout)" @onclick="() => Release(w)">
                                Release (@Money.Format(payout))
                            </button>
                        }
                        else
                        {
                            <button class="btn btn--sm btn--ghost" @onclick="() => Release(w)">Drop</button>
                        }
                    </div>
                </div>
            }
        }
        else
        {
            var free = career.Roster
                .Where(w => career.ContractOf(w) is null && Matches(w))
                .OrderBy(w => career.Unavailable(w) is null ? 0 : 1)
                .ThenByDescending(w => w.EffectiveOverness)
                .ToList();

            @if (free.Count == 0)
            {
                <div class="empty">Nobody on the market matches.</div>
            }
            @foreach (var w in free)
            {
                <div class="editor-row">
                    <div class="editor-row__n"><Portrait Wrestler="@w" /></div>
                    <div>
                        <div class="editor-row__name">
                            @w.RingName
                            <span class="tabnum small @w.CardPosition.Tone()">@w.OvernessDisplay</span>
                            <Trend Momentum="w.Momentum" ShowLabel="false" />
                        </div>
                        <div class="editor-row__sub">
                            @if (career.SignedTo(w) is { } holderOf)
                            {
                                var theirs = holderOf.ContractOf(w)!;
                                <span class="badge badge--sm badge--muted">@holderOf.Name</span>
                                <text> until @theirs.End!.Value.ToString("d MMM yyyy")</text>
                                @if (career.PlayerBid(w) is { } mine)
                                {
                                    <text> · your offer of @Money.Format(mine.Annual) is lodged</text>
                                }
                            }
                            else if (career.NonCompeteOf(w) is { } nc)
                            {
                                <span class="badge badge--sm badge--muted">non-compete</span>
                                <text> until @nc.Until.ToString("d MMM")</text>
                            }
                            else
                            {
                                @Money.Format(career.PerDateAsk(w)) <text> a night</text>
                                @if (signing)
                                {
                                    <text> · @Money.Format(career.GuaranteeAsk(w, 3)) a year on three</text>
                                }
                            }
                        </div>
                    </div>
                    <div class="editor-row__tools">
                        @if (career.NonCompeteOf(w) is not null)
                        {
                        }
                        else if (career.SignedTo(w) is { } h)
                        {
                            @if (signing && (h.ContractOf(w)!.DaysLeft(career.CurrentDate) ?? int.MaxValue) <= TalentMarket.ExpiryWarningDays)
                            {
                                <button class="btn btn--sm btn--primary" @onclick="() => Offer(w)">Make an offer</button>
                            }
                        }
                        else if (signing)
                        {
                            <button class="btn btn--sm btn--primary" @onclick="() => Offer(w)">Make an offer</button>
                        }
                        else
                        {
                            <button class="btn btn--sm" @onclick="() => State.MakeRegularAsync(w)">Make a regular</button>
                        }
                    </div>
                </div>
            }
        }
    </div>

    @if (career.ContractLog.Count > 0)
    {
        <div class="panel">
            <div class="panel__title">Lately</div>
            @foreach (var e in career.ContractLog.AsEnumerable().Reverse().Take(8))
            {
                <div class="small" style="padding:3px 0">
                    <span class="muted tabnum">@e.Date.ToString("d MMM")</span>
                    @(career.FindWrestler(e.WrestlerId)?.RingName ?? e.WrestlerId) — @e.What
                </div>
            }
        </div>
    }

    <div class="wizard-bar">
        <button class="btn btn--ghost" @onclick="() => State.Go(Screen.Roster)">← Roster</button>
        <span class="wizard-bar__spacer"></span>
        <button class="btn btn--ghost" @onclick="() => State.Go(Screen.Dashboard)">Dashboard</button>
    </div>
}

@code {
    private string query = "";
    private bool market;
    private Wrestler? offering;
    private int offerYears = 3;
    private decimal offerAnnual;
    private string? refusal;
    private bool lodged;

    private bool Matches(Wrestler w) =>
        string.IsNullOrWhiteSpace(query)
        || w.RingName.Contains(query, StringComparison.OrdinalIgnoreCase)
        || w.RealName.Contains(query, StringComparison.OrdinalIgnoreCase);

    private void Offer(Wrestler w)
    {
        offering = w;
        refusal = null;
        SetYears(w, offerYears);
    }

    private void SetYears(Wrestler w, int years)
    {
        offerYears = years;
        var career = State.Career!;
        offerAnnual = Math.Max(career.GuaranteeAsk(w, years), career.BestRivalBid(w)?.Annual ?? 0m);
        refusal = null;
        lodged = false;
    }

    private async Task Sign(Wrestler w)
    {
        var (accepted, pending, note) = await State.SignAsync(w, offerAnnual, offerYears);
        refusal = note;
        lodged = pending;
        if (accepted && !pending) offering = null;
    }

    private async Task Release(Wrestler w)
    {
        await State.ReleaseAsync(w);
        if (offering == w) offering = null;
    }
}
