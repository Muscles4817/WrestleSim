@inject GameState State

<div class="screen__head">
    <h1 class="screen__title">Try the engine</h1>
    <p class="screen__lede">
        Book one thing and watch it play out. There is no calendar, no money and no career here,
        and nothing is saved: feuds you build last until you leave. For a promotion that lasts,
        leave exhibition and start a career.
    </p>
</div>

<div class="tiles">
    @foreach (var tile in Tiles)
    {
        <button class="tile" @onclick="() => Open(tile.Screen)">
            <div class="tile__name">@tile.Name</div>
            <div class="tile__desc">@tile.Desc</div>
        </button>
    }
</div>

@if (State.ActiveFeudCount > 0)
{
    <div class="panel mt-2">
        <div class="panel__title">
            Live feuds
            <span class="spacer"></span>
            <button class="btn btn--sm btn--ghost" @onclick="() => State.Go(Screen.Feuds)">View all</button>
        </div>

        @foreach (var feud in State.FeudBook.All.Take(3))
        {
            <div class="feud">
                <div class="feud__top">
                    <span class="feud__names">
                        @feud.WrestlerA.RingName <span class="faint">vs</span> @feud.WrestlerB.RingName
                    </span>
                    <span class="badge @FeudUpdates.IntensityBadge(feud.Intensity)">@feud.Intensity</span>
                    <span class="spacer"></span>
                    <span class="small muted">@feud.MatchCount match@(feud.MatchCount == 1 ? "" : "es")</span>
                </div>
                <Meter Label="Heat" Value="@feud.Heat" Max="50" ValueText="@($"{feud.Heat:F0} / 50")" />
            </div>
        }
    </div>
}
else
{
    <div class="notice notice--info mt-2">
        <strong>New session.</strong> Nobody has any history yet. Book a segment — a betrayal or a
        weapon shot generates the most heat — and the feud will show up here and in the match booker.
    </div>
}


@code {
    private void Open(Screen screen)
    {
        if (screen == Screen.Roster) State.GoTalent(TalentView.Everyone);
        else State.Go(screen);
    }

    private static readonly (Screen Screen, string Name, string Desc)[] Tiles =
    [
        (Screen.Match, "A match",
            "Pick two wrestlers, say what the match is for, and the game writes the beats. Edit them if you want to."),
        (Screen.Segment, "A segment",
            "Promos, confrontations, beatdowns and turns. This is how feuds actually get built."),
        (Screen.Show, "A whole show",
            "Assemble a full card in running order against a runtime budget. Position and pacing both matter."),
        (Screen.Rumble, "A battle royal",
            "Over the top rope. A Rumble with timed entries or everybody in at once — judged on moments rather than on work."),
        (Screen.Roster, "Wrestlers",
            "Everyone you can book here, with full profiles. Nobody has a contract in exhibition."),
        (Screen.Feuds, "This session's feuds",
            "Every rivalry you have built since you came in, how hot it is, and what it has unlocked."),
    ];
}
