@implements IDisposable
@inject GameState State

<div class="shell">
    <header class="topbar">
        <button class="brand" @onclick="Home" title="@(State.InCareer ? "Dashboard" : "Main menu")">
            <span class="brand__star">★</span>
            <span class="brand__name">@(State.InCareer ? State.Career!.Promotion.Name : "Wrestling Sim")</span>
            <span class="brand__sub">
                @(State.InCareer
                    ? State.Career!.CurrentDate.ToString("d MMM yyyy")
                    : State.Mode == AppMode.Exhibition ? "Exhibition" : "Booking System")
            </span>
        </button>

        @if (ShowNav)
        {
            <nav class="nav">
                @foreach (var (screen, label, _) in NavItems)
                {
                    <button class="nav__item @(State.Current == screen ? "is-active" : "")"
                            @onclick="() => State.Go(screen)">
                        @label
                        @if (screen == Screen.Feuds && State.ActiveFeudCount > 0)
                        {
                            <span class="nav__count">@State.ActiveFeudCount</span>
                        }
                    </button>
                }
            </nav>
        }
    </header>

    <main class="main">
        @if (!State.Loaded)
        {
            <div class="empty">
                <div class="empty__mark">★</div>
                Loading the roster…
            </div>
        }
        else if (State.LoadError is not null)
        {
            <div class="notice notice--error">@State.LoadError</div>
        }
        else
        {
            @switch (State.Current)
            {
                // Outside a save
                case Screen.Landing:    <LandingScreen />;   break;
                case Screen.NewSave:    <NewSaveScreen />;   break;

                // Inside a save
                case Screen.Dashboard:  <DashboardScreen />; break;
                case Screen.Calendar:   <CalendarScreen />;  break;
                case Screen.BookShow:   <BookShowScreen />;  break;

                // Shared between career and exhibition
                case Screen.Roster:     <RosterScreen />;    break;
                case Screen.Feuds:      <FeudsScreen />;     break;

                // Exhibition only
                case Screen.Exhibition: <MainMenuScreen />;  break;
                case Screen.Match:      <MatchScreen />;     break;
                case Screen.Segment:    <SegmentScreen />;   break;
                case Screen.Show:       <ShowScreen />;      break;
            }
        }
    </main>

    @* On phones the top nav is hidden and navigation moves to the thumb zone. *@
    @if (ShowNav)
    {
        <nav class="tabbar" aria-label="Main">
            @foreach (var (screen, label, glyph) in NavItems)
            {
                <button class="tabbar__item @(State.Current == screen ? "is-active" : "")"
                        aria-current="@(State.Current == screen ? "page" : null)"
                        @onclick="() => State.Go(screen)">
                    <span class="tabbar__glyph" aria-hidden="true">@glyph</span>
                    <span>@label</span>
                    @if (screen == Screen.Feuds && State.ActiveFeudCount > 0)
                    {
                        <span class="tabbar__badge">@State.ActiveFeudCount</span>
                    }
                </button>
            }
        </nav>
    }
</div>

@code {
    private static readonly (Screen Screen, string Label, string Glyph)[] CareerNav =
    [
        (Screen.Dashboard, "Home",     "◆"),
        (Screen.Calendar,  "Calendar", "📅"),
        (Screen.Roster,    "Roster",   "👥"),
        (Screen.Feuds,     "Feuds",    "🔥"),
    ];

    private static readonly (Screen Screen, string Label, string Glyph)[] ExhibitionNav =
    [
        (Screen.Match,   "Match",   "★"),
        (Screen.Segment, "Segment", "🎤"),
        (Screen.Show,    "Show",    "📋"),
        (Screen.Roster,  "Roster",  "👥"),
        (Screen.Feuds,   "Feuds",   "🔥"),
    ];

    /// <summary>
    /// The landing screens deliberately have no nav: there is nowhere to go until you are
    /// inside a save or inside exhibition mode, and showing a disabled bar would imply
    /// otherwise.
    /// </summary>
    private bool ShowNav =>
        State.Loaded
        && State.LoadError is null
        && State.Roster.Count >= 2
        && State.Mode != AppMode.Landing;

    private (Screen, string, string)[] NavItems =>
        State.Mode == AppMode.Career ? CareerNav : ExhibitionNav;

    private void Home() =>
        State.Go(State.InCareer ? Screen.Dashboard
                : State.Mode == AppMode.Exhibition ? Screen.Exhibition
                : Screen.Landing);

    protected override async Task OnInitializedAsync()
    {
        State.Changed += OnChanged;
        await State.InitialiseAsync();
    }

    private void OnChanged() => StateHasChanged();

    public void Dispose() => State.Changed -= OnChanged;
}
