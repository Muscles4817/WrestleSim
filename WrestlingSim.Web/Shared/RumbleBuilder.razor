@using WrestlingSim.Models.Rumble
@using WrestlingSim.Engine
@inject GameState State

@* ── Booking a battle royal ───────────────────────────────────────────────────
   A component rather than a screen, so the same flow serves the exhibition sandbox and a
   card slot on a career show — which is how MatchBuilder and SegmentBuilder already work,
   and precisely what was missing when a Rumble could be run from the menu but not booked
   onto a show.

   Deliberately not the match builder. Doc 18 §2.5 calls this format "barely a match", the
   beat editor cannot express it — `BeatControl` names four sides, so a thirty-strong field
   has no way to say who a beat is for — and nobody books twenty-nine falls by hand. So the
   flow asks what a booker actually decides: who is in it, what order they come out, who
   wins, and a handful of moments. *@

<div class="panel">
    <div class="panel__title">Format</div>
    <div class="chips">
        <button class="chip @(interval > 0 ? "is-active" : "")"
                @onclick="() => interval = 90">Rumble — timed entries</button>
        <button class="chip @(interval == 0 ? "is-active" : "")"
                @onclick="() => interval = 0">Battle royal — all in at once</button>
    </div>
    <span class="field__hint">
        @(interval > 0
            ? "The entries are what make it a story rather than a scramble, so they are worth something: coming out at two and winning is the format's best night."
            : "Everybody starts together. Nothing to wait for, no entry to have a story about, and it grades accordingly.")
    </span>
</div>

<div class="panel">
    <div class="panel__title">
        The field
        <span class="spacer"></span>
        <span class="small muted">@field.Count in — @Runtime min</span>
    </div>

    @if (field.Count > 0)
    {
        <div class="stack">
            @foreach (var (w, i) in field.Select((w, i) => (w, i)))
            {
                var entrant = w;
                var at = i;
                <div class="beat-row @(entrant == winner ? "is-finish" : "")">
                    <div class="beat-row__n">@(interval > 0 ? (at + 1).ToString() : "—")</div>
                    <button class="beat-row__body" @onclick="() => winner = entrant">
                        <span class="beat-row__name">@entrant.RingName</span>
                        <span class="beat-row__sub">
                            @(entrant == winner ? "wins it" : "tap to make them the winner")
                        </span>
                    </button>
                    <div class="beat-row__move">
                        <button class="btn btn--icon btn--ghost" disabled="@(at == 0 || interval == 0)"
                                title="Earlier" @onclick="() => Move(at, -1)">↑</button>
                        <button class="btn btn--icon btn--ghost" disabled="@(at == field.Count - 1 || interval == 0)"
                                title="Later" @onclick="() => Move(at, 1)">↓</button>
                        <button class="btn btn--icon btn--ghost"
                                title="Remove" @onclick="() => Drop(entrant)">✕</button>
                    </div>
                </div>
            }
        </div>
    }

    <div class="chips mt">
        <button class="btn" @onclick="() => picking = true">+ Add to the field</button>

        @* The draw. Doc 18 says the entries are what make this a story rather than a
           scramble, and a number the booker simply handed out is a setting rather than a
           story — so the honest version is one tap away instead of something you have to
           decline to do. Rigging it afterwards is still allowed, because bookers do. *@
        @if (field.Count >= 4 && interval > 0)
        {
            <button class="btn" @onclick="DrawNumbers">🎲 Draw the numbers</button>
        }
    </div>

    @if (drawn)
    {
        <div class="notice notice--info mt">
            Numbers drawn. @DrawNote
            <span class="small muted">
                Reorder by hand from here if the booking calls for it — an authority figure
                putting somebody in at one on purpose is an angle, not a bug.
            </span>
        </div>
    }

    @if (interval > 0 && field.Count >= 4)
    {
        <div class="notice notice--info mt">
            Numbers set here are set quietly, and quiet numbers are worth nothing extra.
            Book <strong>a number drawing</strong> on an earlier show and the building
            spends a week arguing about who has to go the distance — which is the only way
            an entry number pays more than it does on this screen.
        </div>
    }
</div>

<div class="panel">
    <div class="panel__title">Moments</div>
    <p class="small muted">
        What the match is for. Repeating one wears it out — four hanging-on spots are worth
        less than two of anything else, which is the format's own rule and not a scoring quirk.
    </p>

    @if (moments.Count > 0)
    {
        <div class="stack">
            @foreach (var (m, i) in moments.Select((m, i) => (m, i)))
            {
                var moment = m;
                <div class="beat-row">
                    <div class="beat-row__n">@(i + 1)</div>
                    <div class="beat-row__body">
                        <span class="beat-row__name">@Label(moment.Kind)</span>
                        <span class="beat-row__sub">
                            @string.Join(" & ", moment.Cast.Select(c => c.RingName))
                        </span>
                    </div>
                    <div class="beat-row__move">
                        <button class="btn btn--icon btn--ghost" title="Remove"
                                @onclick="() => moments.Remove(moment)">✕</button>
                    </div>
                </div>
            }
        </div>
    }

    @if (field.Count >= 2)
    {
        <div class="chips mt">
            @foreach (var kind in Enum.GetValues<RumbleMomentKind>())
            {
                var k = kind;
                <button class="chip" disabled="@(k == RumbleMomentKind.IronMan)"
                        title="@(k == RumbleMomentKind.IronMan ? "Earned across the match, not booked" : null)"
                        @onclick="() => AddMoment(k)">+ @Label(k)</button>
            }
        </div>
        <span class="field__hint">
            An iron-man run is the one you cannot book — it is read off the match, from who
            came out early and was still there at the end.
        </span>
    }
</div>

@if (Blockers.Count > 0)
{
    <div class="notice notice--warn">
        @foreach (var b in Blockers) { <div>@b</div> }
    </div>
}

<div class="wizard-bar">
    <button class="btn btn--ghost" @onclick="OnCancel">← Cancel</button>
    <button class="btn btn--primary" disabled="@(Blockers.Count > 0)" @onclick="Confirm">
        @ConfirmLabel
    </button>
</div>

@if (picking)
{
    @* Already-booked names stay visible and labelled rather than filtered out — the
       picker's own convention, and the right one when a booker is assembling thirty
       people and needs to see who is already in. *@
    <RosterPicker Title="Add to the field"
                  UsedAs="@(w => field.Contains(w) ? $"#{field.IndexOf(w) + 1}" : null)"
                  Picked="Add"
                  Cancelled="() => picking = false" />
}

@code {
    [Parameter] public EventCallback<RumblePlan> OnDone { get; set; }
    [Parameter] public EventCallback OnCancel { get; set; }
    [Parameter] public string ConfirmLabel { get; set; } = "Run it ★";

    private readonly List<Wrestler> field = new();
    private readonly List<RumbleMoment> moments = new();
    private Wrestler? winner;
    private int interval = 90;
    private bool picking;
    private bool drawn;
    private string DrawNote = "";

    private RumblePlan Plan => new()
    {
        Field = field.Select((w, i) => new RumbleEntrant { Wrestler = w, Number = i + 1 }).ToList(),
        EntryIntervalSeconds = interval,
        Moments = moments.ToList(),
        Winner = winner
    };

    private int Runtime => Plan.DurationMinutes;
    private List<string> Blockers => Plan.Validate();

    private Task Confirm() => OnDone.InvokeAsync(Plan);

    private void Add(Wrestler w)
    {
        field.Add(w);
        winner ??= w;
        picking = false;
    }

    private void Drop(Wrestler w)
    {
        field.Remove(w);
        moments.RemoveAll(m => m.Cast.Contains(w));
        if (winner == w) winner = field.FirstOrDefault();
    }

    /// <summary>
    /// Draws the field into entry order. The winner is left where the draw puts them —
    /// deliberately, because a draw that protects whoever is booked to win is not a draw,
    /// and the number they end up with is supposed to be the thing they have to live with.
    /// </summary>
    private void DrawNumbers()
    {
        var plan = Plan;
        plan.DrawNumbers(Random.Shared.Next());

        field.Clear();
        field.AddRange(plan.Field.Select(e => e.Wrestler));

        drawn = true;

        int at = field.IndexOf(winner!) + 1;
        DrawNote = winner is null ? ""
            : at <= 2 ? $"{winner.RingName} drew number {at} — a long night, and the biggest " +
                        "story this match can tell if they survive it."
            : at >= field.Count ? $"{winner.RingName} drew number {at}, last in. A fix the " +
                        "crowd can see, which is worth something if they are meant to be hated."
            : $"{winner.RingName} drew number {at}.";
    }

    private void Move(int i, int by)
    {
        int to = i + by;
        if (to < 0 || to >= field.Count) return;
        (field[i], field[to]) = (field[to], field[i]);
    }

    /// <summary>
    /// Adds a moment, cast from the field. Two names for the ones that need two, and the
    /// booker re-picks by removing and re-adding — a full cast editor for a format whose
    /// whole point is that it is loosely booked would be more UI than the thing deserves.
    /// </summary>
    private void AddMoment(RumbleMomentKind kind)
    {
        int needed = kind is RumbleMomentKind.Showdown or RumbleMomentKind.Betrayal ? 2 : 1;
        var cast = field.Take(needed).ToList();
        if (cast.Count < needed) return;

        moments.Add(new RumbleMoment
        {
            Kind = kind,
            Cast = cast,
            At = Math.Clamp(0.25 + moments.Count * 0.15, 0.1, 0.9)
        });
    }

    private static string Label(RumbleMomentKind kind) => kind switch
    {
        RumbleMomentKind.IronMan         => "Iron man",
        RumbleMomentKind.SurpriseReturn  => "Surprise return",
        RumbleMomentKind.MassElimination => "Clearing house",
        RumbleMomentKind.Showdown        => "Showdown",
        RumbleMomentKind.NearElimination => "Hanging on",
        RumbleMomentKind.Betrayal        => "Betrayal",
        _                                => kind.ToString()
    };
}
