<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <!-- Namespaces stay WrestlingSim.* so nothing downstream has to change. -->
    <RootNamespace>WrestlingSim</RootNamespace>
  </PropertyGroup>

  <!-- Game data travels with the library two ways, from one physical copy:
       - Content, so hosts with a filesystem find it next to the executable.
       - EmbeddedResource, so hosts without one (WebAssembly) can read it
         straight out of the assembly with no fetch and no base-path concerns. -->
  <ItemGroup>
    <Content Include="JSON\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <EmbeddedResource Include="JSON\**\*" />
  </ItemGroup>


  <!-- The test project can see internals.

       PerformerProfile is internal on purpose — it is the engine's private read of a
       wrestler and nothing outside should depend on its shape. But that also meant no test
       could assert on it, so rules that live there could only ever be checked by running a
       whole match and reading a rating, which is the coupling this repo keeps removing.
       HotTagCharge sat private and untested for the same reason. -->
  <ItemGroup>
    <InternalsVisibleTo Include="WrestlingSim.Tests" />
  </ItemGroup>

</Project>