<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <!-- Keeps the WASM payload down for static hosting. -->
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="8.0.29" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="8.0.29" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\WrestlingSim.Core\WrestlingSim.Core.csproj" />
  </ItemGroup>

  <!-- Blazor WASM trims on Release publish. The roster is deserialised reflectively,
       so trimming the model properties would leave silently empty wrestlers at runtime.
       Rooting the engine assembly keeps every member the JSON binder needs. -->
  <ItemGroup>
    <TrimmerRootAssembly Include="WrestlingSim.Core" />
  </ItemGroup>

</Project>
