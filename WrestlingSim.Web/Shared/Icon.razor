@*
    The icon set.

    Everything in the app used to be a text glyph, and they came from three different
    registers at once: dingbats (✕ ◷ ▲ ▼ ◫), typographic marks (★ ✓ ⚠) and nine actual
    emoji, which render in full colour on every platform that ships a colour font and so
    arrived as little cartoons in the middle of a broadcast graphics package. They also
    rendered at whatever weight and optical size the system UI font felt like — which, now
    that the rest of the app is set in a condensed display face, no longer matched anything.

    One stroke weight, one optical size, `currentColor` throughout, sized from the font size
    so an icon beside a word is always the height of that word.

    Paths are on a 24×24 grid. Keep them stroked rather than filled unless the shape is
    genuinely solid (star, trend arrows), so the set keeps one weight.
*@
<svg class="icon @Class" viewBox="0 0 24 24" aria-hidden="@(Label is null ? "true" : "false")"
     role="@(Label is null ? "presentation" : "img")" focusable="false"
     fill="@(Solid ? "currentColor" : "none")"
     stroke="@(Solid ? "none" : "currentColor")"
     stroke-width="@Weight" stroke-linecap="round" stroke-linejoin="round">
    @if (Label is { } label)
    {
        <title>@label</title>
    }
    @((MarkupString)Path)
</svg>

@code {
    [Parameter, EditorRequired] public string Name { get; set; } = "";

    /// <summary>Accessible name. Null — the default — marks the icon decorative.</summary>
    [Parameter] public string? Label { get; set; }

    [Parameter] public string? Class { get; set; }

    private bool Solid => Name is "star" or "star-half" or "up" or "down" or "trophy";

    private double Weight => Solid ? 0 : 1.9;

    private string Path => Name switch
    {
        "close"    => "<path d='M6 6l12 12M18 6L6 18'/>",
        "check"    => "<path d='M4.5 12.8l4.8 4.7L19.5 7'/>",
        "up"       => "<path d='M12 5l7 9H5z'/>",
        "down"     => "<path d='M12 19l-7-9h14z'/>",
        "steady"   => "<path d='M5.5 12h13'/>",
        "vacant"   => "<circle cx='12' cy='12' r='7.5'/>",
        "star"     => "<path d='M12 2.1l3 6.1 6.7.9-4.9 4.7 1.2 6.7L12 17.3 6 20.5l1.2-6.7L2.3 9.1 9 8.2z'/>",
        "warn"     => "<path d='M12 3.6L1.8 20.4h20.4z'/><path d='M12 10v4.4M12 17.6v.1'/>",
        "clock"    => "<circle cx='12' cy='12' r='9'/><path d='M12 6.6V12l3.6 2.4'/>",
        "calendar" => "<rect x='3' y='5' width='18' height='16' rx='2'/><path d='M3 10h18M8 3v4M16 3v4'/>",
        "tv"       => "<rect x='2.5' y='7' width='19' height='13' rx='2'/><path d='M8 3.5l4 3.5 4-3.5'/>",
        "roster"   => "<circle cx='9' cy='9' r='3.3'/><path d='M3 20c0-3.3 2.7-5.4 6-5.4s6 2.1 6 5.4'/><path d='M16.5 7.2a3.3 3.3 0 010 6M18 14.9c2 .7 3.5 2.5 3.5 5.1'/>",
        "trophy"   => "<path d='M7 4h10v5a5 5 0 01-10 0z'/><path d='M7 5.5H4.2V7a3.5 3.5 0 003.3 3.5M17 5.5h2.8V7a3.5 3.5 0 01-3.3 3.5' fill='none' stroke='currentColor' stroke-width='1.9'/><path d='M10 14h4v3h-4z'/><path d='M7.5 20.5h9' stroke='currentColor' stroke-width='1.9'/>",
        "fire"     => "<path d='M12 2.8s1.2 3.1-.9 5.6C9.3 10.5 7 11.4 7 14.6A5 5 0 0012 20a5 5 0 005-5.4c0-3.5-2.6-4.6-3.4-7.3-.3 1.3-1.1 2-1.9 2.6.6-2.6.3-5-.7-7.1z'/>",
        "mic"      => "<rect x='9' y='2.6' width='6' height='11' rx='3'/><path d='M5.4 11.4a6.6 6.6 0 0013.2 0M12 18v3.4'/>",
        "card"     => "<rect x='4' y='2.8' width='16' height='18.4' rx='2'/><path d='M8.5 8h7M8.5 12h7M8.5 16h4'/>",
        "brands"   => "<rect x='3' y='4.5' width='18' height='15' rx='2'/><path d='M12 4.5v15'/>",
        "home"     => "<path d='M3.5 10.5L12 3.5l8.5 7'/><path d='M5.8 12.2v8h12.4v-8'/>",
