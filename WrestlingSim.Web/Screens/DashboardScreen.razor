@*
    Home. It leads with what is waiting on the booker — a card two matches short, a rival bid
    for somebody, a title nobody holds — each with the button that deals with it, instead of a
    wall of tiles that each had to be read to find out whether anything was wrong.

    The clock, the date and the money are in the frame above every screen, so they are not
    repeated here. The television deal and the brand split, which had tiles of their own,
    live under Business and Booking.
*@
@inherits StateComponent

@if (State.Career is not { } career)
{
    <div class="empty"><div class="empty__mark"><Icon Name="star" /></div>No career loaded.</div>
}
else
{
    var needs = Needs(career).ToList();

    <div class="layout">
        <div class="layout__main">
            <section class="panel">
                <div class="panel__title">Needs you</div>
                @if (needs.Count == 0)
                {
                    <div class="small muted">Nothing is waiting on you. Advance the clock, or get ahead on the next card.</div>
                }
                <div class="needs">
                    @foreach (var n in needs)
                    {
                        var need = n;
                        <div class="need">
                            <span class="need__kind need__kind--@need.Tone">@need.Kind</span>
                            <span class="need__text">@need.Text</span>
                            <button class="btn btn--sm need__act" @onclick="need.Act">@need.Action</button>
                        </div>
                    }
                </div>
            </section>

            <section class="panel">
                @if ((career.Due.FirstOrDefault() ?? career.NextShow) is { } next)
                {
                    var projection = next.IsBooked && !next.IsLoopOnly ? career.Projection(next) : null;
                    <div class="panel__title">
                        Next show
                        <span class="spacer"></span>
                        <span class="small muted">@next.Date.ToString("ddd d MMM") · @next.TypeLabel@(string.IsNullOrWhiteSpace(next.Venue) ? "" : $" · {next.Venue}")</span>
                    </div>
                    <div class="kpis kpis--inpanel">
                        <div class="kpi">
                            <span class="kpi__key">@next.Name</span>
                            <span class="kpi__val">@next.BookedMinutes of @next.RuntimeMinutes min</span>
                            <span class="kpi__sub">@next.Card.Count item@(next.Card.Count == 1 ? "" : "s") booked</span>
                            <span class="kpi__bar" aria-hidden="true"><i style="width:@(Math.Min(100, next.BookedMinutes * 100 / Math.Max(1, next.RuntimeMinutes)))%"></i></span>
                        </div>
                        @if (projection is { HadCard: true } p)
                        {
                            <div class="kpi">
                                <span class="kpi__key">Expected house</span>
                                <span class="kpi__val">@Money.Percent(p.Fill)</span>
                                <span class="kpi__sub">@p.Attendance.ToString("N0") of @p.Capacity.ToString("N0")</span>
                            </div>
                            <div class="kpi">
                                <span class="kpi__key">Expected result</span>
                                <span class="kpi__val @Money.Tone(p.Net)">@Money.Signed(p.Net)</span>
                                <span class="kpi__sub">after fees and the hall</span>
                            </div>
                        }
                        else
                        {
                            <div class="kpi">
                                <span class="kpi__key">Expected house</span>
                                <span class="kpi__val muted">—</span>
                                <span class="kpi__sub">Book a card to see what it sells.</span>
                            </div>
                        }
                    </div>
                    <div class="row mt">
                        <button class="btn btn--primary" @onclick="() => State.OpenShow(next)">@(next.IsBooked ? "Open the card" : "Book the card")</button>
                        <button class="btn btn--ghost" @onclick="() => State.Go(Screen.Calendar)">Calendar</button>
                    </div>
                }
                else
                {
                    <div class="panel__title">Next show</div>
                    <div class="small muted">Nothing is on the calendar.</div>
                    <div class="row mt"><button class="btn btn--primary" @onclick="() => State.Go(Screen.Calendar)">Put a show on the calendar</button></div>
                }
            </section>

            <section class="panel">
                <div class="panel__title">
                    In the industry
                    <span class="spacer"></span>
                    <button class="btn btn--sm btn--ghost" @onclick="() => State.Go(Screen.News)">All news</button>
                </div>
                @if (career.News.Count == 0)
                {
                    <div class="small muted">Quiet so far.</div>
                }
                @foreach (var n in career.News.AsEnumerable().Reverse().Take(6))
                {
                    <div class="newsline @(n.AboutYou ? "is-you" : "")"><span>@n.Date.ToString("d MMM")</span><span>@n.Text</span></div>
                }
            </section>

            @if (career.Completed.Any())
            {
                <section class="panel">
                    <div class="panel__title">Recent shows</div>
                    @foreach (var show in career.Completed.OrderByDescending(s => s.Date).Take(4))
                    {
                        var shown = show;
                        <div class="kv">
                            <span><button class="namelink" @onclick="() => State.OpenShow(shown)">@show.Name</button> <span class="muted">· @show.Date.ToString("d MMM")</span></span>
                            <span>
                                @if (show.Result!.Finances is { } f)
                                {
                                    <span class="tabnum muted">@Money.Percent(f.Fill) house</span>
                                    <span class="tabnum @Money.Tone(f.Net)">&nbsp; @Money.Signed(f.Net)</span>
                                }
                                <strong class="tabnum @Grades.OfScore(show.Result!.OverallRating).Tone()">&nbsp; @show.Result!.OverallRating.ToString("F0")</strong>
                            </span>
                        </div>
                    }
                </section>
            }
        </div>

        <aside class="layout__side">
            <section class="panel">
                <div class="panel__title">
                    Your roster
                    <span class="spacer"></span>
                    <button class="btn btn--sm btn--ghost" @onclick="() => State.GoTalent(TalentView.Yours)">All @career.Contracts.Count</button>
                </div>
                @{ var yours = career.Contracts.Select(c => career.FindWrestler(c.WrestlerId)).OfType<Wrestler>().OrderByDescending(w => w.EffectiveOverness).Take(8).ToList(); }
                @if (yours.Count == 0)
                {
                    <div class="small muted">Nobody yet. <button class="namelink gold" @onclick="() => State.GoTalent(TalentView.Market)">Find people in the market.</button></div>
                }
                @foreach (var w in yours)
                {
                    var who = w;
                    <div class="kv">
                        <span><button class="namelink" style="color: var(--ink); font-weight: 600" @onclick="() => State.OpenProfile(who)">@w.RingName</button></span>
                        <span>
                            <span class="small @(StatusTone(career, w))">@Status(career, w)</span>
                            <strong class="tabnum @w.CardPosition.Tone()">&nbsp; @w.OvernessDisplay</strong>
                        </span>
                    </div>
                }
            </section>

            <section class="panel">
                <div class="panel__title">
                    Money this month
                    <span class="spacer"></span>
                    <button class="btn btn--sm btn--ghost" @onclick="() => State.Go(Screen.Business)">Business</button>
                </div>
                @{ var month = ThisMonth(career); }
                <div class="kv"><span>Shows (@month.Shows)</span><span class="tabnum @Money.Tone(month.ShowNet)">@Money.Signed(month.ShowNet)</span></div>
                <div class="kv"><span>Running the office</span><span class="tabnum">@Money.Signed(-month.Office)</span></div>
                @if (month.Payroll > 0)
                {
                    <div class="kv"><span>Guarantees</span><span class="tabnum">@Money.Signed(-month.Payroll)</span></div>
                }
                <div class="kv"><strong>Net so far</strong><strong class="tabnum @Money.Tone(month.Net)">@Money.Signed(month.Net)</strong></div>
            </section>

            <section class="panel">
                <div class="panel__title">
                    Champions
                    <span class="spacer"></span>
                    <button class="btn btn--sm btn--ghost" @onclick="() => State.Go(Screen.Titles)">Titles</button>
                </div>
                @foreach (var title in career.Titles.ByPrestige)
                {
                    <div class="kv">
                        <span>
                            @if (title.Champion is { } champ && title.CurrentReign!.Champions.Count == 1)
                            {
                                <button class="namelink" style="color: var(--ink); font-weight: 600" @onclick="() => State.OpenProfile(champ)">@champ.RingName</button>
                            }
                            else
                            {
                                <span class="@(title.IsVacant ? "muted" : "")">@(title.CurrentReign?.ChampionName ?? "Vacant")</span>
                            }
                        </span>
                        <span class="small muted">@title.Name@(title.CurrentReign is { } r ? $" · {r.LengthLabel(career.CurrentDate)}" : "")</span>
                    </div>
                }
            </section>
        </aside>
    </div>
}

@code {
    private sealed record Need(string Kind, string Tone, string Text, string Action, Action Act);

    /// <summary>
    /// What is waiting on the booker, most urgent first. Every line is read off the career as
    /// it is; nothing here is a reminder for its own sake.
    /// </summary>
    private IEnumerable<Need> Needs(Career career)
    {
        var today = career.CurrentDate;

        if (career.Due.FirstOrDefault() is { } due)
            yield return new("Today", "urgent",
                due.IsBooked ? $"{due.Name} is today. The clock is held until it runs." : $"{due.Name} is today and nothing is booked.",
                due.IsBooked ? "Run the show" : "Book the card", () => State.OpenShow(due));

        if (career.Books.InTheRed)
            yield return new("Money", "urgent",
                $"You are {Money.Format(-career.Books.Cash)} in the red.", "See the money", () => State.Go(Screen.Business));

        foreach (var c in career.Contracts.Where(c => c.IsGuaranteed))
            if (career.FindWrestler(c.WrestlerId) is { } w && career.BestRivalBid(w) is { } bid)
            {
                var who = w;
                yield return new("Offer", "urgent",
                    $"{career.Rival(bid.Bidder)?.Name ?? "A rival"} has offered {w.RingName} {Money.Format(bid.Annual)} a year. Match it before {c.End:d MMM} or they leave.",
                    $"See {w.RingName}", () => State.OpenProfile(who));
            }

        if (career.NextShow is { } next && career.Due.All(d => d != next) && career.DaysUntil(next) <= 7)
        {
            string when = career.DaysUntil(next) == 1 ? "tomorrow" : $"in {career.DaysUntil(next)} days";
            if (!next.IsBooked)
                yield return new("Show", "do", $"{next.Name} is {when} and nothing is booked.", "Book the card", () => State.OpenShow(next));
            else if (!next.IsLoopOnly && next.BookedMinutes < next.RuntimeMinutes * AudienceModel.FullCard)
                yield return new("Show", "do",
                    $"{next.Name} is {when} and fills {next.BookedMinutes} of {next.RuntimeMinutes} minutes. A thin show costs you on the night and at the next gate.",
                    "Book the card", () => State.OpenShow(next));

            foreach (var (w, why) in career.UnavailableOnCard(next))
                yield return new("Card", "urgent", $"{w.RingName} is on {next.Name} but is {why}.", "Open the card", () => State.OpenShow(next));
            foreach (var w in next.Card.SelectMany(i => i.Wrestlers).Distinct().Where(w => w.IsInjured(next.Date)))
                yield return new("Injury", "urgent", $"{w.RingName} is on {next.Name} and will not be fit.", "Open the card", () => State.OpenShow(next));
        }

        foreach (var c in career.ExpiringWithin(TalentMarket.ExpiryWarningDays).Where(c => c.IsGuaranteed))
            if (career.FindWrestler(c.WrestlerId) is { } w && career.BestRivalBid(w) is null)
            {
                var who = w;
                yield return new("Contract", "do", $"{w.RingName}'s deal runs out on {c.End:d MMM}. Re-sign or they go to the market.", $"See {w.RingName}", () => State.OpenProfile(who));
            }

        var vacant = career.Titles.Active.Where(t => t.IsVacant).ToList();
        if (vacant.Count == 1)
            yield return new("Title", "do", $"The {vacant[0].Name} has no champion. A vacant title loses value every week.", "Titles", () => State.Go(Screen.Titles));
        else if (vacant.Count > 1)
            yield return new("Titles", "do", $"{vacant.Count} of your titles have no champion. A vacant title loses value every week.", "Titles", () => State.Go(Screen.Titles));

        if (Draft.IsDue(career.Brands, today))
            yield return new("Brands", "do", "The brand draft is due.", "Brands", () => State.Go(Screen.Brands));

        foreach (var n in career.News.Where(n => n.AboutYou && n.Date >= today.AddDays(-14)).Reverse().Take(2))
            yield return new("News", "note", n.Text, "News", () => State.Go(Screen.News));

        var stale = career.Contracts.Select(c => career.FindWrestler(c.WrestlerId)).OfType<Wrestler>()
            .Select(w => (Wrestler: w, Reading: AudienceModel.Reading(career.Audience, w)))
            .Where(x => x.Reading is not null).Take(2);
        foreach (var (w, reading) in stale)
        {
            var who = w;
            yield return new("Crowd", "note", $"{w.RingName}: {reading}.", $"See {w.RingName}", () => State.OpenProfile(who));
        }
    }

    private static string Status(Career career, Wrestler w)
    {
        var today = career.CurrentDate;
        if (w.Injury is { } i && i.KeepsOut(today)) return "Injured";
        if (w.Fatigue >= RingCondition.CookedThreshold) return "Worn out";
        if (career.BestRivalBid(w) is not null) return "Has an offer";
        if (w.IsTouring(today)) return "On the road";
        if (AudienceModel.Reading(career.Audience, w) is not null) return "Crowd tiring";
        return "";
    }

    private static string StatusTone(Career career, Wrestler w) =>
        Status(career, w) switch { "" or "On the road" => "muted", _ => "grade--poor" };

    private sealed record Month(int Shows, decimal ShowNet, decimal Office, decimal Payroll)
    {
        public decimal Net => ShowNet - Office - Payroll;
    }

    /// <summary>
    /// This calendar month so far. The office and the guarantees are charged every day, so
    /// they are the daily rate times the days gone; the shows are their own books.
    /// </summary>
    private static Month ThisMonth(Career career)
    {
        var today = career.CurrentDate;
        var start = new DateOnly(today.Year, today.Month, 1);
        var opened = career.Books.OpenedOn > start ? career.Books.OpenedOn : start;
        int days = Math.Max(0, today.DayNumber - opened.DayNumber);
        var shows = career.Completed.Where(s => s.Date >= start && s.Result?.Finances is not null).ToList();
        return new Month(shows.Count, shows.Sum(s => s.Result!.Finances!.Net), career.DailyOverhead * days, career.DailyPayroll * days);
    }
}
