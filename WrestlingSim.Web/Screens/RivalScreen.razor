@*
    One rival promotion: what it wants, what it expects of itself, who it has, what it last
    put on, and every decision it made with its reasons. The decisions are the planner's own
    record (docs/rival-ai-plan.md §6), so "why did they sign him" has an answer.
*@
@inherits StateComponent

@if (State.Career is not { } career || State.ViewingRival is not { } rival)
{
    <div class="empty">No promotion selected.</div>
}
else
{
    var today = career.CurrentDate;
    var last = rival.Nights.LastOrDefault();
    var outlook = rival.IsActive ? World.Forecast(career, rival, rival.Contracts, World.DispositionOf(rival)) : null;
    var temperament = World.TemperamentInWords(World.DispositionOf(rival));
    var people = rival.Contracts
        .Select(c => (Contract: c, Wrestler: career.FindWrestler(c.WrestlerId)))
        .Where(x => x.Wrestler is not null)
        .OrderByDescending(x => x.Wrestler!.EffectiveOverness).ToList();

    <button class="btn btn--sm btn--ghost" @onclick="() => State.Go(Screen.Rivals)">← All promotions</button>

    <section class="phead mt @(rival.IsActive ? "" : "is-folded")">
        <div class="phead__who">
            <div class="phead__badges">
                <span class="badge badge--muted">@rival.Promotion.TierLabel</span>
                <span class="badge badge--violet">@RivalLabels.Motive(rival.Motive)</span>
                @if (!rival.IsActive)
                {
                    <span class="badge badge--heel">Closed @rival.Folded!.Value.ToString("d MMM yyyy")</span>
                }
            </div>
            <h1 class="phead__name">@rival.Name</h1>
            <span class="phead__line">@World.Profile(rival.Motive).Reading</span>
            @if (rival.IsActive)
            {
                <span class="phead__line">
                    <strong style="color: var(--ink)">Wants</strong> @string.Join(", then ", World.WantsInWords(World.ObjectiveOf(rival))).
                    @if (temperament.Length > 0) { <text> @temperament</text> }
                </span>
            }
        </div>
        <div class="phead__figs">
            <div class="phead__fig"><b class="@Money.Tone(rival.Books.Cash)">@Money.Format(rival.Books.Cash)</b><span>Cash</span></div>
            <div class="phead__fig"><b>@rival.Books.Reputation.ToString("F0")</b><span>Reputation</span></div>
            <div class="phead__fig"><b>@rival.Contracts.Count</b><span>Roster</span></div>
        </div>
    </section>

    <div class="layout">
        <div class="layout__main">
            @if (rival.IsActive)
            {
                <section class="panel">
                    <div class="panel__title">
                        What it wants
                        <span class="spacer"></span>
                        @if (!editing)
                        {
                            <button class="btn btn--sm" @onclick="() => StartEditing(rival)">Edit</button>
                        }
                    </div>
                    @if (!editing)
                    {
                        var wants = World.ObjectiveOf(rival);
                        @foreach (var (key, label, value) in Weights(wants))
                        {
                            <div class="skillbar">
                                <span style="flex-basis: 190px">@label</span>
                                <span class="skillbar__track" aria-hidden="true"><i class="@(value >= 0.7 ? "is-strong" : "")" style="width:@((value * 100).ToString("F0"))%"></i></span>
                                <b>@((int)Math.Round(value * 100))</b>
                            </div>
                        }
                        <div class="kv mt">
                            <span>Its favourites</span>
                            <span>
                                @if (rival.Favourites.Count == 0) { <span class="muted">None</span> }
                                @for (int i = 0; i < rival.Favourites.Count; i++)
                                {
                                    var fav = career.FindWrestler(rival.Favourites[i]);
                                    @if (i > 0) { <text>, </text> }
                                    @if (fav is not null) { <button class="namelink" @onclick="() => State.OpenProfile(fav)">@fav.RingName</button> }
                                }
                            </span>
                        </div>
                        <div class="small muted mt">
                            @(rival.Objective is null && rival.Disposition is null ? "Its founder's defaults." : "Changed from its founder's defaults.")
                            Each weight is how much it counts against the others; what it does each week follows from these.
                        </div>
                    }
                    else
                    {
                        @foreach (var key in WeightKeys)
                        {
                            var k = key;
                            <div class="skillbar">
                                <label for="w-@k" style="flex: 0 0 190px; color: var(--ink-2)">@WeightLabel(k)</label>
                                <input id="w-@k" type="range" min="0" max="100" step="5" style="flex: 1 1 auto"
                                       value="@draft[k]" @oninput="e => draft[k] = Num(e)" />
                                <b>@draft[k]</b>
                            </div>
                        }
                        <div class="panel__title mt" style="font-size: 13px">How it sees</div>
                        <div class="skillbar">
                            <label for="d-horizon" style="flex: 0 0 190px; color: var(--ink-2)">Plans ahead</label>
                            <input id="d-horizon" type="range" min="30" max="730" step="30" style="flex: 1 1 auto" value="@horizon" @oninput="e => horizon = Num(e)" />
                            <b style="flex-basis: 76px">@(horizon / 30) mo</b>
                        </div>
                        <div class="skillbar">
                            <label for="d-optimism" style="flex: 0 0 190px; color: var(--ink-2)">Optimism</label>
                            <input id="d-optimism" type="range" min="70" max="140" step="5" style="flex: 1 1 auto" value="@optimism" @oninput="e => optimism = Num(e)" />
                            <b style="flex-basis: 76px">@OptimismWord(optimism)</b>
                        </div>
                        <div class="skillbar">
                            <label for="d-floor" style="flex: 0 0 190px; color: var(--ink-2)">Money it wants in hand</label>
                            <input id="d-floor" type="range" min="0" max="730" step="30" style="flex: 1 1 auto" value="@floor" @oninput="e => floor = Num(e)" />
                            <b style="flex-basis: 76px">@(floor / 30) mo</b>
                        </div>
                        <div class="skillbar">
                            <label for="d-risk" style="flex: 0 0 190px; color: var(--ink-2)">Fear of closing</label>
                            <input id="d-risk" type="range" min="0" max="8" step="1" style="flex: 1 1 auto" value="@risk" @oninput="e => risk = Num(e)" />
                            <b style="flex-basis: 76px">@risk of 8</b>
                        </div>

                        <div class="panel__title mt" style="font-size: 13px">Favourites</div>
                        <div class="chips">
                            @foreach (var id in favourites.ToList())
                            {
                                var fid = id;
                                <button class="chip is-active" title="Remove" @onclick="() => favourites.Remove(fid)">@(career.FindWrestler(fid)?.RingName ?? fid) ✕</button>
                            }
                        </div>
                        <div class="row mt">
                            <label class="sr-only" for="fav-add">Add a favourite</label>
                            <select id="fav-add" class="input" style="flex: 1 1 auto" @bind="adding">
                                <option value="">Add somebody on its roster…</option>
                                @foreach (var (c, w) in people.Where(x => !favourites.Contains(x.Wrestler!.Id)))
                                {
                                    <option value="@w!.Id">@w.RingName</option>
                                }
                            </select>
                            <button class="btn btn--sm" disabled="@(adding.Length == 0)" @onclick="AddFavourite">Add</button>
                        </div>

                        <div class="small muted mt">With nobody listed, it picks a favourite of its own at its next decision. Set its favourites' weight to 0 for none.</div>
                        <div class="row mt">
                            <button class="btn btn--primary" @onclick="() => Save(rival)">Save</button>
                            <button class="btn btn--ghost" @onclick="() => editing = false">Cancel</button>
                            <span class="spacer"></span>
                            <button class="btn btn--sm btn--ghost" @onclick="() => ResetToFounder(rival)">Reset to its founder's defaults</button>
                        </div>
                        <div class="small muted mt">It acts on the change from its next weekly decision.</div>
                    }
                </section>
            }

            @if (outlook is not null)
            {
                <section class="panel">
                    <div class="panel__title">What it expects</div>
                    <div class="kpis kpis--inpanel">
                        <div class="kpi"><span class="kpi__key">Its houses</span><span class="kpi__val">@Money.Percent(outlook.Fill)</span><span class="kpi__sub">over the next month</span></div>
                        <div class="kpi"><span class="kpi__key">Its shows</span><span class="kpi__val">@outlook.Rating.ToString("F0")</span><span class="kpi__sub">expected rating</span></div>
                        <div class="kpi">
                            <span class="kpi__key">Money</span>
                            <span class="kpi__val @(outlook.RunwayDays >= 9999 ? "grade--great" : outlook.RunwayDays < 180 ? "grade--poor" : "")">@(outlook.RunwayDays >= 9999 ? "Making money" : $"{Math.Max(1, outlook.RunwayDays / 30)} months")</span>
                            <span class="kpi__sub">@(outlook.RunwayDays >= 9999 ? "at this rate" : "before it would have to close")</span>
                        </div>
                        @if (outlook.Viewers > 0)
                        {
                            <div class="kpi"><span class="kpi__key">Watching</span><span class="kpi__val">@Money.Audience(outlook.Viewers)</span><span class="kpi__sub">a week</span></div>
                        }
                    </div>
                    <div class="small muted mt">Its own forecast, through its own eyes: an optimistic owner expects more than will come.</div>
                </section>
            }

            <section class="panel">
                <div class="panel__title">Its roster</div>
                @if (people.Count == 0)
                {
                    <div class="small muted">Nobody.</div>
                }
                else
                {
                    <div class="table-wrap">
                        <table class="data">
                            <thead><tr><th>Wrestler</th><th class="num">Popularity</th><th>Deal</th></tr></thead>
                            <tbody>
                                @foreach (var (c, w) in people)
                                {
                                    var who = w!;
                                    <tr class="@(career.ContractOf(who) is not null ? "is-mine" : "")">
                                        <td>
                                            <button class="namecell" @onclick="() => State.OpenProfile(who)">
                                                <strong>@who.RingName</strong>
                                                <span class="small muted">
                                                    @(who.Division == Division.Womens ? "Women's" : "Men's")
                                                    @if (rival.Titles.HeldBy(who).FirstOrDefault() is { } belt) { <text> · @belt.Name</text> }
                                                    @if (career.ContractOf(who) is not null) { <text> · also works for you</text> }
                                                </span>
                                            </button>
                                        </td>
                                        <td class="num @who.CardPosition.Tone()">@who.OvernessDisplay</td>
                                        <td class="small">@(c.IsGuaranteed ? $"{Money.Format(c.AnnualGuarantee)} a year until {c.End:MMM yyyy}" : "By the night")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </section>

            <section class="panel">
                <div class="panel__title">Its decisions</div>
                @if (rival.Decisions.Count == 0)
                {
                    <div class="small muted">None yet.</div>
                }
                @foreach (var d in rival.Decisions.AsEnumerable().Reverse())
                {
                    <details class="decision">
                        <summary>
                            <span class="muted tabnum">@d.Date.ToString("d MMM yyyy")</span>
                            @Verb(d.Move) @(career.FindWrestler(d.WrestlerId)?.RingName ?? d.WrestlerId)@(d.Annual > 0 ? $" at {Money.Format(d.Annual)} a year" : "")
                            <span class="muted">— @d.Reason</span>
                        </summary>
                        <div class="muted small" style="padding: 4px 0 8px 14px">
                            <div>At the time it @d.Believed.</div>
                            <div>Counted for it (in points of its score): @string.Join(", ", d.Terms.OrderByDescending(t => Math.Abs(t.Value)).Select(t => $"{TermName(t.Key)} {Shown.Change(t.Value * 1000)}"))</div>
                            @if (d.Rejected.Count > 0)
                            {
                                <div>Next best: @string.Join("; ", d.Rejected)</div>
                            }
                        </div>
                    </details>
                }
            </section>
        </div>

        <aside class="layout__side">
            @if (last is not null)
            {
                <section class="panel">
                    <div class="panel__title">Last show <span class="spacer"></span><span class="small muted">@last.Date.ToString("d MMM")</span></div>
                    <div class="kv"><span>Rated</span><span class="tabnum">@last.Rating.ToString("F0")</span></div>
                    <div class="kv"><span>House</span><span class="tabnum">@last.Attendance.ToString("N0") of @last.Capacity.ToString("N0")</span></div>
                    @if (last.Viewers > 0)
                    {
                        <div class="kv"><span>Watching</span><span class="tabnum">@Money.Audience(last.Viewers)</span></div>
                    }
                    <div class="kv"><span>Made</span><span class="tabnum @Money.Tone(last.Net)">@Money.Signed(last.Net)</span></div>
                    <div class="mt small">
                        @foreach (var line in last.Card)
                        {
                            <div style="padding: 2px 0">@line</div>
                        }
                    </div>
                    @if (last.Filled < AudienceModel.FullCard)
                    {
                        <div class="small grade--poor mt">A thin card: only @Money.Percent(last.Filled) of the slot filled.</div>
                    }
                </section>
            }

            @if (rival.Titles.Active.Count > 0)
            {
                <section class="panel">
                    <div class="panel__title">Champions</div>
                    @foreach (var title in rival.Titles.ByPrestige)
                    {
                        <div class="kv">
                            <span>
                                @if (title.Champion is { } champ)
                                {
                                    <button class="namelink" @onclick="() => State.OpenProfile(champ)">@champ.RingName</button>
                                }
                                else
                                {
                                    <span class="muted">Vacant</span>
                                }
                            </span>
                            <span class="small muted">@ShortTitle(title.Name, rival.Name) · prestige @title.Prestige.ToString("F0")</span>
                        </div>
                    }
                </section>
            }

            @if (rival.Television is { } tv)
            {
                <section class="panel">
                    <div class="panel__title">Television</div>
                    <div class="kv"><span>Fee</span><span>@Money.Format(tv.FeePerEpisode) an episode</span></div>
                    <div class="kv"><span>Until</span><span>@tv.End.ToString("MMM yyyy")</span></div>
                </section>
            }
        </aside>
    </div>
}

@code {
    private static readonly string[] WeightKeys = ["wealth", "franchise", "stars", "quality", "reputation", "favour", "stability"];

    private static string WeightLabel(string key) => key switch
    {
        "wealth"     => "Making money",
        "franchise"  => "A bigger television deal",
        "stars"      => "Names on its cards",
        "quality"    => "Good shows",
        "reputation" => "A name for good shows",
        "favour"     => "Its favourites on top",
        _            => "Keeping the people it has"
    };

    private static IEnumerable<(string Key, string Label, double Value)> Weights(Objective o)
    {
        var values = new[] { o.Wealth, o.Franchise, o.Stars, o.Quality, o.Reputation, o.Favour, o.Stability };
        for (int i = 0; i < WeightKeys.Length; i++) yield return (WeightKeys[i], WeightLabel(WeightKeys[i]), values[i]);
    }

    private static string OptimismWord(int pct) =>
        pct >= 115 ? "Rosy" : pct >= 105 ? "Hopeful" : pct <= 90 ? "Gloomy" : pct <= 95 ? "Cautious" : "Sober";

    private static int Num(ChangeEventArgs e) => int.TryParse(e.Value?.ToString(), out var n) ? n : 0;

    private void AddFavourite()
    {
        if (adding.Length > 0 && !favourites.Contains(adding)) favourites.Add(adding);
        adding = string.Empty;
    }

    private bool editing;
    private Dictionary<string, int> draft = new();
    private int horizon, optimism, floor, risk;
    private List<string> favourites = new();
    private string adding = "";

    private void Load(Objective o, Disposition d, IEnumerable<string> favs)
    {
        draft = Weights(o).ToDictionary(x => x.Key, x => (int)Math.Round(x.Value * 100));
        horizon = d.HorizonDays;
        optimism = (int)Math.Round(d.Optimism * 100);
        floor = d.RunwayFloorDays;
        risk = (int)Math.Round(d.RiskAversion);
        favourites = favs.ToList();
        adding = "";
    }

    private void StartEditing(RivalPromotion rival)
    {
        Load(World.ObjectiveOf(rival), World.DispositionOf(rival), rival.Favourites);
        editing = true;
    }

    private void ResetToFounder(RivalPromotion rival) =>
        Load(World.ObjectiveFor(rival.Motive), World.DispositionFor(rival.Motive), favourites);

    private async Task Save(RivalPromotion rival)
    {
        var objective = new Objective(draft["wealth"] / 100.0, draft["franchise"] / 100.0, draft["stars"] / 100.0,
            draft["quality"] / 100.0, draft["reputation"] / 100.0, draft["favour"] / 100.0, draft["stability"] / 100.0);
        var disposition = new Disposition(horizon, optimism / 100.0, floor, risk);

        // Kept as an override only where it differs from the founder's, so a promotion reset to
        // its defaults goes on following them if those ever change.
        rival.Objective = objective == World.ObjectiveFor(rival.Motive) ? null : objective;
        rival.Disposition = disposition == World.DispositionFor(rival.Motive) ? null : disposition;
        rival.Favourites.Clear();
        rival.Favourites.AddRange(favourites);

        // Look again next week rather than waiting out a quiet month.
        rival.QuietAs = 0;
        rival.QuietSince = null;

        editing = false;
        await State.SaveAsync();
        State.Notify();
    }

    private static string ShortTitle(string title, string promotion) =>
        title.StartsWith(promotion) ? title[promotion.Length..].Trim() : title;

    private static string Verb(string move) => move switch
    {
        "signed"   => "Signed",
        "released" => "Released",
        "bid for"  => "Offered for",
        "added"    => "Started booking",
        "dropped"  => "Stopped booking",
        _          => move
    };

    private static string TermName(string term) => term switch
    {
        "wealth"     => "money",
        "franchise"  => "television deal",
        "stars"      => "names",
        "quality"    => "show quality",
        "reputation" => "reputation",
        "favour"     => "owner's people",
        "stability"  => "continuity",
        "survival"   => "staying open",
        _            => term
    };
}
