@inject GameState State

<div class="screen__head">
    <div class="screen__eyebrow">@(feuds.Count) active</div>
    <h1 class="screen__title">Feud Book</h1>
    <p class="screen__lede">
        Intensity is derived from accumulated heat, not chosen. Book segments to build it —
        the match editor unlocks feud-gated beats once a rivalry reaches Building.
    </p>
</div>

@if (feuds.Count == 0)
{
    <div class="empty">
        <div class="empty__mark">◇</div>
        <p><strong>No feuds yet.</strong></p>
        <p class="small">A betrayal or a weapon shot generates the most heat of anything you can book.</p>
        <button class="btn btn--primary mt" @onclick="() => State.Go(Screen.Segment)">Book a segment</button>
    </div>
}
else
{
    <div class="stack">
        @foreach (var feud in feuds)
        {
            <div class="panel">
                <div class="panel__title">
                    @feud.WrestlerA.RingName vs @feud.WrestlerB.RingName
                    <span class="spacer"></span>
                    <span class="badge @FeudUpdates.IntensityBadge(feud.Intensity)">@feud.Intensity</span>
                </div>

                <Meter Label="Heat" Value="@feud.Heat" Max="50" ValueText="@($"{feud.Heat:F0} / 50")" />

                <div class="row mt small">
                    <span class="muted">Matches</span> <strong>@feud.MatchCount</strong>
                    <span class="faint">•</span>
                    <span class="muted">Next one draws</span>
                    <strong class="@(Familiarity(feud) < 0.8 ? "gold" : "")">@((int)Math.Round(Familiarity(feud) * 100))%</strong>
                    <span class="faint">•</span>
                    <span class="muted">Starting crowd bonus</span> <strong>+@feud.StartingEnergyBonus</strong>
                    @if (feud.HeatToNextTier is > 0 and var toNext)
                    {
                        <span class="faint">•</span>
                        <span class="muted">@toNext.ToString("F0") heat to next tier</span>
                    }
                </div>

                @if (feud.History.Count > 0)
                {
                    <div class="badge-row mt">
                        @foreach (var tag in feud.History)
                        {
                            <span class="badge badge--cyan">@tag</span>
                        }
                    </div>
                }
                else
                {
                    <div class="small faint mt">No history tags yet.</div>
                }

                @{
                    var unlocked = UnlockedBeats(feud).ToList();
                }
                @if (unlocked.Count > 0)
                {
                    <div class="notice notice--tip mt">
                        <strong>Unlocked beats:</strong> @string.Join(", ", unlocked)
                    </div>
                }

                <div class="row mt">
                    <button class="btn btn--sm btn--primary" @onclick="() => BookBlowoff(feud)">
                        @(State.InCareer ? "Put it on the card →" : "Book the blow-off →")
                    </button>
                    <button class="btn btn--sm btn--ghost" @onclick="() => State.Go(Screen.Segment)">Add another angle</button>
                </div>
            </div>
        }
    </div>
}

<div class="row mt">
    <button class="btn btn--ghost" @onclick="() => State.Go(State.HomeScreen)">← Main menu</button>
</div>

@code {
    private List<Feud> feuds = new();

    protected override void OnInitialized() => feuds = State.FeudBook.All.ToList();

    /// <summary>
    /// This used to be `State.Go(Screen.Match)` from anywhere, which in a career sent the
    /// player to the *exhibition sandbox* — a match that is not on any card and does not
    /// count — and dropped the pairing on the way. A button called "book the blowoff" that
    /// books nothing and forgets who it was about.
    ///
    /// It still cannot pre-fill the builder (the card screen owns that state), but it now
    /// at least lands on the show being booked, which is where a blow-off goes.
    /// </summary>
    private void BookBlowoff(Feud feud)
    {
        // The next show that has not run is where a blow-off goes. Falling back to the
        // calendar rather than to BookShow-with-no-show, which renders an empty screen.
        if (State.Career?.NextShow is { } next) State.OpenShow(next);
        else if (State.InCareer)                State.Go(Screen.Calendar);
        else                                    State.Go(Screen.Match);
    }

    /// <summary>
    /// What another match between these two would be worth against the first one —
    /// docs/wrestling-reference/20-storylines-and-feuds.md §9.1. Read against today,
    /// because a rested pairing recovers.
    /// </summary>
    private double Familiarity(Feud feud) => feud.Familiarity(State.Career?.CurrentDate);

    /// <summary>Beats this feud's state makes legal, matching MatchPlan.Validate.</summary>
    private static IEnumerable<string> UnlockedBeats(Feud feud)
    {
        if (feud.Intensity >= FeudIntensity.Building)
            yield return "Feud Erupts";

        if (feud.HasTag(FeudHistoryTag.FamilyInvolved) || feud.HasTag(FeudHistoryTag.ManagerConflict))
            yield return "Outside Party";
    }
}
