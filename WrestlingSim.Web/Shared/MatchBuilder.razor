@inject GameState State

@* Only the steps this booking actually has, numbered by where they sit in that list —
   so a match with no belt on the line does not show a skipped "3" and then jump to 4. *@
<div class="steps">
    @{ var shown = ActiveSteps(); }
    @for (int i = 0; i < shown.Count; i++)
    {
        var (index, label) = shown[i];
        <div class="step @(step == index ? "is-current" : step > index ? "is-done" : "")">
            <span class="step__n">@(step > index ? "✓" : (i + 1).ToString())</span>
            <span>@label</span>
        </div>
    }
    @* On a phone the labels collapse to bare numerals, which is a map with no place names.
       This is the one line that says where you are. *@
    <div class="steps__where small muted">
        @(shown.FindIndex(x => x.Index == step) + 1) of @shown.Count · @StepLabelFor(step)
    </div>
</div>

@* ── 1. Wrestlers ─────────────────────────────────────────────────────── *@
@if (step == 0)
{
    @* The search and division chips live in the picker sheet now, one set per slot. They
       used to be here, above four simultaneous lists, sharing a single query — so typing to
       find B's partner re-filtered corner A's list and the page reflowed underneath you. *@
    @if (State.BookingBrand is { } home)
    {
        <div class="notice notice--cost">
            <strong>Anyone outside @home.Name is a crossover.</strong>
            The picker offers your own brand first; turning on the other brands is one tap
            inside it, and every crossover name is marked with what it costs.
        </div>
    }

    <div class="panel">
        <div class="panel__title">What kind of match</div>
        <div class="picks picks--3">
            @for (int n = 1; n <= 3; n++)
            {
                int size = n;
                <button class="pick @(sideSize == size ? "is-selected" : "")"
                        @onclick="() => SetSideSize(size)">
                    <span class="pick__body">
                        <span class="pick__name">@SideSizeLabel(size)</span>
                        <span class="pick__desc">@SideSizeBlurb(size)</span>
                    </span>
                </button>
            }
        </div>
        @if (IsTeamMatch)
        {
            <div class="notice">
                A team match is worked as a formula: shine, cut-off, one of them kept from the
                corner, the tag denied, then the hot tag. The payoff is worth what the peril
                paid for it.
                @if (sideSize > 2)
                {
                    <text>
                        A third partner buys a deeper heat — three fresh opponents rotating on
                        whoever is cut off — and someone who has not been in the match yet to
                        finish it.
                    </text>
                }
            </div>
        }
    </div>

    @* ── The lineup ────────────────────────────────────────────────────────
       Slots, not lists. Four inline rosters used to render here at once with no way to
       collapse one after using it; a UX review measured a tag booking at ~116 pick cards
       and about seventeen phone screens, and at three a side on a seventy-name roster it
       is nearer thirty thousand pixels. Everything the lists did now lives in one
       RosterPicker sheet, opened from whichever slot you tapped. *@
    <div class="panel">
        <div class="panel__title">
            Who is in it
            <span class="spacer"></span>
            <span class="small muted">Side A wins by default in every preset</span>
        </div>

        <div class="lineup">
            <div class="lineup__side">
                @Slot(SlotRef.CornerA, IsTeamMatch ? "Side A — starts" : "Corner A", a)
                @for (int i = 0; i < sideSize - 1; i++)
                {
                    int index = i;
                    @Slot(SlotRef.PartnerA(index),
                          sideSize > 2 ? $"A's partner {index + 1}" : "A's partner",
                          partnersA.ElementAtOrDefault(index))
                }
            </div>

            <div class="lineup__vs">vs</div>

            <div class="lineup__side">
                @Slot(SlotRef.CornerB, IsTeamMatch ? "Side B — starts" : "Corner B", b)
                @for (int i = 0; i < sideSize - 1; i++)
                {
                    int index = i;
                    @Slot(SlotRef.PartnerB(index),
                          sideSize > 2 ? $"B's partner {index + 1}" : "B's partner",
                          partnersB.ElementAtOrDefault(index))
                }
            </div>
        </div>

        @* ── The consequence, where the decision is ─────────────────────────
           This used to be three Next-taps away, on the feud step, which the code comment
           on PairingHistory says exists so "a booker needs to know a pairing is worn out
           *while they can still book something else*". By the time you saw it, backing out
           meant re-scrolling the roster walls, so nobody backed out. *@
        @if (SidesComplete)
        {
            @if (PairingHistory is { MatchCount: > 0 } history)
            {
                <div class="notice @(PairingFamiliarity < 0.8 ? "notice--advice" : "notice--info") mt">
                    <strong>Meeting @NextMeeting.ToString("F1") — @((int)Math.Round(PairingFamiliarity * 100))% of what the first one drew.</strong>
                    @SideAName and @SideBName have met @history.MatchCount time@(history.MatchCount == 1 ? "" : "s").
                    @FreshnessAdvice
                </div>
            }

            @if (b is not null && a is not null && b.Division != a.Division)
            {
                <div class="notice notice--advice mt">
                    This is an intergender match — @a.RingName is in the @DivisionName(a.Division)
                    division and @b.RingName is in the @DivisionName(b.Division). Perfectly legal
                    to book, just an unusual call.
                </div>
            }
        }
    </div>

    @* Standing teams and team formation, once a side is complete. *@
    @if (IsTeamMatch)
    {
        @foreach (var side in TeamPanels())
        {
            <div class="panel">
                <div class="panel__title">
                    @side.Title
                    @if (side.Known is { } known) { <span class="badge badge--gold">@known.Name</span> }
                </div>
                @if (side.Known is { } team)
                {
                    <div class="notice">
                        <strong>@team.Name</strong> — @team.ChemistryLabel.ToLowerInvariant(),
                        @team.MatchesTogether match@(team.MatchesTogether == 1 ? "" : "es") together
                        over @team.TenureLabel(Today). Chemistry makes their tandem offence land
                        and lets the strongest of them carry the rest.
                    </div>
                }
                else
                {
                    <label class="check">
                        <input type="checkbox" checked="@side.Form"
                               @onchange="e => SetForm(side.IsA, (bool?)e.Value ?? false)" />
                        <span>Make them a standing team</span>
                    </label>
                    @if (side.Form)
                    {
                        <div class="field">
                            <span class="field__label">Team name</span>
                            @if (side.IsA)
                            {
                                <input class="input" @bind="teamNameA" maxlength="48" placeholder="@SideAName" />
                            }
                            else
                            {
                                <input class="input" @bind="teamNameB" maxlength="48" placeholder="@SideBName" />
                            }
                        </div>
                        <div class="notice">
                            A team starts with no chemistry and builds it by working together.
                            A team that stops teaming stops being one.
                        </div>
                    }
                }
            </div>
        }
    }
}

@* One slot in the lineup: a 76px button that either invites a pick or reports one. *@
@{
    RenderFragment Slot(SlotRef slot, string label, Wrestler? held) =>
    @<button class="slot @(held is null ? "is-empty" : "is-filled")"
             @onclick="() => openSlot = slot">
        <span class="label slot__label">@label</span>
        @if (held is { } w)
        {
            <span class="slot__name">@w.RingName</span>
            <span class="slot__meta">
                @w.CardPosition.Label() · @w.OvernessDisplay
                <Trend Momentum="@w.Momentum" ShowLabel="false" />
            </span>
        }
        else
        {
            <span class="slot__hint">Tap to pick</span>
        }
    </button>;
}

@* The beat detail sheet. Chips rather than selects — three native <select>s in a row was
   the single worst thing on a phone in this app. *@
@if (editing is { } edit)
{
    <div class="sheet sheet--short" role="dialog" aria-modal="true" aria-label="Edit beat">
        <div class="sheet__head">
            <div class="sheet__title">
                <span class="label">@BeatTypeName(edit.Type)</span>
                <span class="badge">@edit.DurationMinutes min</span>
            </div>
            <button class="btn btn--ghost btn--sm" @onclick="() => editing = null" aria-label="Close">✕</button>
        </div>
        <div class="sheet__body sheet__body--pad">
            @if (BeatLibrary.All.FirstOrDefault(t => t.Type == edit.Type)?.BookerTip is { } tip
                 && !string.IsNullOrWhiteSpace(tip))
            {
                <div class="notice notice--advice">ⓘ @tip</div>
            }

            <div class="field mt">
                <span class="field__label">Who is on top</span>
                <div class="chips">
                    @foreach (var v in Enum.GetValues<BeatControl>())
                    {
                        <button class="chip @(edit.Control == v ? "is-active" : "")"
                                @onclick="() => { edit.Control = v; }">@ControlLabel(v)</button>
                    }
                </div>
            </div>

            <div class="field mt">
                <span class="field__label">Intensity</span>
                <div class="chips">
                    @foreach (var v in Enum.GetValues<BeatIntensity>())
                    {
                        <button class="chip @(edit.Intensity == v ? "is-active" : "")"
                                @onclick="() => { edit.Intensity = v; }">@v</button>
                    }
                </div>
            </div>

            <div class="field mt">
                <span class="field__label">Length</span>
                <div class="chips">
                    @foreach (var v in Enum.GetValues<BeatDuration>())
                    {
                        <button class="chip @(edit.Duration == v ? "is-active" : "")"
                                @onclick="() => { edit.Duration = v; }">@v</button>
                    }
                </div>
            </div>

            <div class="row mt">
                <button class="btn btn--danger" disabled="@(!CanRemove(edit))"
                        @onclick="() => { beats.Remove(edit); editing = null; }">Remove this beat</button>
                <span class="spacer"></span>
                <button class="btn btn--primary" @onclick="() => editing = null">Done</button>
            </div>
        </div>
    </div>
    <div class="sheet__scrim" @onclick="() => editing = null"></div>
}

@* The picker itself, rendered once for whichever slot is open. *@
@if (openSlot is { } slot)
{
    <RosterPicker Title="@SlotTitle(slot)"
                  Current="@SlotHolder(slot)"
                  UsedAs="@BookedAs"
                  Against="@OpposingSide(slot)"
                  Picked="@(w => FillSlot(slot, w))"
                  Cancelled="@(() => openSlot = null)" />
}

@* ── 2. Match type ────────────────────────────────────────────────────── *@
@if (step == 1)
{
    <div class="panel">
        <div class="panel__title">Match type</div>
        <div class="picks">
            @foreach (var t in Enum.GetValues<MatchType>())
            {
                <button class="pick @(matchType == t ? "is-selected" : "")" @onclick="() => matchType = t">
                    <span class="pick__body">
                        <span class="pick__name">@t</span>
                        <span class="pick__desc">@TypeBlurb(t)</span>
                    </span>
                    <span class="pick__meta">@TypeWeights(t)</span>
                </button>
            }
        </div>
        <div class="notice notice--tip mt">
            The type you declare shifts how the match is graded <em>and</em> what it is graded
            against. Book a plan that delivers what you advertised and you are paid for it;
            declare a technical classic and book a brawl and you are not.
            <strong>Standard</strong> promises nothing specific — the safe choice, never the free one.
        </div>
    </div>
}


@* ── 3. Championship ──────────────────────────────────────────────────── *@
@if (step == 2)
{
    <div class="panel">
        <div class="panel__title">Championship</div>

        @if (SelectableTitles().Count == 0)
        {
            <div class="notice notice--info">
                No belt can be put on the line in this match. A title is only defended in a
                match its champion is in.
            </div>
        }

        <div class="picks">
            <button class="pick @(title is null ? "is-selected" : "")" @onclick="() => title = null">
                <span class="pick__body">
                    <span class="pick__name">No title</span>
                    <span class="pick__desc">
                        A straight match. If either of these two is a champion, losing it still
                        costs their belt a little — a champion beaten anywhere is a champion
                        the audience has seen beaten.
                    </span>
                </span>
            </button>

            @foreach (var t in SelectableTitles())
            {
                <button class="pick @(title == t ? "is-selected" : "")" @onclick="() => title = t">
                    <span class="pick__body">
                        <span class="pick__name">
                            @t.Name
                            <span class="badge badge--gold">@t.TierLabel</span>
                            @if (t.IsTagTitle) { <span class="badge">tag</span> }
                        </span>
                        <span class="pick__desc">
                            @if (t.CurrentReign is { } reign)
                            {
                                <text>
                                    @reign.ChampionName — @t.CurrentReignDays(Today) day@(t.CurrentReignDays(Today) == 1 ? "" : "s"),
                                    @t.CurrentDefences defence@(t.CurrentDefences == 1 ? "" : "s")
                                </text>
                            }
                            else
                            {
                                <text>Vacant — this match decides it.</text>
                            }
                        </span>
                    </span>
                    @* PrestigeLabel — the string that says "genuinely prestigious" — existed,
                       and was used in the tip *below* this list rather than on the option you
                       are choosing between. "Prestige 68" is not a consequence. *@
                    <span class="pick__meta">@t.PrestigeLabel<br />+@t.StakesBonus.ToString("F0") crowd at the bell</span>
                </button>
            }
        </div>

        @if (title is not null)
        {
            <div class="notice notice--tip mt">
                <strong>@title.Name — prestige @title.Prestige.ToString("F1").</strong>
                @title.PrestigeLabel. Worth +@title.StakesBonus.ToString("F0") crowd energy at the bell.
                <br />
                Titles do not change hands on a disqualification or a count-out. Book one of
                those and the champion walks out still champion, whoever won the match.
            </div>
        }
    </div>
}

@* ── 4. Feud ──────────────────────────────────────────────────────────── *@
@if (step == 3)
{
    <div class="panel">
        <div class="panel__title">Feud</div>

        @if (existingFeud is not null && existingFeud.Intensity > FeudIntensity.None)
        {
            <p class="small muted">
                @a!.RingName and @b!.RingName have history you have booked. Using it raises the
                crowd's starting energy and unlocks feud-gated beats.
            </p>

            <button class="pick @(feudChoice == FeudChoice.UseExisting ? "is-selected" : "")"
                    @onclick="() => feudChoice = FeudChoice.UseExisting">
                <span class="pick__body">
                    <span class="pick__name">
                        Use the booked feud
                        <span class="badge @FeudUpdates.IntensityBadge(existingFeud.Intensity)">@existingFeud.Intensity</span>
                    </span>
                    <span class="pick__desc">
                        @existingFeud.Heat.ToString("F0") heat · @existingFeud.MatchCount match@(existingFeud.MatchCount == 1 ? "" : "es")
                        @if (existingFeud.History.Count > 0)
                        {
                            <text> · @string.Join(", ", existingFeud.History)</text>
                        }
                    </span>
                </span>
            </button>
        }
        else
        {
            <div class="notice notice--info">
                @a!.RingName and @b!.RingName have no booked history. Book segments between them
                to build a feud properly, or declare one by hand below.
            </div>
        }

        <div class="picks mt">
            <button class="pick @(feudChoice == FeudChoice.Declare ? "is-selected" : "")"
                    @onclick="() => feudChoice = FeudChoice.Declare">
                <span class="pick__body">
                    <span class="pick__name">Declare a feud by hand</span>
                    <span class="pick__desc">Written into the feud book so later segments build on it.</span>
                </span>
            </button>

            <button class="pick @(feudChoice == FeudChoice.None ? "is-selected" : "")"
                    @onclick="() => feudChoice = FeudChoice.None">
                <span class="pick__body">
                    <span class="pick__name">No feud</span>
                    <span class="pick__desc">A straight contest with nothing personal behind it.</span>
                </span>
            </button>
        </div>

        @if (feudChoice == FeudChoice.Declare)
        {
            <div class="panel panel--flat mt">
                <div class="field">
                    <span class="field__label">Intensity</span>
                    <select class="select" @bind="declaredIntensity">
                        @foreach (var i in new[] { FeudIntensity.Cold, FeudIntensity.Building, FeudIntensity.Hot, FeudIntensity.Nuclear })
                        {
                            <option value="@i">@i — @Feud.HeatFor(i).ToString("F0") heat</option>
                        }
                    </select>
                </div>

                <div class="field mt">
                    <span class="field__label">History tags</span>
                    <div class="badge-row">
                        @foreach (var tag in Enum.GetValues<FeudHistoryTag>())
                        {
                            <button class="btn btn--sm @(declaredTags.Contains(tag) ? "btn--primary" : "btn--ghost")"
                                    @onclick="() => ToggleTag(tag)">
                                @tag
                            </button>
                        }
                    </div>
                </div>
            </div>
        }

        @* The blow-off declaration. Only offered where it means something — you cannot
           settle a story that has no feud attached, and you cannot settle one twice. *@
        @if (feudChoice != FeudChoice.None && !AlreadyConcluded)
        {
            <div class="panel panel--flat mt">
                <button class="pick @(isBlowOff ? "is-selected" : "")"
                        @onclick="() => isBlowOff = !isBlowOff">
                    <span class="pick__body">
                        <span class="pick__name">
                            This is the blow-off
                            <span class="badge @(BlowOffWorthIt ? "badge--gold" : "badge--heel")">
                                ×@BlowOffPayoff.ToString("F2") on the finish@(BlowOffWorthIt ? "" : " — unearned")
                            </span>
                        </span>
                        <span class="pick__desc">
                            The story ends here. The feud is settled, its heat goes to zero, and
                            this pairing starts again from nothing. It has to <em>end</em>, though —
                            a blow-off booked to a disqualification or a count-out settles nothing
                            and costs more than not declaring one.
                        </span>
                    </span>
                </button>

                @if (!BlowOffWorthIt)
                {
                    <div class="notice notice--warn mt">
                        This feud is @PendingIntensity. A blow-off is worth what was built —
                        settling a story the audience was never told mattered lands
                        <strong>worse</strong> than not declaring one at all. Build it to Hot first.
                    </div>
                }
                else if (existingFeud is { } tired && tired.MatchesSinceHot > Feud.PatienceMatches)
                {
                    <div class="notice notice--warn mt">
                        @tired.MatchesSinceHot matches and nothing settled. The crowd has started
                        to assume this one is not going anywhere either, and this pairing is
                        drawing @((int)Math.Round(tired.Credibility * 100))% of what it should.
                        Settling it earns some of that back.
                    </div>
                }
            </div>
        }
        else if (AlreadyConcluded)
        {
            <div class="notice notice--info mt">
                This feud has already been blown off. That story is over — these two need a new
                reason to fight before there is anything to settle.
            </div>
        }
    </div>
}

@* ── 5. Structure ─────────────────────────────────────────────────────── *@
@if (step == 4)
{
    <div class="panel">
        <div class="panel__title">Match structure</div>
        <div class="picks">
            @foreach (var s in MatchStructureLibrary.ForSideSize(SideSize))
            {
                var blocked = s.RequiresFeud && feud is null;
                <button class="pick @(structureName == s.Name ? "is-selected" : "")"
                        disabled="@blocked"
                        @onclick="() => PickStructure(s)">
                    <span class="pick__body">
                        <span class="pick__name">
                            @s.Name
                            @if (blocked) { <span class="badge badge--heel">needs a feud</span> }
                        </span>
                        <span class="pick__desc">@s.Description</span>
                    </span>
                    <span class="pick__meta">@s.Beats.Count beats</span>
                </button>
            }

            <button class="pick @(structureName == "Custom" ? "is-selected" : "")" @onclick="PickCustom">
                <span class="pick__body">
                    <span class="pick__name">Build from scratch</span>
                    <span class="pick__desc">An opening and a finish, pre-loaded. Add the rest yourself.</span>
                </span>
                <span class="pick__meta">2 beats</span>
            </button>
        </div>
    </div>
}

@* ── 6. Beat editor ───────────────────────────────────────────────────── *@
@if (step == 5)
{
    <div class="panel">
        <div class="versus">
            <div class="versus__side">
                <div class="versus__corner">@(IsTeamMatch ? "Side A" : "Corner A")</div>
                <div class="versus__name">@SideAName</div>
                <div class="versus__meta">@a.CardPosition.Label() · @a.OvernessDisplay</div>
            </div>
            <div class="versus__vs">VS</div>
            <div class="versus__side">
                <div class="versus__corner">@(IsTeamMatch ? "Side B" : "Corner B")</div>
                <div class="versus__name">@SideBName</div>
                <div class="versus__meta">@b.CardPosition.Label() · @b.OvernessDisplay</div>
            </div>
        </div>

        @if (feud is not null)
        {
            <div class="notice notice--tip mt">
                <strong>@feud.Intensity feud</strong> — @feud.Heat.ToString("F0") heat,
                +@feud.StartingEnergyBonus starting crowd energy.
                @if (feud.History.Count > 0)
                {
                    <text> History: @string.Join(", ", feud.History).</text>
                }
            </div>
        }

        @if (PairingFamiliarity < 0.99)
        {
            <div class="notice notice--advice mt">
                <strong>Crowd interest in this pairing: @((int)Math.Round(PairingFamiliarity * 100))%.</strong>
                The beat sheet is graded as written — the room is what shrinks.
            </div>
        }
    </div>

    @* Above the sheet, not below the library. On a phone these used to render past both
       and so were off-screen while you were doing the thing that triggered them. *@
    @if (errors.Count > 0)
    {
        <div class="notice notice--error mb">
            <strong>This plan will not run:</strong>
            <ul>@foreach (var e in errors) { <li>@e</li> }</ul>
        </div>
    }

    @if (HotTagWarning() is { } hotTagAdvice)
    {
        <div class="notice notice--advice mb">@hotTagAdvice</div>
    }

    <div class="panel">
        <div class="panel__title">
            Beat sheet
            <span class="spacer"></span>
            <span class="small muted">~@RuntimeMinutes min · @beats.Count beats</span>
        </div>

        @* One row, one tap target.
           Below 640px each row used to become a stacked card carrying three full-width
           native selects plus three icon buttons — about 200px a beat, so a seven-beat
           Technical Showcase was ~1,400px before you added anything, and each of the three
           commonest edits opened a full-screen wheel picker on iOS. The row is now a
           summary; the edits live in a sheet with chips. *@
        @for (int index = 0; index < beats.Count; index++)
        {
            var i = index;
            var beat = beats[i];

            @* A place to insert, rather than "add at the end and press ↑ six times". *@
            <button class="beat-gap" title="Insert a beat here" @onclick="() => OpenLibraryAt(i)">+</button>

            <div class="beat-row @(beat.IsFinish ? "is-finish" : beat.IsOpening ? "is-opening" : "")">
                <div class="beat-row__n">@(i + 1)</div>
                <button class="beat-row__body" @onclick="() => editing = beat">
                    <span class="beat-row__name">@BeatTypeName(beat.Type)</span>
                    <span class="beat-row__sub">
                        @ControlLabel(beat.Control) · @beat.Intensity · @beat.Duration · @beat.DurationMinutes min
                    </span>
                </button>
                <div class="beat-row__move">
                    <button class="btn btn--icon btn--ghost" disabled="@(i == 0)"
                            title="Move up" @onclick="() => Move(i, -1)">↑</button>
                    <button class="btn btn--icon btn--ghost" disabled="@(i == beats.Count - 1)"
                            title="Move down" @onclick="() => Move(i, 1)">↓</button>
                </div>
            </div>
        }
        <button class="beat-gap" title="Add a beat at the end" @onclick="() => OpenLibraryAt(beats.Count)">+</button>

        <div class="row mt">
            <button class="btn" @onclick="ToggleLibrary">
                @(showAddBeat ? "Close beat library" : "+ Add a beat")
            </button>
        </div>

        @if (showAddBeat)
        {
            <div class="panel panel--flat mt">
                @* Gated beats are hidden rather than greyed. In a singles match the whole
                   Tag category — eleven of the library's forty-four — rendered disabled at
                   45% opacity: a quarter of the list as scroll-tax you can never use.
                   GateFor already knows which; it just showed them anyway. *@
                @{ var blocked = BeatLibrary.All.Count(x => GateFor(x) is not null); }
                @if (blocked > 0)
                {
                    <label class="check">
                        <input type="checkbox" @bind="showGatedBeats" />
                        <span>Show @blocked beat@(blocked == 1 ? "" : "s") this match cannot use</span>
                    </label>
                }
                @if (justAdded is { } added)
                {
                    <div class="notice notice--info">Added <strong>@added</strong>. Keep going — the library stays open.</div>
                }
                @foreach (var category in BeatLibrary.Categories)
                {
                    var offered = BeatLibrary.ByCategory(category)
                                             .Where(x => showGatedBeats || GateFor(x) is null)
                                             .ToList();
                    if (offered.Count == 0) { continue; }

                    <div class="group-label">@category</div>
                    <div class="picks">
                        @foreach (var t in offered)
                        {
                            var gate = GateFor(t);
                            <button class="pick" disabled="@(gate is not null)" @onclick="() => AddBeat(t)">
                                <span class="pick__body">
                                    <span class="pick__name">
                                        @t.Name
                                        @if (gate is not null) { <span class="badge badge--heel">@gate</span> }
                                    </span>
                                    <span class="pick__desc">@t.Description</span>
                                    @if (!string.IsNullOrWhiteSpace(t.BookerTip))
                                    {
                                        <span class="pick__desc gold">ⓘ @t.BookerTip</span>
                                    }
                                </span>
                                <span class="pick__meta">@t.DefaultIntensity<br />@t.DefaultDuration</span>
                            </button>
                        }
                    </div>
                }
            </div>
        }
    </div>

}

@* ── Wizard controls ──────────────────────────────────────────────────── *@
@* Sticky on mobile so Next is always reachable without scrolling past a long
   beat sheet or a 30-name roster list. *@
<div class="wizard-bar wizard-bar--sticky">
    <button class="btn btn--ghost" @onclick="Back">@(step == 0 ? "← Cancel" : "← Back")</button>
    <span class="wizard-bar__spacer"></span>
    @* A greyed button and silence is not an explanation. This says what is missing. *@
    @if (Blocker() is { } missing)
    {
        <span class="small muted wizard-bar__why">@missing</span>
    }
    @if (step < LastStep)
    {
        <button class="btn btn--primary" disabled="@(!CanAdvance)" @onclick="Next">Next →</button>
    }
    else
    {
        <button class="btn btn--primary" @onclick="Finish">@ConfirmLabel</button>
    }
</div>

@code {
    [Parameter, EditorRequired] public EventCallback<BookedMatch> OnDone { get; set; }
    [Parameter] public EventCallback OnCancel { get; set; }

    /// <summary>Label for the final button — "Run the match" vs "Add to card".</summary>
    [Parameter] public string ConfirmLabel { get; set; } = "Run the match ★";

    private enum FeudChoice { UseExisting, Declare, None }

    private static readonly (int Index, string Label)[] StepLabels =
    [
        (0, "Wrestlers"), (1, "Type"), (2, "Title"), (3, "Feud"), (4, "Structure"), (5, "Beats")
    ];

    private static readonly int LastStep = StepLabels[^1].Index;

    private List<(int Index, string Label)> ActiveSteps() =>
        StepLabels.Where(x => x.Index == step || StepApplies(x.Index)).ToList();

    private static string StepLabelFor(int index) =>
        StepLabels.FirstOrDefault(x => x.Index == index).Label ?? "";

    private int step;

    // The two starters. Partners are separate rather than a list, so every feud, title and
    // familiarity lookup keyed on the pair keeps reading the way it always did — those are
    // side-keyed in phase 5, not here.
    private Wrestler? a, b;

    /// <summary>
    /// The partners, one slot per extra man a side. A list rather than a single field
    /// because a trios side has two — three a side is still two sides, so nothing else in
    /// the builder had to change (docs/wrestling-reference/18-match-craft.md §2.5).
    /// </summary>
    private readonly List<Wrestler?> partnersA = new();
    private readonly List<Wrestler?> partnersB = new();

    /// <summary>People per side. 1 singles, 2 tag, 3 trios.</summary>
    private int sideSize = 1;

    private int SideSize => sideSize;
    private bool IsTeamMatch => sideSize > 1;

    /// <summary>
    /// Both sides fully picked.
    ///
    /// This used to read `partnersA.Take(sideSize - 1).All(w => w is not null)`, which is
    /// vacuously true on an empty list — `partnersA` starts empty and only grows when a
    /// slot is clicked. So the gate passed with no partners chosen at all, and `Finish()`
    /// went on to build `MatchSide.Of(a)` vs `MatchSide.Of(b)`: a perfectly valid *singles*
    /// match, booked silently for a player who asked for a tag or trios one.
    ///
    /// `MembersA` already filters nulls and caps at `sideSize`, so counting it is the whole
    /// check — it can only reach `sideSize` when the corner and every partner slot is
    /// filled.
    /// </summary>
    private bool SidesComplete =>
        MembersA.Count() == sideSize && MembersB.Count() == sideSize;

    // ── Slots ────────────────────────────────────────────────────────────
    //
    // A slot is a place in the lineup, and the picker sheet is opened against one. This
    // replaces four inline roster lists with four buttons and one sheet — see the file
    // comment on RosterPicker for what that was costing.

    private readonly record struct SlotRef(bool IsA, int Partner)
    {
        public static SlotRef CornerA => new(true, -1);
        public static SlotRef CornerB => new(false, -1);
        public static SlotRef PartnerA(int i) => new(true, i);
        public static SlotRef PartnerB(int i) => new(false, i);
        public bool IsCorner => Partner < 0;
    }

    private SlotRef? openSlot;

    private string SlotTitle(SlotRef slot) =>
        slot.IsCorner
            ? (IsTeamMatch ? $"Side {(slot.IsA ? "A" : "B")} — who starts" : $"Corner {(slot.IsA ? "A" : "B")}")
            : sideSize > 2
                ? $"{(slot.IsA ? "A" : "B")}'s partner {slot.Partner + 1}"
                : $"{(slot.IsA ? "A" : "B")}'s partner";

    private Wrestler? SlotHolder(SlotRef slot) =>
        slot.IsCorner
            ? (slot.IsA ? a : b)
            : (slot.IsA ? partnersA : partnersB).ElementAtOrDefault(slot.Partner);

    /// <summary>
    /// The side this slot is being picked *against*, which is what the picker sorts by.
    /// Empty while the other side is still empty — there is nothing to have a story with yet.
    /// </summary>
    private IReadOnlyList<Wrestler> OpposingSide(SlotRef slot) =>
        (slot.IsA ? MembersB : MembersA).ToList();

    /// <summary>What a name is already booked as, so the picker can show it rather than hide it.</summary>
    private string? BookedAs(Wrestler w)
    {
        if (a == w) return IsTeamMatch ? "Side A" : "Corner A";
        if (b == w) return IsTeamMatch ? "Side B" : "Corner B";
        int i = partnersA.IndexOf(w);
        if (i >= 0) return sideSize > 2 ? $"A's partner {i + 1}" : "A's partner";
        i = partnersB.IndexOf(w);
        if (i >= 0) return sideSize > 2 ? $"B's partner {i + 1}" : "B's partner";
        return null;
    }

    /// <summary>
    /// Puts a name in a slot. Choosing somebody already booked elsewhere *swaps* the two
    /// rather than silently emptying the other — which is what the old pickers did, with no
    /// warning and no visual cue that the name had been in use.
    /// </summary>
    private void FillSlot(SlotRef slot, Wrestler w)
    {
        var displaced = SlotHolder(slot);
        var vacated   = SlotOf(w);

        Assign(slot, w);
        if (vacated is { } from && !from.Equals(slot)) Assign(from, displaced);

        openSlot = null;
    }

    private SlotRef? SlotOf(Wrestler w)
    {
        if (a == w) return SlotRef.CornerA;
        if (b == w) return SlotRef.CornerB;
        int i = partnersA.IndexOf(w);
        if (i >= 0) return SlotRef.PartnerA(i);
        i = partnersB.IndexOf(w);
        if (i >= 0) return SlotRef.PartnerB(i);
        return null;
    }

    private void Assign(SlotRef slot, Wrestler? w)
    {
        if (slot.IsCorner)
        {
            if (slot.IsA) a = w; else b = w;
            return;
        }

        var slots = slot.IsA ? partnersA : partnersB;
        while (slots.Count <= slot.Partner) slots.Add(null);
        slots[slot.Partner] = w;
    }

    private sealed record TeamPanel(bool IsA, string Title, TagTeam? Known, bool Form);

    private IEnumerable<TeamPanel> TeamPanels()
    {
        if (MembersA.Count() == sideSize)
            yield return new TeamPanel(true, "Side A", ExistingTeamA, formTeamA);
        if (MembersB.Count() == sideSize)
            yield return new TeamPanel(false, "Side B", ExistingTeamB, formTeamB);
    }

    private void SetForm(bool isA, bool value)
    {
        if (isA) formTeamA = value; else formTeamB = value;
    }

    private IEnumerable<Wrestler> MembersA =>
        new[] { a }.Concat(partnersA.Take(sideSize - 1)).Where(w => w is not null)!;

    private IEnumerable<Wrestler> MembersB =>
        new[] { b }.Concat(partnersB.Take(sideSize - 1)).Where(w => w is not null)!;

    private string SideAName => string.Join(" & ", MembersA.Select(w => w.RingName));
    private string SideBName => string.Join(" & ", MembersB.Select(w => w.RingName));

    /// <summary>Everyone already picked, so no name can be used twice.</summary>
    private IEnumerable<Wrestler> Chosen => MembersA.Concat(MembersB);

    private static string SideSizeLabel(int n) => n switch
    {
        1 => "Singles",
        2 => "Tag team",
        _ => "Trios"
    };

    private static string SideSizeBlurb(int n) => n switch
    {
        1 => "One against one.",
        2 => "Two a side, with a corner to be kept away from.",
        _ => "Three a side. Three fresh opponents on whoever is cut off, and a fresh partner to finish."
    };
    private MatchType matchType = MatchType.Standard;
    private Title? title;

    private DateOnly Today => State.Career?.CurrentDate ?? DateOnly.FromDateTime(DateTime.Today);

    /// <summary>
    /// Belts that could actually be on the line here. A championship is only defended in
    /// a match its champion is in — anything else is a non-title match with a misleading
    /// name on it, which MatchPlan.Validate rejects. A vacant belt is open to anyone.
    /// </summary>
    private List<Title> SelectableTitles() =>
        State.Titles.Active
            // A belt can only be contested by the shape of match it is contested by. Before
            // this check every tag booking was offered all three vacant singles belts and
            // only found out at the final click, three steps later, that none of them was
            // legal.
            .Where(t => t.SideSize == SideSize)
            // And the holders have to be *in* it — all of them, not just whoever happens to
            // be listed first or starting.
            .Where(t => t.IsVacant || t.Champions.All(Chosen.Contains))
            .OrderByDescending(t => t.Prestige)
            .ToList();



    // includeCrossover and FilteredRoster moved into RosterPicker, which is now the only
    // place the roster is filtered. The identical query lived here and in SegmentBuilder,
    // which is why every improvement to selection had to be made in five places and so
    // never was.

    private static string DivisionName(Division d) => d == Division.Womens ? "women's" : "men's";

    private static string TypeBlurb(MatchType t) => t switch
    {
        MatchType.Technical    => "Graded mostly on ring work. Wants mat wrestling, holds and a submission payoff.",
        MatchType.Storytelling => "Graded mostly on story. Wants psychology, callbacks and near-falls.",
        MatchType.Spotfest     => "Graded mostly on crowd reaction. Wants high spots, brawling and comebacks.",
        _                      => "Balanced grading with no preference about how you get there."
    };

    /// <summary>
    /// Component weights for a type, one per line. .pick__meta honours the breaks on
    /// desktop and reflows them below the description on a phone.
    /// </summary>
    private static string TypeWeights(MatchType t)
    {
        var (tech, story, crowd) = t switch
        {
            MatchType.Technical    => (46, 24, 30),
            MatchType.Storytelling => (24, 42, 34),
            MatchType.Spotfest     => (30, 22, 48),
            _                      => (35, 30, 35)
        };
        return $"Tech {tech}%\nStory {story}%\nCrowd {crowd}%";
    }

    private Feud? existingFeud;
    private Feud? feud;

    // ── Pairing freshness ────────────────────────────────────────────────
    // docs/wrestling-reference/20-storylines-and-feuds.md §9.1. Shown before the match is
    // booked rather than after it is run: a booker needs to know a pairing is worn out
    // while they can still book something else.

    /// <summary>
    /// The pair's record, feud or not. A pairing the crowd is sick of is sick of it
    /// whether or not the booker attaches a story to tonight's match.
    /// </summary>
    private Feud? PairingHistory
    {
        get
        {
            if (a is null || b is null) return null;

            // The freshness panel has to read the feud the simulator will actually use, or
            // it advises on a pairing that is not the one being booked.
            return State.FeudBook.Find(MembersA.ToList(), MembersB.ToList());
        }
    }

    /// <summary>
    /// The night this would be seen. The card being written, if there is one, because
    /// freshness recovers between now and then.
    /// </summary>
    private DateOnly? PairingDate => State.ActiveShow?.Date ?? State.Career?.CurrentDate;

    private double PairingFamiliarity => PairingHistory?.Familiarity(PairingDate) ?? 1.0;

    private double NextMeeting => PairingHistory?.NextMeetingNumber(PairingDate) ?? 1.0;

    private string FreshnessAdvice => PairingFamiliarity switch
    {
        >= 0.99 => "Enough time has passed that the crowd will take it as new.",
        >= 0.88 => "Still worth running.",
        >= 0.75 => "Getting familiar. A hot feud makes the third one feel like an ending.",
        >= 0.60 => "Three matches is the natural life of a pairing. This is past it.",
        _       => "Rest this one. Time is the only thing that brings it back."
    };
    private FeudChoice feudChoice = FeudChoice.None;
    private FeudIntensity declaredIntensity = FeudIntensity.Building;
    private readonly List<FeudHistoryTag> declaredTags = new();

    /// <summary>The booker declaring that this match ends the story. See MatchPlan.IsBlowOff.</summary>
    private bool isBlowOff;

    /// <summary>
    /// The intensity the blow-off would actually be priced at — the booked feud's when
    /// using one, the declared level when declaring one. Priced before the feud exists,
    /// which is why <see cref="Feud.PayoffFor"/> is a static.
    /// </summary>
    private FeudIntensity PendingIntensity => feudChoice == FeudChoice.UseExisting
        ? existingFeud?.Intensity ?? FeudIntensity.None
        : declaredIntensity;

    private double BlowOffPayoff => Feud.PayoffFor(PendingIntensity);
    private bool BlowOffWorthIt => PendingIntensity >= FeudIntensity.Hot;
    private bool AlreadyConcluded =>
        feudChoice == FeudChoice.UseExisting && existingFeud is { Concluded: true };

    private string structureName = "";
    private List<MatchBeat> beats = new();
    private bool showAddBeat;

    /// <summary>Whether the library also lists beats this match's shape cannot book.</summary>
    private bool showGatedBeats;

    /// <summary>The beat whose detail sheet is open, if any.</summary>
    private MatchBeat? editing;

    /// <summary>
    /// Who has control, short enough to fit.
    ///
    /// The old select rendered `A — Ricky Steamboat & Robert Gibson` inside a 190px
    /// `max-width`, so in a tag match both options could truncate to the same string. The
    /// side names are shown once above the sheet in `.versus`, which is where they belong.
    /// </summary>
    private string ControlLabel(BeatControl control) => control switch
    {
        BeatControl.WrestlerA => IsTeamMatch ? "Side A" : (a?.RingName ?? "A"),
        BeatControl.WrestlerB => IsTeamMatch ? "Side B" : (b?.RingName ?? "B"),
        BeatControl.Even      => "Even",
        _                     => "Contested"
    };
    private List<string> errors = new();

    private int RuntimeMinutes => 2 + beats.Sum(x => x.DurationMinutes);

    private bool CanAdvance => Blocker() is null;

    /// <summary>
    /// What is stopping Next, in words. The bar used to disable the button and say nothing,
    /// which on a phone means a greyed control and a page you have to re-read to work out
    /// what you missed.
    /// </summary>
    private string? Blocker() => step switch
    {
        0 when a is null => IsTeamMatch ? "Pick who starts for side A" : "Pick corner A",
        0 when MembersA.Count() < sideSize
            => sideSize > 2 ? "Side A needs two partners" : "Pick A's partner",
        0 when b is null => IsTeamMatch ? "Pick who starts for side B" : "Pick corner B",
        0 when MembersB.Count() < sideSize
            => sideSize > 2 ? "Side B needs two partners" : "Pick B's partner",
        4 when beats.Count == 0 => "A match needs at least one beat",
        _ => null
    };

    // ── Which steps exist ────────────────────────────────────────────────
    //
    // The championship step is empty for most matches — SelectableTitles() correctly
    // returns nothing unless a champion is in it — and a step whose entire content is one
    // "no titles apply" notice and a button you must tap past is not a step, it is a toll.
    // Same for the feud step when the pairing has no history and there is nothing to
    // declare. Both are skipped rather than shown empty.

    private const int TitleStep = 2;
    private const int FeudStep  = 3;

    private bool StepApplies(int index) => index switch
    {
        TitleStep => SelectableTitles().Any(),
        _         => true
    };

    // ── Navigation ───────────────────────────────────────────────────────

    private void Next()
    {
        if (step == 0)
        {
            existingFeud = PairingHistory;
            // Reset with the pairing. Left latched, a blow-off ticked for one pair survived
            // a Back-and-change to another whose feud was already settled — the toggle is
            // hidden in that state, so Finish() produced "has already been blown off" with
            // no control on screen to clear it.
            isBlowOff    = false;
            feudChoice = existingFeud is not null && existingFeud.Intensity > FeudIntensity.None
                ? FeudChoice.UseExisting
                : FeudChoice.None;

            // The pair changed, so a belt picked for a previous pair may no longer be legal.
            if (title is not null && !SelectableTitles().Contains(title)) title = null;
        }

        if (step == FeudStep) ResolveFeud();

        step++;
        while (step < LastStep && !StepApplies(step)) step++;
    }

    private async Task Back()
    {
        if (step == 0)
        {
            await OnCancel.InvokeAsync();
            return;
        }

        step--;
        while (step > 0 && !StepApplies(step)) step--;
    }

    // PickA / PickB / PickPartner / Release are gone. Four pickers with four subtly
    // different exclusion predicates are now one FillSlot, which *swaps* rather than
    // silently nulling — the old Release cleared the other slot with no warning and no
    // visual cue that the name had been in use.

    /// <summary>
    /// Changing the shape of the match. Clears the structure and beats, because a preset
    /// written for one side size does not validate against another — leaving a stale one
    /// selected would hand the player a plan that cannot be booked.
    /// </summary>
    private void SetSideSize(int value)
    {
        if (sideSize == value) return;
        sideSize = value;
        partnersA.Clear();
        partnersB.Clear();
        formTeamA = formTeamB = false;
        structureName = "";
        beats = new List<MatchBeat>();
    }

    private void ToggleTag(FeudHistoryTag tag)
    {
        if (!declaredTags.Remove(tag)) declaredTags.Add(tag);
    }

    private void ResolveFeud()
    {
        switch (feudChoice)
        {
            case FeudChoice.UseExisting:
                feud = existingFeud;
                break;

            case FeudChoice.Declare:
                // Declared feuds go into the book so later segments build on them.
                var declared = State.FeudBook.GetOrCreate(MembersA.ToList(), MembersB.ToList());
                declared.SetMinimumIntensity(declaredIntensity);
                foreach (var tag in declaredTags) declared.AddTag(tag);
                feud = declared;
                break;

            default:
                feud = null;
                break;
        }
    }

    private void PickStructure(MatchStructure s)
    {
        structureName = s.Name;
        // Clone: the library's beats are shared singletons.
        beats = s.Beats.Select(x => x.Clone()).ToList();
    }

    private void PickCustom()
    {
        structureName = "Custom";
        beats =
        [
            BeatLibrary.Find("Standard Collar-and-Elbow")!.ToMatchBeat(BeatControl.Even),
            BeatLibrary.Find("Clean Victory")!.ToMatchBeat(BeatControl.WrestlerA),
        ];
    }

    /// <summary>
    /// Advice shown in the beat editor when the plan books a hot tag it has not paid for.
    /// Deliberately a warning and not a gate — booking it cold is legal, it just lands at
    /// barely half, and that is the player's call to make.
    /// </summary>
    private string? HotTagWarning()
    {
        foreach (var beat in beats.Where(x => x.Type == BeatType.HotTag))
        {
            int at = beats.IndexOf(beat);

            // Only what is still charged. A plain tag on the same side spends the charge —
            // MatchEngineState.Tag clears it — so peril booked before one of those buys
            // this hot tag nothing, and the warning has to see that.
            int since = beats.Take(at).ToList()
                .FindLastIndex(x => x.IsTagChange && x.Control == beat.Control) + 1;

            var charged = beats.Skip(since).Take(at - since).ToList();
            bool isolated = charged.Any(x => x.Type == BeatType.Isolation && x.Control != beat.Control);
            bool nearTag  = charged.Any(x => x.Type == BeatType.NearTag && x.Control != beat.Control);

            if (!isolated && !nearTag)
                return "This hot tag has no Face in Peril and no Near Tag still standing behind " +
                       "it, so there is nothing for it to release. It will land at about half " +
                       "of what it could.";

            if (!isolated)
                return "This hot tag has denied tags behind it but no Face in Peril. It will " +
                       "land, but nowhere near what a proper heat would have bought.";
        }
        return null;
    }

    // ── Teams ────────────────────────────────────────────────────────────

    private bool formTeamA, formTeamB;
    private string teamNameA = "", teamNameB = "";

    /// <summary>The standing team these two are, if the career knows them as one.</summary>
    private TagTeam? TeamFor(MatchSide side) =>
        side.IsTag ? State.Career?.TeamFor(side.Members) : null;

    private TagTeam? ExistingTeamA =>
        IsTeamMatch && MembersA.Count() == sideSize ? State.Career?.TeamFor(MembersA) : null;

    private TagTeam? ExistingTeamB =>
        IsTeamMatch && MembersB.Count() == sideSize ? State.Career?.TeamFor(MembersB) : null;

    private TagTeam FormTeam(MatchSide side, string name)
    {
        var team = new TagTeam
        {
            Name    = string.IsNullOrWhiteSpace(name) ? side.Name : name.Trim(),
            Members = side.Members.ToList(),
            Formed  = Today
        };
        State.Career!.Teams.Add(team);
        return team;
    }

    // ── Beat editing ─────────────────────────────────────────────────────

    // SetControl / SetIntensity / SetDuration are gone with the three <select>s that
    // needed them — the sheet binds the enums directly.

    private bool CanRemove(MatchBeat beat) =>
        !(beat.IsOpening && beats.Count(x => x.IsOpening) <= 1)
        && !(beat.IsFinish && beats.Count(x => x.IsFinish) <= 1);

    private void Remove(MatchBeat beat)
    {
        if (CanRemove(beat)) beats.Remove(beat);
    }

    private void Move(int index, int direction)
    {
        int to = index + direction;
        if (to < 0 || to >= beats.Count) return;
        (beats[index], beats[to]) = (beats[to], beats[index]);
    }

    /// <summary>
    /// Adds a beat, and — deliberately — leaves the library open.
    ///
    /// It used to close on every add, which meant building a nine-beat match was seven
    /// rounds of: add, library slams shut, scroll down past a now-longer sheet, find
    /// "+ Add a beat", open, scroll from the top of forty-four templates again. Nobody
    /// adds one beat.
    /// </summary>
    private void AddBeat(BeatTemplate template)
    {
        // Insert before the finish so the finish stays last — unless the player opened the
        // library from a gap in the sheet, in which case they said where.
        int at = insertAt ?? beats.FindLastIndex(x => x.IsFinish);
        if (at < 0) at = beats.Count;
        at = Math.Clamp(at, 0, beats.Count);

        beats.Insert(at, template.ToMatchBeat(BeatControl.WrestlerA));
        justAdded = template.Name;

        // An explicit insertion point is used once and then released, so the next add goes
        // back to the sensible default rather than stacking everything at one spot.
        if (insertAt is { } used) insertAt = used + 1;
    }

    /// <summary>Where the next beat goes, when the player opened the library from a gap.</summary>
    private int? insertAt;

    /// <summary>The last template added, so the row can acknowledge it without closing.</summary>
    private string? justAdded;

    private void OpenLibraryAt(int index)
    {
        insertAt    = index;
        showAddBeat = true;
        justAdded   = null;
    }

    private void ToggleLibrary()
    {
        showAddBeat = !showAddBeat;
        insertAt    = null;
        justAdded   = null;
    }

    /// <summary>
    /// Why a template cannot be booked right now, or null if it can.
    /// Covers the tag and ordering rules BeatLibrary.Available does not check,
    /// so the editor never offers a beat that validation will then reject.
    /// </summary>
    private string? GateFor(BeatTemplate t)
    {
        if (t.RequiredFeudIntensity != FeudIntensity.None
            && (feud is null || feud.Intensity < t.RequiredFeudIntensity))
            return $"needs {t.RequiredFeudIntensity}+ feud";

        if (t.Type == BeatType.ThirdPartyPullIn
            && (feud is null
                || (!feud.HasTag(FeudHistoryTag.FamilyInvolved) && !feud.HasTag(FeudHistoryTag.ManagerConflict))))
            return "needs FamilyInvolved or ManagerConflict";

        if (t.Type == BeatType.AlliesRejected && !beats.Any(x => x.Type == BeatType.ThirdPartyPullIn))
            return "must follow an Outside Party beat";

        // Nothing in the tag formula works without somebody on the apron.
        if (!IsTeamMatch && new MatchBeat { Type = t.Type }.IsTagBeat)
            return "needs a partner";

        // The hot tag is bookable cold — it just lands at barely half. That is a booking
        // decision the player is allowed to make badly, so this warns rather than gates.
        return null;
    }

    // ── Finish ───────────────────────────────────────────────────────────

    private async Task Finish()
    {
        var sideA = MatchSide.Of(MembersA.ToArray());
        var sideB = MatchSide.Of(MembersB.ToArray());

        // Attach the standing team, if these two are one. Without this every side a player
        // booked had Team == null, so chemistry was pinned at zero and the whole of phase 4
        // was unreachable from the game.
        sideA.Team = TeamFor(sideA);
        sideB.Team = TeamFor(sideB);

        // Forming a team is a real commitment — it is what starts chemistry accruing — so
        // it happens here, once the booking is confirmed, rather than on a picker click.
        if (formTeamA && sideA.Team is null) sideA.Team = FormTeam(sideA, teamNameA);
        if (formTeamB && sideB.Team is null) sideB.Team = FormTeam(sideB, teamNameB);

        var plan = new MatchPlanModel
        {
            SideA = sideA,
            SideB = sideB,
            MatchType    = matchType,
            IsBlowOff    = isBlowOff && feudChoice != FeudChoice.None,
            Feud         = feud,
            TitleAtStake = title,
            Beats        = beats
        };

        errors = plan.Validate();
        if (errors.Count > 0) return;

        await OnDone.InvokeAsync(new BookedMatch { Plan = plan, StructureName = structureName });
    }

