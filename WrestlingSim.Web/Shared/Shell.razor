@implements IDisposable
@inject GameState State
@inject ViewScroll Scroll

<div class="shell @(State.Mode == AppMode.Exhibition ? "shell--exhibition" : "")">
    @if (State.Mode == AppMode.Career && State.Career is { } career && ShowNav)
    {
        <header class="frame">
            <div class="frame__bar">
                <button class="frame__brand" @onclick="Home" title="Home">
                    <span class="frame__name">@career.Promotion.Name</span>
                    <span class="frame__tier">@career.Promotion.TierLabel</span>
                </button>

                <div class="frame__clock">
                    <span class="frame__date">@career.CurrentDate.ToString("ddd d MMM yyyy")</span>
                    <span class="frame__next">@NextLine(career)</span>
                </div>

                <div class="frame__advance">
                    @if (career.Due.FirstOrDefault() is { } due)
                    {
                        <button class="btn btn--primary" @onclick="() => State.OpenShow(due)">
                            @(due.IsBooked ? $"Run {due.Name}" : $"Book {due.Name}")
                        </button>
                    }
                    else
                    {
                        <button class="btn btn--sm" @onclick="() => State.AdvanceAsync(1)">+1 day</button>
                        <button class="btn btn--sm" @onclick="() => State.AdvanceAsync(7)">+1 week</button>
                        <button class="btn btn--sm btn--primary" disabled="@(career.NextShow is null)"
                                @onclick="State.AdvanceToNextShowAsync">To next show</button>
                    }
                </div>

                <div class="frame__money">
                    <button class="frame__figure" @onclick="() => State.Go(Screen.Business)" title="Business">
                        <span class="frame__key">Cash</span>
                        <span class="frame__val tabnum @(career.Books.InTheRed ? "grade--poor" : "grade--great")">@Money.Format(career.Books.Cash)</span>
                    </button>
                    <div class="frame__figure">
                        <span class="frame__key">Reputation</span>
                        <span class="frame__val tabnum">@career.Books.Reputation.ToString("F0")</span>
                    </div>
                </div>

                <div class="frame__menuwrap">
                    <button class="btn btn--sm btn--ghost" aria-expanded="@menuOpen" @onclick="() => menuOpen = !menuOpen">Menu</button>
                    @if (menuOpen)
                    {
                        <div class="frame__menu" role="menu">
                            <button role="menuitem" @onclick="SaveNow">Save now</button>
                            <button role="menuitem" @onclick="Export">Export save</button>
                            <button role="menuitem" @onclick="Exit">Save and exit</button>
                        </div>
                    }
                </div>
            </div>

            <nav class="gnav" aria-label="Main">
                @foreach (var (group, label, _) in Navigation.Groups)
                {
                    var g = group;
                    <button class="gnav__item @(CurrentGroup == g ? "is-active" : "")"
                            aria-current="@(CurrentGroup == g ? "page" : null)"
                            @onclick="() => Navigation.Open(State, g)">@label</button>
                }
            </nav>
        </header>
    }
    else if (State.Mode == AppMode.Exhibition && ShowNav)
    {
        <header class="frame frame--exhibition">
            <div class="frame__bar">
                <button class="frame__brand" @onclick="() => State.Go(Screen.Exhibition)" title="Exhibition start">
                    <span class="frame__name">Exhibition</span>
                    <span class="frame__tier">Sandbox · nothing here is saved</span>
                </button>
                <nav class="gnav gnav--inline" aria-label="Exhibition">
                    @foreach (var (screen, label, _) in Navigation.Exhibition)
                    {
                        var target = screen;
                        <button class="gnav__item @(IsExhibitionTab(target) ? "is-active" : "")"
                                aria-current="@(IsExhibitionTab(target) ? "page" : null)"
                                @onclick="() => OpenExhibition(target)">@label</button>
                    }
                </nav>
                <button class="btn btn--sm" @onclick="Exit">Leave exhibition</button>
            </div>
        </header>
    }
    else
    {
        <header class="frame frame--plain">
            <div class="frame__bar">
                <button class="frame__brand" @onclick="Home">
                    <Icon Name="star" Class="brand__star" />
                    <span class="frame__name">Wrestling Sim</span>
                </button>
            </div>
        </header>
    }

    <main class="main @(Wide ? "main--wide" : "")">
        @if (!State.Loaded)
        {
            <div class="empty">
                <div class="empty__mark"><Icon Name="star" /></div>
                Loading the roster…
            </div>
        }
        else if (State.LoadError is not null)
        {
            <div class="notice notice--error">@State.LoadError</div>
        }
        else
        {
            @if (State.Mode == AppMode.Career && State.Career is not null && State.SaveMessage is { } message)
            {
                <div class="notice notice--warn">
                    @message
                    <span class="spacer"></span>
                    <button class="btn btn--sm btn--ghost" @onclick="State.ClearMessage">Dismiss</button>
                </div>
            }

            @if (State.Mode == AppMode.Career && Navigation.TabsOf(CurrentGroup, State) is { Count: > 1 } tabs)
            {
                <nav class="subnav" aria-label="@CurrentGroup">
                    @foreach (var tab in tabs)
                    {
                        var t = tab;
                        <button class="subnav__item @(t.IsActive(State) ? "is-active" : "")"
                                aria-current="@(t.IsActive(State) ? "page" : null)"
                                @onclick="() => t.Open(State)">
                            @t.Label
                            @if (t.Count is { } n)
                            {
                                <span class="subnav__count">@n</span>
                            }
                        </button>
                    }
                </nav>
            }

            @switch (State.Current)
            {
                // Outside a save
                case Screen.Landing:    <LandingScreen />;   break;
                case Screen.NewSave:    <NewSaveScreen />;   break;

                // Inside a save
                case Screen.Dashboard:  <DashboardScreen />; break;
                case Screen.Calendar:   <CalendarScreen />;  break;
                case Screen.Shows:      <ShowsScreen />;     break;
                case Screen.Brands:     <BrandsScreen />;    break;
                case Screen.BookShow:   <BookShowScreen />;  break;
                case Screen.Titles:     <TitlesScreen />;    break;
                case Screen.Stories:    <StoriesScreen />;   break;
                case Screen.Rival:      <RivalScreen />;     break;
                case Screen.News:       <NewsScreen />;      break;
                case Screen.Business:   <BusinessScreen View="BusinessView.Money" />;      break;
                case Screen.Television: <BusinessScreen View="BusinessView.Television" />; break;

                // Shared between career and exhibition
                case Screen.Roster:     <TalentScreen />;    break;
                case Screen.Profile:    <ProfileScreen />;   break;
                case Screen.Contracts:  <ContractsScreen />; break;
                case Screen.Rivals:     <RivalsScreen />;    break;
                case Screen.Feuds:      <FeudsScreen />;     break;

                // Exhibition only
                case Screen.Exhibition: <MainMenuScreen />;  break;
                case Screen.Match:      <MatchScreen />;     break;
                case Screen.Segment:    <SegmentScreen />;   break;
                case Screen.Show:       <ShowScreen />;      break;
                case Screen.Rumble:     <RumbleScreen />;    break;
            }
        }
    </main>

    @* On phones the top navigation moves to the thumb zone. Five tabs fit; the rest of the
       groups and the save controls go under More. *@
    @if (ShowNav && State.Mode == AppMode.Career)
    {
        <nav class="tabbar" aria-label="Main">
            @foreach (var (group, label, glyph) in Navigation.Groups.Take(4))
            {
                var g = group;
                <button class="tabbar__item @(CurrentGroup == g && !moreOpen ? "is-active" : "")"
                        aria-current="@(CurrentGroup == g ? "page" : null)"
                        @onclick="() => { moreOpen = false; Navigation.Open(State, g); }">
                    <span class="tabbar__glyph"><Icon Name="@glyph" /></span>
                    <span>@label</span>
                </button>
            }
            <button class="tabbar__item @(moreOpen || CurrentGroup is NavGroup.World or NavGroup.Business ? "is-active" : "")"
                    aria-expanded="@moreOpen" @onclick="() => moreOpen = !moreOpen">
                <span class="tabbar__glyph"><Icon Name="dice" /></span>
                <span>More</span>
            </button>
        </nav>
        @if (moreOpen)
        {
            <div class="moresheet" role="dialog" aria-label="More">
                <button class="moresheet__item" @onclick="() => { moreOpen = false; Navigation.Open(State, NavGroup.World); }">World</button>
                <button class="moresheet__item" @onclick="() => { moreOpen = false; Navigation.Open(State, NavGroup.Business); }">Business</button>
                <button class="moresheet__item" @onclick="SaveNow">Save now</button>
                <button class="moresheet__item" @onclick="Export">Export save</button>
                <button class="moresheet__item" @onclick="Exit">Save and exit</button>
            </div>
        }
    }
    else if (ShowNav && State.Mode == AppMode.Exhibition)
    {
        <nav class="tabbar" aria-label="Exhibition">
            @foreach (var (screen, label, glyph) in Navigation.Exhibition.Where(e => e.Screen is not (Screen.Rumble or Screen.Feuds)))
            {
                var target = screen;
                <button class="tabbar__item @(IsExhibitionTab(target) ? "is-active" : "")"
                        @onclick="() => OpenExhibition(target)">
                    <span class="tabbar__glyph"><Icon Name="@glyph" /></span>
                    <span>@label</span>
                </button>
            }
        </nav>
    }
</div>

@code {
    /// <summary>
    /// Screens that earn the extra width.
    ///
    /// Not all of them, on purpose. A form is harder to read at 1500px than at 1100 — the eye
    /// has to travel from a label on the left to a field on the right — so the cap stays where
    /// it is for anything that is mostly prose or mostly inputs. What widens is the screens
    /// that are a *list beside a list*: booking a card against the roster, a roster table, a
    /// month of dates. Those were the ones cramming two columns of information into one.
    /// </summary>
    private static readonly HashSet<Screen> WideScreens =
        [Screen.BookShow, Screen.Show, Screen.Roster, Screen.Contracts, Screen.Calendar, Screen.Brands,
         Screen.Profile, Screen.Rivals, Screen.Rival, Screen.Business, Screen.Television, Screen.Stories, Screen.Dashboard];

    private bool Wide => WideScreens.Contains(State.Current);

    private bool menuOpen;
    private bool moreOpen;

    private NavGroup CurrentGroup => Navigation.GroupOf(State.Current);

    /// <summary>
    /// The landing screens have no navigation: there is nowhere to go until you are inside a
    /// save or inside exhibition.
    /// </summary>
    private bool ShowNav =>
        State.Loaded
        && State.LoadError is null
        && State.Roster.Count >= 2
        && State.Mode != AppMode.Landing;

    private static string NextLine(Career career)
    {
        if (career.Due.FirstOrDefault() is { } due) return $"{due.Name} is today. Time is held until it runs.";
        if (career.NextShow is not { } next) return "Nothing on the calendar";
        int days = career.DaysUntil(next);
        return days == 1 ? $"{next.Name} tomorrow" : $"{next.Name} in {days} days";
    }

    private bool IsExhibitionTab(Screen screen) =>
        State.Current == screen || (screen == Screen.Roster && State.Current == Screen.Profile);

    private void OpenExhibition(Screen screen)
    {
        if (screen == Screen.Roster) State.GoTalent(TalentView.Everyone);
        else State.Go(screen);
    }

    private void Home() =>
        State.Go(State.InCareer ? Screen.Dashboard
                : State.Mode == AppMode.Exhibition ? Screen.Exhibition
                : Screen.Landing);

    private async Task SaveNow() { menuOpen = moreOpen = false; await State.SaveAsync(); }
    private async Task Export() { menuOpen = moreOpen = false; await State.ExportAsync(); }
    private async Task Exit() { menuOpen = moreOpen = false; await State.ExitToLandingAsync(); }

    protected override async Task OnInitializedAsync()
    {
        State.Changed += OnChanged;
        await State.InitialiseAsync();
    }

    /// <summary>
    /// A new screen starts at the top of itself.
    ///
    /// Tracked here rather than in <see cref="GameState.Go"/> because the scroll position is a
    /// property of the view and not of the game: Go is also called from places that are not a
    /// navigation, and the state object has no business reaching for the DOM. The first render
    /// is skipped — the page is already at the top, and scrolling it would fight a browser
    /// restoring a position on reload.
    /// </summary>
    private Screen? shown;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (shown == State.Current) return;

        bool arriving = shown is null;
        shown = State.Current;
        if (!arriving) await Scroll.ToTopAsync();
    }

    private void OnChanged() => StateHasChanged();

    public void Dispose() => State.Changed -= OnChanged;
}
