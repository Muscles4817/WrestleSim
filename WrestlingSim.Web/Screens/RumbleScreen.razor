@using WrestlingSim.Models.Rumble
@using WrestlingSim.Engine
@inject GameState State

@* ── Booking a battle royal ───────────────────────────────────────────────────
   Deliberately not the match builder, and not a variant of it. Doc 18 §2.5 calls this
   format "barely a match", and the beat editor cannot express it — `BeatControl` names
   four sides, so a thirty-strong field has no way to say who a beat is for. More to the
   point, nobody books twenty-nine falls by hand.

   So the flow asks what a booker actually decides: who is in it, what order they come out,
   who wins, and a handful of moments. Everything else is the engine's. *@

<div class="screen">
    <div class="screen__head">
        <div class="eyebrow">OVER THE TOP</div>
        <h1 class="screen__title">Battle Royal</h1>
        <p class="screen__lede">
            Judged on moments rather than work — a vehicle for a spectacle, a surprise return,
            and one story told in eliminations.
        </p>
    </div>

    @if (result is null)
    {
        <div class="panel">
            <div class="panel__title">Format</div>
            <div class="chips">
                <button class="chip @(interval > 0 ? "is-active" : "")"
                        @onclick="() => interval = 90">Rumble — timed entries</button>
                <button class="chip @(interval == 0 ? "is-active" : "")"
                        @onclick="() => interval = 0">Battle royal — all in at once</button>
            </div>
            <span class="field__hint">
                @(interval > 0
                    ? "The entries are what make it a story rather than a scramble, so they are worth something: coming out at two and winning is the format's best night."
                    : "Everybody starts together. Nothing to wait for, no entry to have a story about, and it grades accordingly.")
            </span>
        </div>

        <div class="panel">
            <div class="panel__title">
                The field
                <span class="spacer"></span>
                <span class="small muted">@field.Count in — @Runtime min</span>
            </div>

            @if (field.Count > 0)
            {
                <div class="stack">
                    @foreach (var (w, i) in field.Select((w, i) => (w, i)))
                    {
                        var entrant = w;
                        <div class="beat-row @(entrant == winner ? "is-finish" : "")">
                            <div class="beat-row__n">@(interval > 0 ? (i + 1).ToString() : "—")</div>
                            <button class="beat-row__body" @onclick="() => winner = entrant">
                                <span class="beat-row__name">@entrant.RingName</span>
                                <span class="beat-row__sub">
                                    @(entrant == winner ? "wins it" : "tap to make them the winner")
                                </span>
                            </button>
                            <div class="beat-row__move">
                                <button class="btn btn--icon btn--ghost" disabled="@(i == 0 || interval == 0)"
                                        title="Earlier" @onclick="() => Move(i, -1)">↑</button>
                                <button class="btn btn--icon btn--ghost" disabled="@(i == field.Count - 1 || interval == 0)"
                                        title="Later" @onclick="() => Move(i, 1)">↓</button>
                                <button class="btn btn--icon btn--ghost"
                                        title="Remove" @onclick="() => Drop(entrant)">✕</button>
                            </div>
                        </div>
                    }
                </div>
            }

            <button class="btn mt" @onclick="() => picking = true">+ Add to the field</button>
        </div>

        <div class="panel">
            <div class="panel__title">Moments</div>
            <p class="small muted">
                What the match is for. Repeating one wears it out — four hanging-on spots are
                worth less than two of anything else, which is the format's own rule and not
                a scoring quirk.
            </p>

            @if (moments.Count > 0)
            {
                <div class="stack">
                    @foreach (var (m, i) in moments.Select((m, i) => (m, i)))
                    {
                        var moment = m;
                        <div class="beat-row">
                            <div class="beat-row__n">@(i + 1)</div>
                            <div class="beat-row__body">
                                <span class="beat-row__name">@Label(moment.Kind)</span>
                                <span class="beat-row__sub">
                                    @string.Join(" & ", moment.Cast.Select(c => c.RingName))
                                </span>
                            </div>
                            <div class="beat-row__move">
                                <button class="btn btn--icon btn--ghost" title="Remove"
                                        @onclick="() => moments.Remove(moment)">✕</button>
                            </div>
                        </div>
                    }
                </div>
            }

            @if (field.Count >= 2)
            {
                <div class="chips mt">
                    @foreach (var kind in Enum.GetValues<RumbleMomentKind>())
                    {
                        var k = kind;
                        <button class="chip" disabled="@(k == RumbleMomentKind.IronMan)"
                                title="@(k == RumbleMomentKind.IronMan ? "Earned across the match, not booked" : null)"
                                @onclick="() => AddMoment(k)">+ @Label(k)</button>
                    }
                </div>
                <span class="field__hint">
                    An iron-man run is the one you cannot book — it is read off the match, from
                    who came out early and was still there at the end.
                </span>
            }
        </div>

        @if (Blockers.Count > 0)
        {
            <div class="notice notice--warn">
                @foreach (var b in Blockers) { <div>@b</div> }
            </div>
        }

        <div class="wizard-bar">
            <button class="btn btn--ghost" @onclick="() => State.Go(Screen.Exhibition)">← Main menu</button>
            <button class="btn btn--primary" disabled="@(Blockers.Count > 0)" @onclick="Run">
                Run it ★
            </button>
        </div>
    }
    else
    {
        <div class="score-hero">
            <div>
                <div class="score-hero__label">Winner</div>
                <div class="score-hero__main">@result.Winner.RingName</div>
            </div>
            <Stars Rating="@result.StarRating" />
        </div>

        <div class="panel">
            <div class="panel__title">What it was judged on</div>
            <p class="small muted">
                No technical score, because there are no beats to grade — this format is judged
                on moments, and grading it on ring work would answer a different question and
                print the number anyway.
            </p>
            <div class="stack">
                @foreach (var (label, points) in result.Ordered)
                {
                    <Meter Label="@label" Value="@points" Max="50" />
                }
            </div>
        </div>

        @if (result.IronMan is { } iron && result.IronManOutlasted > 0)
        {
            <div class="panel">
                <div class="panel__title">Iron man</div>
                <div class="notice notice--info">
                    <strong>@iron.RingName</strong> outlasted @result.IronManOutlasted entrants.
                    @(iron == result.Winner
                        ? "And won it — the night the format exists for."
                        : "Went out eventually, and made their name doing it.")
                </div>
            </div>
        }

        <div class="panel">
            <div class="panel__title">Eliminations</div>
            <div class="stack">
                @foreach (var e in result.Eliminations)
                {
                    <div class="beat-row">
                        <div class="beat-row__n">@e.Order</div>
                        <div class="beat-row__body">
                            <span class="beat-row__name">@e.Wrestler.RingName</span>
                            <span class="beat-row__sub">
                                @(e.By is null ? "in the pile-up" : $"by {e.By.RingName}")
                                · @e.Remaining left
                            </span>
                        </div>
                    </div>
                }
                <div class="beat-row is-finish">
                    <div class="beat-row__n">★</div>
                    <div class="beat-row__body">
                        <span class="beat-row__name">@result.Winner.RingName</span>
                        <span class="beat-row__sub">last one standing</span>
                    </div>
                </div>
            </div>
        </div>

        <div class="panel">
            <div class="panel__title">Call</div>
            <div class="stack">
                @foreach (var line in result.Commentary)
                {
                    <div class="pbp__line">@line</div>
                }
            </div>
        </div>

        <div class="wizard-bar">
            <button class="btn btn--ghost" @onclick="() => State.Go(Screen.Exhibition)">← Main menu</button>
            <button class="btn" @onclick="() => result = null">Book another</button>
        </div>
    }
</div>

@if (picking)
{
    @* Already-booked names stay visible and labelled rather than filtered out — the
       picker's own convention, and the right one when a booker is assembling thirty people
       and needs to see who is already in. *@
    <RosterPicker Title="Add to the field"
                  UsedAs="@(w => field.Contains(w) ? $"#{field.IndexOf(w) + 1}" : null)"
                  Picked="Add"
                  Cancelled="() => picking = false" />
}

@code {
    private readonly List<Wrestler> field = new();
    private readonly List<RumbleMoment> moments = new();
    private Wrestler? winner;
    private int interval = 90;
    private bool picking;
    private RumbleResult? result;

    private IEnumerable<Wrestler> Available => State.Roster.Where(w => !field.Contains(w));

    private RumblePlan Plan => new()
    {
        Field = field.Select((w, i) => new RumbleEntrant { Wrestler = w, Number = i + 1 }).ToList(),
        EntryIntervalSeconds = interval,
        Moments = moments.ToList(),
        Winner = winner
    };

    private int Runtime => Plan.DurationMinutes;
    private List<string> Blockers => Plan.Validate();

    private void Add(Wrestler w)
    {
        field.Add(w);
        winner ??= w;
        picking = false;
    }

    private void Drop(Wrestler w)
    {
        field.Remove(w);
        moments.RemoveAll(m => m.Cast.Contains(w));
        if (winner == w) winner = field.FirstOrDefault();
    }

    private void Move(int i, int by)
    {
        int to = i + by;
        if (to < 0 || to >= field.Count) return;
        (field[i], field[to]) = (field[to], field[i]);
    }

    /// <summary>
    /// Adds a moment, cast from the field. Two names for the ones that need two, and the
    /// booker re-picks by removing and re-adding — a full cast editor for a format whose
    /// whole point is that it is loosely booked would be more UI than the thing deserves.
    /// </summary>
    private void AddMoment(RumbleMomentKind kind)
    {
        int needed = kind is RumbleMomentKind.Showdown or RumbleMomentKind.Betrayal ? 2 : 1;
        var cast = field.Take(needed).ToList();
        if (cast.Count < needed) return;

        moments.Add(new RumbleMoment
        {
            Kind = kind,
            Cast = cast,
            At = Math.Clamp(0.25 + moments.Count * 0.15, 0.1, 0.9)
        });
    }

    private void Run() => result = new RumbleEngine(Random.Shared.Next()).Execute(Plan);

    private static string Label(RumbleMomentKind kind) => kind switch
    {
        RumbleMomentKind.IronMan         => "Iron man",
        RumbleMomentKind.SurpriseReturn  => "Surprise return",
        RumbleMomentKind.MassElimination => "Clearing house",
        RumbleMomentKind.Showdown        => "Showdown",
        RumbleMomentKind.NearElimination => "Hanging on",
        RumbleMomentKind.Betrayal        => "Betrayal",
        _                                => kind.ToString()
    };
}
