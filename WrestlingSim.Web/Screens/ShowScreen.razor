@inject GameState State

@if (result is not null)
{
    @* ── Results ──────────────────────────────────────────────────────── *@
    <div class="screen__head">
        <div class="screen__eyebrow">@show.Location</div>
        <h1 class="screen__title">@show.Name</h1>
    </div>

    @* One report, shared with the career screen. What differs between the two is the
       heading above and the buttons below; everything in between is the same night. *@
    <ShowReport Result="result" Today="@DateOnly.FromDateTime(show.Date)" />

    <div class="wizard-bar">
        <button class="btn btn--ghost" @onclick="() => State.Go(Screen.Exhibition)">← Main menu</button>
        <span class="wizard-bar__spacer"></span>
        <button class="btn btn--primary" @onclick="Reset">Book another show</button>
    </div>
}
else if (mode == Mode.AddMatch)
{
    <div class="screen__head">
        <div class="screen__eyebrow">Adding to @show.Name</div>
        <h1 class="screen__title">Add a Match</h1>
    </div>
    <MatchBuilder OnDone="AddMatch" OnCancel="@(() => mode = Mode.Card)" ConfirmLabel="Add to card +" />
}
else if (mode == Mode.AddSegment)
{
    <div class="screen__head">
        <div class="screen__eyebrow">Adding to @show.Name</div>
        <h1 class="screen__title">Add a Segment</h1>
    </div>
    <SegmentBuilder OnDone="AddSegment" OnCancel="@(() => mode = Mode.Card)" ConfirmLabel="Add to card +" />
}
else if (mode == Mode.AddRumble)
{
    <div class="screen__head">
        <div class="screen__eyebrow">Adding to @show.Name</div>
        <h1 class="screen__title">Add a Battle Royal</h1>
    </div>
    <RumbleBuilder OnDone="AddRumble" OnCancel="@(() => mode = Mode.Card)" ConfirmLabel="Add to card +" />
}
else
{
    @* ── Card sheet ───────────────────────────────────────────────────── *@
    <div class="screen__head">
        <div class="screen__eyebrow">Card sheet</div>
        <h1 class="screen__title">Book a Show</h1>
        <p class="screen__lede">
            Position and pacing both count: the opener is weighted ×1.2, the main event ×1.5,
            and two of the same kind back to back take a fatigue penalty.
        </p>
    </div>

    <div class="panel">
        <div class="panel__title">Details</div>
        <div class="fields">
            <div class="field">
                <span class="field__label">Show name</span>
                <input class="input" @bind="show.Name" placeholder="Unnamed Show" />
            </div>
            <div class="field">
                <span class="field__label">Location</span>
                <input class="input" @bind="show.Location" placeholder="Unknown Arena" />
            </div>
            <div class="field">
                <span class="field__label">Runtime budget (minutes)</span>
                <input class="input" type="number" min="20" max="480" @bind="show.TotalDurationMinutes" />
            </div>
        </div>
    </div>

    <div class="panel">
        <div class="panel__title">
            Running order
            <span class="spacer"></span>
            <span class="small muted">@show.Card.Count item@(show.Card.Count == 1 ? "" : "s")</span>
        </div>

        @if (show.Card.Count == 0)
        {
            <div class="empty">
                <div class="empty__mark">▦</div>
                Nothing booked yet. Add a match or a segment below.
            </div>
        }

        @foreach (var item in show.Card)
        {
            var i = show.Card.IndexOf(item);
            var fatigued = i > 0 && show.Card[i - 1].Kind == item.Kind;

            <div class="editor-row @(fatigued ? "is-flagged" : "")">
                <div class="editor-row__n">@(i + 1)</div>
                <div>
                    <div class="editor-row__name">@item.Name</div>
                    <div class="editor-row__sub">
                        @item.Kind · @item.DurationMinutes min
                        @if (i == 0) { <text> · opener ×1.2</text> }
                        @if (i == show.Card.Count - 1 && show.Card.Count > 1) { <text> · main event ×1.5</text> }
                        @if (fatigued) { <text> · fatigue ×0.85</text> }
                    </div>
                </div>
                <div class="editor-row__tools">
                    <button class="btn btn--icon btn--ghost" disabled="@(i == 0)"
                            title="Move up" @onclick="() => Move(i, -1)">↑</button>
                    <button class="btn btn--icon btn--ghost" disabled="@(i == show.Card.Count - 1)"
                            title="Move down" @onclick="() => Move(i, 1)">↓</button>
                    <button class="btn btn--icon btn--danger" title="Remove"
                            @onclick="() => show.Card.Remove(item)">✕</button>
                </div>
            </div>
        }

        <div class="mt">
            <Meter Label="Runtime" Value="@show.BookedMinutes" Max="@show.TotalDurationMinutes"
                   ValueText="@RuntimeText"
                   Variant="@(show.IsOverrunning ? "heel" : "gold")" />
        </div>

        @if (show.IsOverrunning)
        {
            <div class="notice notice--warn mt">
                The card runs @(show.BookedMinutes - show.TotalDurationMinutes) minutes long.
                Running it costs up to 35% of the overall score.
            </div>
        }

        <div class="row mt">
            <button class="btn" @onclick="() => mode = Mode.AddMatch">+ Add a match</button>
            <button class="btn" @onclick="() => mode = Mode.AddSegment">+ Add a segment</button>
            <button class="btn" @onclick="() => mode = Mode.AddRumble">+ Add a battle royal</button>
            <span class="spacer"></span>
            <button class="btn btn--primary" disabled="@(show.Card.Count == 0)" @onclick="RunShow">
                Run the show ★
            </button>
        </div>
    </div>

    @if (State.ActiveFeudCount > 0)
    {
        <div class="panel">
            <div class="panel__title">Live feuds</div>
            @foreach (var feud in State.FeudBook.All.Take(4))
            {
                <div class="row small" style="padding:4px 0">
                    <strong>@feud.WrestlerA.RingName vs @feud.WrestlerB.RingName</strong>
                    <span class="badge @FeudUpdates.IntensityBadge(feud.Intensity)">@feud.Intensity</span>
                    <span class="spacer"></span>
                    <span class="muted tabnum">@feud.Heat.ToString("F0") heat</span>
                </div>
            }
        </div>
    }

    <div class="wizard-bar">
        <button class="btn btn--ghost" @onclick="() => State.Go(Screen.Exhibition)">← Main menu</button>
    </div>
}

@code {
    private enum Mode { Card, AddMatch, AddSegment, AddRumble }

    private Mode mode = Mode.Card;
    private Show show = NewShow();
    private ShowResult? result;

    private static Show NewShow() => new()
    {
        Name                 = "Monday Night Show",
        Location             = "Unknown Arena",
        Date                 = DateTime.Now,
        TotalDurationMinutes = 180
    };

    private string RuntimeText => show.IsOverrunning
        ? $"{show.BookedMinutes} / {show.TotalDurationMinutes} min — over by {show.BookedMinutes - show.TotalDurationMinutes}"
        : $"{show.BookedMinutes} / {show.TotalDurationMinutes} min — {show.RemainingMinutes} left";

    private void AddMatch(BookedMatch match)
    {
        show.Card.Add(match);
        mode = Mode.Card;
    }

    private void AddRumble(WrestlingSim.Models.Rumble.RumblePlan rumble)
    {
        show.Card.Add(rumble);
        mode = Mode.Card;
    }

    private void AddSegment(SegmentModel segment)
    {
        show.Card.Add(segment);
        mode = Mode.Card;
    }

    private void Move(int index, int direction)
    {
        int to = index + direction;
        if (to < 0 || to >= show.Card.Count) return;
        (show.Card[index], show.Card[to]) = (show.Card[to], show.Card[index]);
    }

    private void RunShow()
    {
        result = new ShowSimulator(State.FeudBook).Simulate(show);
        State.Notify();
    }

    private void Reset()
    {
        show = NewShow();
        result = null;
        mode = Mode.Card;
    }
}
