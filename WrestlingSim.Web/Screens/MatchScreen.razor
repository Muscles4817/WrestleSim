@inject GameState State

@if (result is null)
{
    <div class="screen__head">
        <div class="screen__eyebrow">Beat by beat</div>
        <h1 class="screen__title">Book a Match</h1>
        <p class="screen__lede">
            The engine does not decide who wins — you do, with the finish beat. It scores how
            well the story you booked landed with the crowd.
        </p>
    </div>

    <MatchBuilder OnDone="Run" OnCancel="@(() => State.Go(Screen.Exhibition))" ConfirmLabel="Run the match ★" />
}
else
{
    <div class="screen__head">
        <div class="screen__eyebrow">@booked!.StructureName</div>
        <h1 class="screen__title">@booked.Name</h1>
    </div>

    <div class="score-hero">
        <div>
            <div class="score-hero__label">Winner</div>
            <div class="score-hero__main">@result.Winner.RingName</div>
        </div>
        <Stars Rating="@result.StarRating" />
    </div>

    <div class="panel">
        <div class="panel__title">Scorecard</div>
        <div class="stack">
            <Meter Label="Technical" Value="@result.TechnicalScore" Max="60" />
            <Meter Label="Storytelling" Value="@result.StorytellingScore" Max="80" Variant="cyan" />
            <Meter Label="Crowd average" Value="@result.CrowdAverageEnergy" Max="100" Variant="face" />
            <Meter Label="Crowd peak" Value="@result.CrowdPeakEnergy" Max="100" Variant="face" />
            <Meter Label="Finish quality" Value="@result.FinishQuality" Max="100"
                   Variant="@(result.FinishQuality < 70 ? "heel" : "gold")" />
        </div>

        @if (result.StalenessNote is { } stale)
        {
            <div class="notice notice--warn mt">
                <strong>@((int)Math.Round(result.Familiarity * 100))% crowd interest in this pairing.</strong>
                @stale The work was graded as booked; the room was not there for it.
            </div>
        }

        @if (result.FinishQuality < 70)
        {
            <div class="notice notice--warn mt">
                <strong>The finish was not earned.</strong> Advantage did not favour
                @result.Winner.RingName when the finish landed, so finish quality took a 45% hit.
                Book the heat and comeback so the right person is ahead going in.
            </div>
        }
    </div>

    @* ── The order of eliminations ────────────────────────────────────────
       Doc 18 §2.5 puts the drama of this format in the order rather than the fall, so a
       result screen that reported only the winner would be showing the least interesting
       thing about the match it just ran. Read top to bottom it is the field thinning. *@
    @if (result.Eliminations.Count > 0)
    {
        <div class="panel">
            <div class="panel__title">Eliminations</div>
            <div class="stack">
                @foreach (var gone in result.Eliminations)
                {
                    <div class="beat-row">
                        <div class="beat-row__n">@gone.Order</div>
                        <div class="beat-row__body">
                            <span class="beat-row__name">@gone.Wrestler.RingName</span>
                            <span class="beat-row__sub">
                                eliminated by @gone.By.RingName ·
                                @(gone.Remaining == 1 ? "wins it" : $"{gone.Remaining} left")
                            </span>
                        </div>
                    </div>
                }
                <div class="beat-row is-finish">
                    <div class="beat-row__n">★</div>
                    <div class="beat-row__body">
                        <span class="beat-row__name">@result.Winner.RingName</span>
                        <span class="beat-row__sub">last one standing</span>
                    </div>
                </div>
            </div>

            @if (result.EliminationPacing < 0.65)
            {
                <div class="notice notice--warn mt">
                    <strong>The falls came too close together.</strong> The order is what an
                    elimination match has instead of a single dramatic fall, and it only reads
                    as an order if there is work between the falls. Spread them out.
                </div>
            }
        </div>
    }

    <FeudUpdates Updates="@feudUpdates" />

    <div class="panel">
        <div class="panel__title">Play by play</div>
        <PlayByPlay Result="@result" />
    </div>

    <div class="wizard-bar">
        <button class="btn btn--ghost" @onclick="() => State.Go(Screen.Exhibition)">← Main menu</button>
        <span class="wizard-bar__spacer"></span>
        <button class="btn" @onclick="RunAgain">Run the same plan again</button>
        <button class="btn btn--primary" @onclick="Reset">Book another match</button>
    </div>
}

@code {
    private BookedMatch? booked;
    private MatchEngineResult? result;
    private List<FeudUpdate> feudUpdates = new();

    private void Run(BookedMatch match)
    {
        booked = match;
        Execute();
    }

    private void RunAgain() => Execute();

    private void Execute()
    {
        if (booked is null) return;

        // Read how tired the crowd is of this pairing before this match joins the tally
        // — docs/wrestling-reference/20-storylines-and-feuds.md §9.1. Exhibition has no
        // world clock, so the date is null and nothing is ever forgotten here.
        var today = State.Career?.CurrentDate;
        // Keyed on the two sides, exactly as ShowSimulator does. Keying on the starters
        // meant the same tag match deposited heat into a different feud depending on
        // whether it was run here or on a show card.
        var sideA = booked.Plan.SideA.Members;
        var sideB = booked.Plan.SideB.Members;

        var pairing = State.FeudBook.GetOrCreate(sideA, sideB);
        double familiarity = pairing.Familiarity(today);

        result = new MatchEngine().Execute(booked.Plan, familiarity);

        var update = State.FeudBook.Record(
            sideA, sideB,
            heat: result.StarRating * 2.0,
            tags: new[] { FeudHistoryTag.PriorMatch },
            date: today);

        update.Feud.RecordMatch(today);

        // Same rule the show simulator applies — a match either settles the story or adds
        // to the pile of ones that did not.
        if (booked.Plan.IsBlowOff && booked.Plan.Feud is { } declared)
        {
            // A blow-off booked to a DQ or a count-out resolves nothing — doc 20 §6.1.
            var finish = booked.Plan.Beats.LastOrDefault(x => x.IsFinish);
            bool settled = finish is null
                        || HeatEconomy.WeightOf(finish.Type) != FinishWeight.Protected;

            if (settled) declared.BlowOff(today);
            else declared.RecordBrokenPromise();
        }
        else update.Feud.RecordUnresolved();
        feudUpdates = new List<FeudUpdate> { update };

        State.Notify();
    }

    private void Reset()
    {
        booked = null;
        result = null;
        feudUpdates = new();
    }
}
