@inject GameState State
@inject ViewScroll Scroll

@if (result is null)
{
    <div class="screen__head">
        <h1 class="screen__title">Book a Match</h1>
    </div>

    <MatchBuilder OnDone="Run" OnCancel="@(() => State.Go(Screen.Exhibition))" ConfirmLabel="Run the match ★" />
}
else
{
    @* ── The bug ──────────────────────────────────────────────────────────
       The strip a broadcast puts the match details in, which is where they
       belong: they are context for the name, not a heading of their own. This
       replaces the gold eyebrow that sat above every title in the app. *@
    <div class="result" @key="runId">
    <div class="bug reveal" style="--d:0s">
        <span class="bug__tag">@(booked!.Plan.TitleAtStake is null ? "Exhibition" : "Title match")</span>
        <span class="bug__rest">
            @booked.StructureName
            <span class="bug__sep">·</span> @booked.Plan.Beats.Count beats
            <span class="bug__sep">·</span> @Models.BookedMatch.RuntimeOf(booked.Plan.Beats) min
        </span>
    </div>

    <h1 class="screen__title screen__title--hero reveal" style="--d:.07s">@booked.Name</h1>

    @* The winner, at the size the one irreversible thing in a match deserves. *@
    <div class="winstrip reveal" style="--d:.16s">
        <span class="winstrip__label">Winner</span>
        <span class="winstrip__who">@result.Winner.RingName</span>
        <span class="winstrip__how">@FinishLabel()</span>
    </div>

    <div class="verdict reveal reveal--pop" style="--d:.3s">
        <Stars Rating="@result.StarRating" ShowNumber="false" />
        <span class="verdict__num">@result.StarRating.ToString("F2")</span>
        <span class="verdict__word @Grades.OfStars(result.StarRating).Tone()">
            @Grades.OfStars(result.StarRating).Label()
        </span>
    </div>

    <div class="panel reveal" style="--d:.46s">
        <div class="panel__title">
            How it scored
            <span class="spacer"></span>
            <span class="small muted">out of 100 · and what it was worth</span>
        </div>

        @* Two numbers per row, because they answer different questions: how well the
           match worked on this axis, and how much this match type let that matter.
           The bars used to be drawn against 60 and 80 — see MatchEngineResult.
           TechnicalRating for what those were. *@
        <div class="chart">
            @foreach (var row in ScoreRows())
            {
                <div class="chart__row">
                    <span class="chart__key">@row.Label</span>
                    <span class="chart__track">
                        <i class="chart__fill chart__fill--@row.Tone"
                           style="--w:@(row.Rating.ToString("0.#", Inv))%"></i>
                    </span>
                    <span class="chart__val tabnum">@row.Rating.ToString("F0")</span>
                    <span class="chart__contrib">@row.Contribution</span>
                </div>
            }
        </div>

        @if (result.StalenessNote is { } stale)
        {
            <div class="notice notice--warn mt">
                <strong>@((int)Math.Round(result.Familiarity * 100))% crowd interest in this pairing.</strong>
                @stale The work was graded as booked; the room was not there for it.
            </div>
        }

        @if (result.FinishQuality < 70)
        {
            <div class="notice notice--warn mt">
                <strong>The finish was not earned.</strong> Advantage did not favour
                @result.Winner.RingName when the finish landed, so finish quality took a 45% hit.
                Book the heat and comeback so the right person is ahead going in.
            </div>
        }
    </div>

    @* ── What the handicap match was for ──────────────────────────────────
       Doc 18 §2.5: "almost never a contest; it is a *statement*, and the statement is
       usually about the lone wrestler's toughness rather than the outcome". So the result
       screen has to report the statement, or it reports the one thing the format says is
       not the point. *@
    @if (booked.Plan.Numbers is { } numbers)
    {
        <div class="panel">
            <div class="panel__title">Against the numbers</div>
            <div class="stack">
                <Meter Label="@($"{string.Join(" & ", numbers.Outnumbered.Members.Select(w => w.RingName))} — defiance")"
                       Value="@(result.Defiance * 100)" Max="100"
                       Variant="@(result.Defiance < 0.2 ? "heel" : "gold")" />
            </div>

            @if (result.Defiance < 0.2)
            {
                <div class="notice notice--warn mt">
                    <strong>That was a squash, not a statement.</strong>
                    @(string.Join(" & ", numbers.Outnumbered.Members.Select(w => w.RingName)))
                    never had a moment in it. A handicap match is booked to say something
                    about whether somebody can take a beating — book comebacks and kickouts,
                    or book a different match.
                </div>
            }
            else if (result.Winner is { } w && numbers.Outnumbered.Members.Contains(w))
            {
                <div class="notice notice--info mt">
                    <strong>They beat the odds.</strong> Which costs the other
                    @(numbers.Larger.Size) more than it gives @w.RingName — two people beaten
                    by one is a bill somebody pays later.
                </div>
            }
            else
            {
                <div class="notice notice--info mt">
                    <strong>A loss that did its job.</strong> The statement was never the
                    result — it was that
                    @(string.Join(" & ", numbers.Outnumbered.Members.Select(x => x.RingName)))
                    made @(numbers.Larger.Size) of them work for it.
                </div>
            }
        </div>
    }

    @* ── The order of eliminations ────────────────────────────────────────
       Doc 18 §2.5 puts the drama of this format in the order rather than the fall, so a
       result screen that reported only the winner would be showing the least interesting
       thing about the match it just ran. Read top to bottom it is the field thinning. *@
    @if (result.Eliminations.Count > 0)
    {
        <div class="panel">
            <div class="panel__title">Eliminations</div>
            <div class="stack">
                @foreach (var gone in result.Eliminations)
                {
                    <div class="beat-row">
                        <div class="beat-row__n">@gone.Order</div>
                        <div class="beat-row__body">
                            <span class="beat-row__name">@gone.Wrestler.RingName</span>
                            <span class="beat-row__sub">
                                eliminated by @gone.By.RingName ·
                                @(gone.Remaining == 1 ? "wins it" : $"{gone.Remaining} left")
                            </span>
                        </div>
                    </div>
                }
                @* Who was left. "Last one standing" is only true when one is — with a team
                   still holding two or three it is the survivors that are the story, which
                   is the whole reason a Survivor Series is called that. *@
                <div class="beat-row is-finish">
                    <div class="beat-row__n">★</div>
                    <div class="beat-row__body">
                        <span class="beat-row__name">
                            @(result.Survivors.Count > 0
                                ? string.Join(" & ", result.Survivors.Select(w => w.RingName))
                                : result.Winner.RingName)
                        </span>
                        <span class="beat-row__sub">
                            @(result.Survivors.Count > 1
                                ? $"{result.Survivors.Count} survivors"
                                : "last one standing")
                        </span>
                    </div>
                </div>
            </div>

            @if (result.EliminationPacing < 0.65)
            {
                <div class="notice notice--warn mt">
                    <strong>The falls came too close together.</strong> The order is what an
                    elimination match has instead of a single dramatic fall, and it only reads
                    as an order if there is work between the falls. Spread them out.
                </div>
            }
        </div>
    }

    </div>

    <FeudUpdates Updates="@feudUpdates" />

    <div class="panel">
        <div class="panel__title">Play by play</div>
        <PlayByPlay Result="@result" />
    </div>

    <div class="wizard-bar">
        <button class="btn btn--ghost" @onclick="() => State.Go(Screen.Exhibition)">← Main menu</button>
        <span class="wizard-bar__spacer"></span>
        @* "Run the same plan again" invited the reading that re-rolling is a strategy. The
           engine has per-beat performance variance, so the same plan genuinely lands
           differently twice — which is worth saying, because it is the difference between
           a dice roll and a second take. *@
        <button class="btn" @onclick="RunAgain" title="The booking is identical; the performances are not">
            Run again with new variance
        </button>
        <button class="btn btn--primary" @onclick="Reset">Book another match</button>
    </div>
}

@code {
    private static readonly System.Globalization.CultureInfo Inv =
        System.Globalization.CultureInfo.InvariantCulture;

    private record ScoreRow(string Label, double Rating, string Contribution, string Tone);

    /// <summary>
    /// The scorecard. Rating is the 0–100 reading the engine graded on; Contribution is what
    /// that was worth in points of the final score, which is where the match type shows up —
    /// the same 63 on technical is worth half as much in a Storytelling match as in a
    /// Technical one, and that is the whole point of declaring one.
    /// </summary>
    private IEnumerable<ScoreRow> ScoreRows()
    {
        var b = result!.Breakdown;
        yield return new("Technical",    result.TechnicalRating,    Pts(b.Technical),    "gold");
        yield return new("Storytelling", result.StorytellingRating, Pts(b.Storytelling), "cyan");
        yield return new("Crowd",        result.CrowdAverageEnergy, Pts(b.Crowd),        "face");
        yield return new("Finish",       result.FinishQuality,      Pts(b.FinishNudge),  "gold");
    }

    private static string Pts(double points) =>
        $"{(points >= 0 ? "+" : "−")}{Math.Abs(points):F1} pts";

    /// <summary>How it ended, in the booker's words rather than the enum's.</summary>
    private string FinishLabel()
    {
        var finish = booked?.Plan.Beats.LastOrDefault(x => x.IsFinish);
        return finish is null ? "" : BeatLibrary.All
            .FirstOrDefault(t => t.Type == finish.Type)?.Name ?? "";
    }

    /// <summary>
    /// Bumped on every run, and used as the result block's @key.
    ///
    /// Without it, "Run again with new variance" re-renders the same element tree with new
    /// numbers in it — Blazor reuses the DOM, so no element is new, so none of the reveal
    /// animations fire and the second match simply blinks into its final state. The key
    /// makes a re-run a genuinely new block.
    /// </summary>
    private int runId;

    private BookedMatch? booked;
    private MatchEngineResult? result;
    private List<FeudUpdate> feudUpdates = new();

    /// <summary>
    /// The result replaces the builder inside the same screen, so the shell's screen-change
    /// reset does not see it. Without this the player presses "Run the match" at the bottom of
    /// a beat sheet and the result opens at that offset, half way down the scorecard, with the
    /// winner and the rating off the top of the screen.
    /// </summary>
    private async Task Run(BookedMatch match)
    {
        booked = match;
        runId++;
        Execute();
        await Scroll.ToTopAsync();
    }

    private async Task RunAgain()
    {
        runId++;
        Execute();
        await Scroll.ToTopAsync();
    }

    private void Execute()
    {
        if (booked is null) return;

        // Read how tired the crowd is of this pairing before this match joins the tally
        // — docs/wrestling-reference/20-storylines-and-feuds.md §9.1. Exhibition has no
        // world clock, so the date is null and nothing is ever forgotten here.
        var today = State.Career?.CurrentDate;
        // Keyed on the two sides, exactly as ShowSimulator does. Keying on the starters
        // meant the same tag match deposited heat into a different feud depending on
        // whether it was run here or on a show card.
        var sideA = booked.Plan.SideA.Members;
        var sideB = booked.Plan.SideB.Members;

        var pairing = State.FeudBook.GetOrCreate(sideA, sideB);
        double familiarity = pairing.Familiarity(today);

        result = new MatchEngine().Execute(booked.Plan, familiarity);

        var update = State.FeudBook.Record(
            sideA, sideB,
            heat: result.StarRating * 2.0,
            tags: new[] { FeudHistoryTag.PriorMatch },
            date: today);

        update.Feud.RecordMatch(today);

        // Same rule the show simulator applies — a match either settles the story or adds
        // to the pile of ones that did not.
        if (booked.Plan.IsBlowOff && booked.Plan.Feud is { } declared)
        {
            // A blow-off booked to a DQ or a count-out resolves nothing — doc 20 §6.1.
            var finish = booked.Plan.Beats.LastOrDefault(x => x.IsFinish);
            // Doc 20 §6.1: a blow-off has to resolve, and whether a given finish does
                // depends on the rules it happened under — see StipulationRules.SettlesAFeud.
                bool settled = finish is null
                            || StipulationRules.SettlesAFeud(booked.Plan.Stipulation, finish.Type);

            if (settled) declared.BlowOff(today);
            else declared.RecordBrokenPromise();
        }
        else update.Feud.RecordUnresolved();
        feudUpdates = new List<FeudUpdate> { update };

        State.Notify();
    }

    private async Task Reset()
    {
        booked = null;
        result = null;
        feudUpdates = new();
        await Scroll.ToTopAsync();
    }
}
