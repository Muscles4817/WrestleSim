@using WrestlingSim.Models.Rumble
@using WrestlingSim.Engine
@inject GameState State

@* ── Booking a battle royal ───────────────────────────────────────────────────
   Deliberately not the match builder, and not a variant of it. Doc 18 §2.5 calls this
   format "barely a match", and the beat editor cannot express it — `BeatControl` names
   four sides, so a thirty-strong field has no way to say who a beat is for. More to the
   point, nobody books twenty-nine falls by hand.

   So the flow asks what a booker actually decides: who is in it, what order they come out,
   who wins, and a handful of moments. Everything else is the engine's. *@

<div class="screen">
    <div class="screen__head">
        <div class="eyebrow">OVER THE TOP</div>
        <h1 class="screen__title">Battle Royal</h1>
        <p class="screen__lede">
            Judged on moments rather than work — a vehicle for a spectacle, a surprise return,
            and one story told in eliminations.
        </p>
    </div>

    @if (result is null)
    {
        @* The same builder a career show uses. Extracted the moment the Rumble needed to
           be bookable in two places — which is the point at which "a screen" becomes "a
           component and two callers". *@
        <RumbleBuilder OnDone="Run" OnCancel="() => State.Go(Screen.Exhibition)" />
    }
    else
    {
        <div class="score-hero">
            <div>
                <div class="score-hero__label">Winner</div>
                <div class="score-hero__main">@result.Winner.RingName</div>
            </div>
            <Stars Rating="@result.StarRating" />
        </div>

        <div class="panel">
            <div class="panel__title">What it was judged on</div>
            <p class="small muted">
                No technical score, because there are no beats to grade — this format is judged
                on moments, and grading it on ring work would answer a different question and
                print the number anyway.
            </p>
            <div class="stack">
                @foreach (var (label, points) in result.Ordered)
                {
                    <Meter Label="@label" Value="@points" Max="50" />
                }
            </div>
        </div>

        @if (result.IronMan is { } iron && result.IronManOutlasted > 0)
        {
            <div class="panel">
                <div class="panel__title">Iron man</div>
                <div class="notice notice--info">
                    <strong>@iron.RingName</strong> outlasted @result.IronManOutlasted entrants.
                    @(iron == result.Winner
                        ? "And won it — the night the format exists for."
                        : "Went out eventually, and made their name doing it.")
                </div>
            </div>
        }

        <div class="panel">
            <div class="panel__title">Eliminations</div>
            <div class="stack">
                @foreach (var e in result.Eliminations)
                {
                    <div class="beat-row">
                        <div class="beat-row__n">@e.Order</div>
                        <div class="beat-row__body">
                            <span class="beat-row__name">@e.Wrestler.RingName</span>
                            <span class="beat-row__sub">
                                @(e.By is null ? "in the pile-up" : $"by {e.By.RingName}")
                                · @e.Remaining left
                            </span>
                        </div>
                    </div>
                }
                <div class="beat-row is-finish">
                    <div class="beat-row__n">★</div>
                    <div class="beat-row__body">
                        <span class="beat-row__name">@result.Winner.RingName</span>
                        <span class="beat-row__sub">last one standing</span>
                    </div>
                </div>
            </div>
        </div>

        <div class="panel">
            <div class="panel__title">Call</div>
            <div class="stack">
                @foreach (var line in result.Commentary)
                {
                    <div class="pbp__line">@line</div>
                }
            </div>
        </div>

        <div class="wizard-bar">
            <button class="btn btn--ghost" @onclick="() => State.Go(Screen.Exhibition)">← Main menu</button>
            <button class="btn" @onclick="() => result = null">Book another</button>
        </div>
    }
</div>

@code {
    private RumbleResult? result;

    private void Run(RumblePlan plan) =>
        result = new RumbleEngine(Random.Shared.Next()).Execute(plan);
}
